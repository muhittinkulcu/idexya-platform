{
  // Idexya Platform - statik site (Workers Static Assets)
  "name": "idexya-platform",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // Deneme adresi: idexya-platform.<hesap>.workers.dev. Canlı alan adı (idexya.com) Cloudflare panelinden Custom Domain olarak bağlanır.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/yonetim", "/yonetim/*", "/icerik/*", "/kabuk/*", "/uye/*", "/tr/bulten", "/tr/bulten/*", "/sitemap-bulten.xml",
      // Yönetim paneli (panel.idexya.com) İngilizce adresleri: worker/panel-yollar.js
      "/accounting", "/accounting/*", "/accounts", "/accounts/*", "/activity-log", "/activity-log/*", "/articles", "/articles/*", "/assistant", "/assistant/*", "/backups", "/backups/*", "/banners", "/banners/*", "/client-portal", "/client-portal/*", "/client-sites", "/client-sites/*", "/conversions", "/conversions/*", "/crm", "/crm/*", "/crm-conflicts", "/crm-conflicts/*", "/crm-sync", "/crm-sync/*", "/customer", "/customer/*", "/dashboard", "/dashboard/*", "/data-sync", "/data-sync/*", "/documents", "/documents/*", "/instagram", "/instagram/*", "/integrations", "/integrations/*", "/leads", "/leads/*", "/media", "/media/*", "/members", "/members/*", "/notifications", "/notifications/*", "/performance", "/performance/*", "/proposal-print", "/proposal-print/*", "/proposals", "/proposals/*", "/seo", "/seo/*", "/settings", "/settings/*", "/site-content", "/site-content/*", "/subscribers", "/subscribers/*", "/support", "/support/*", "/tasks", "/tasks/*", "/theme", "/theme/*", "/visitors", "/visitors/*", "/weekly-newsletter", "/weekly-newsletter/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Veritabanı: ilk yayında Cloudflare kendiliğinden oluşturur (otomatik kaynak oluşturma).
  "d1_databases": [{ "binding": "DB", "database_name": "idexya-platform" }],
  // E-posta bildirimleri (worker/eposta.js): Cloudflare Email Service. Gönderim için idexya.com, Cloudflare panelinde Email Sending'e eklenmelidir.
  "send_email": [{ "name": "EPOSTA", "allowed_sender_addresses": ["bildirim@idexya.com"] }],
  // Günlük veritabanı yedeği (worker/yedek.js) için R2 bağlantısı. Otomatik oluşturma ilk denemede yayını durdurdu (26 Eki 2026);
  // R2 Cloudflare panelinde etkinleştirilip "idexya-yedek" deposu açılınca aşağıdaki satır açılır:
  // "r2_buckets": [{ "binding": "YEDEK", "bucket_name": "idexya-yedek" }],
  // Yönetim paneli girişi: Cloudflare Access. Değerler Cloudflare panelinden "Variables" olarak girilir.
  // TEAM_DOMAIN, POLICY_AUD ve YONETICILER tanımlanmadan panel AÇILMAZ (varsayılan kapalı).
  // Panelden girilen değişkenler her yayında korunur (yoksa Git yayını onları siler).
  // Panelden eklenen değişkenler (ör. IDOS_BQ_GORUNUM) dağıtımda silinmesin diye; gizli değerler zaten etkilenmez.
  "keep_vars": true,
  "observability": { "enabled": true },
  // Her gün 07.00 UTC (İstanbul 10.00): saklama süresi dolan kişisel veri silinir (worker/saklama.js) ve IDOS reklam
  // özeti çekilir (worker/reklam.js; IDOS_BQ_* ayarları yoksa atlanır).
  "triggers": { "crons": ["0 7 * * *"] },
  // Dal önizlemeleri (wrangler preview) için gerekli. Boş bırakıldı: D1 ve değişkenler önizlemeye aktarılmaz,
  // böylece önizleme canlı veritabanına erişemez; yönetim paneli de önizlemede kapalı kalır.
  "previews": {}
}
