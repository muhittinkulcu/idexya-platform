.alt{display:flex;flex-direction:column;gap:1px;margin:2px 0 6px 20px;padding-left:12px;border-left:2px solid var(--track)}
.alt a,.alt span{min-height:34px;display:flex;align-items:center;justify-content:space-between;gap:8px;padding:0 10px;border-radius:10px;font-size:13px;color:var(--tx);text-decoration:none}
