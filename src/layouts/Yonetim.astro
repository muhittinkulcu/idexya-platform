.sayfa-yolu li{display:flex;align-items:center;gap:6px;min-width:0}.sayfa-yolu li[hidden]{display:none}
.sayfa-yolu li+li::before{content:"›";color:var(--tx2);flex:none}
.sayfa-yolu li:not([data-yol-son]){flex:0 1 auto}
