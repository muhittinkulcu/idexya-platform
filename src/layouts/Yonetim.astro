.profil-menu a{padding:9px 12px;border-radius:9px;color:var(--tx);text-decoration:none;font-size:14px}
.profil-menu a:hover,.profil-menu a:focus-visible{background:var(--card2);color:var(--head)}
.profil-menu .profil-cikis{margin-top:4px;border-top:1px solid rgb(var(--line));border-radius:0 0 9px 9px;color:var(--err,#B42318)}
.sayfa{padding:24px clamp(14px,3vw,36px) 48px;display:flex;flex-direction:column;gap:18px;box-sizing:border-box}
.sayfa h1{margin:0;font-size:clamp(28px,3vw,38px);line-height:1.08;font-weight:800;color:var(--head)}
.kart{background:rgb(var(--card));border:1px solid rgb(var(--line));border-radius:22px;box-sizing:border-box;min-width:0}
.cip{display:inline-flex;align-items:center;padding:2px 9px;border-radius:999px;font-size:12px;font-weight:600;white-space:nowrap}
.cip.yeni{background:var(--infob);color:var(--info)}.cip.crm,.cip.kazanildi{background:var(--okb);color:var(--ok)}.cip.spam,.cip.kaybedildi{background:var(--errb);color:var(--err)}
.cip.gorusme,.cip.teklif,.cip.goruldu{background:var(--warnb);color:var(--warn)}
.alan{display:flex;flex-direction:column;gap:6px;font-size:13px;font-weight:600;color:var(--head)}
.alan input,.alan select,.alan textarea{min-height:42px;padding:8px 12px;border:1px solid rgb(var(--line));border-radius:12px;background:var(--bg);color:var(--tx);font:inherit;font-weight:400;box-sizing:border-box;width:100%}
.bos{padding:28px 18px;text-align:center;color:var(--tx2)}
.uyari{padding:12px 14px;border-radius:14px;font-size:14px}
.uyari.hata{background:var(--errb);color:var(--err)}.uyari.bilgi{background:var(--infob);color:var(--info)}.uyari.ok{background:var(--okb);color:var(--ok)}
