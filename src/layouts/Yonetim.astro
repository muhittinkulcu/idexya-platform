---
// Yönetim paneli yerleşimi (Website ve CRM katmanı). İskelet idexya-ortak'taki ortak kabuk <idexya-kabuk>:
// üst alan (cam), tek sol menü (11 madde), arama, tema düğmesi, sayfa sekmeleri (src/idexya-kabuk, scripts/ortak_esitle.sh ile
// eşitlenir; elle düzenlenmez). Bu dosya yalnız kabuğun ayarını yazar ve sayfa başlığını, eylem çubuğunu ve içeriği verir.
// Sayfa verisi tarayıcıda /api/yonetim/* uçlarından okunur; sayfalar derlemede veri içermez.
import { MENU, menuAdi } from '../data/panel-menu.js';
import ORTAK from '../idexya-kabuk/katmanlar.json';
import '../idexya-kabuk/kabuk.css';
// baslik verilmezse sayfanın menüdeki adı kullanılır (menüyle aynı ad iki yerde elle yazılmaz).
// veri: sayfanın açılışta okuduğu /api/yonetim/* uçları (ör. ['talepler']). İstek HTML ayrıştırılırken başlar (preload);
// sayfa betiği aynı adresi fetch ile isteyince yanıt hazırdır. Özet (ozet) her sayfada kabuk rozetleri için okunur.
// musteriSuzgec: sayfa üst alandaki ortak müşteri seçimine göre süzülür mü (1.3; src/scripts/yonetim/musteri-secici.js).
// Verilmezse seçici görünür ama "Bu sayfa müşteriye göre süzülmez" der; etkisiz süzgeç etkiliymiş gibi gösterilmez.
interface Props { baslik?: string; aktif: string; yol?: string; aciklama?: string; veri?: string[]; musteriSuzgec?: boolean; }
const { aktif, yol = '', aciklama = '', veri = [], musteriSuzgec = false } = Astro.props;
const onYukle = [...new Set(['ozet', ...veri])];
const baslik = Astro.props.baslik || menuAdi('/' + Astro.url.pathname.replace(/^\/yonetim\/|\/$/g, ''));
// Konum yolu: Website ve CRM › grup › modül. Modül yalnız sayfa başlığı modül adından farklıysa görünür (ör. Müşteri kartı).
// Grubu olmayan sayfa kendi yol metnini kullanır.
const grup = MENU.find((g) => g.ogeler.some((o) => o.k === aktif));
const modul = grup ? grup.ogeler.find((o) => o.k === aktif) : null;
const grupAdi = grup && grup.ad !== 'Özet' ? grup.ad : yol;
const modulYolda = modul && modul.href && modul.ad !== baslik;

// Kabuk ayarı (idexya-ortak kabuk/README.md "Ayar şeması"). Sol menü ortak katmanlar.json'dur (tek gezinme, talimat 4.2: 11 madde;
// panel sayfaları CRM, Web Site Yönetimi, Görevler ve onaylar, Müşteriler, AI Center ve Ayarlar maddelerinde). Panelin kendi
// sayfaları (panel.idexya.com) göreli adrese çevrilir; panel menüsünde (panel-menu.js) adresi olmayan sayfa atılır.
// Öteki ürünlerin sayfaları kendi adreslerinde bağlantıdır. Eşleme denetimi: tools/test-panel-menu.mjs.
import { ortakMenu } from '../data/ortak-menu.js';
import { modulGorseli } from '../data/modul-gorsel.js';
const katmanlar = ortakMenu(ORTAK.katmanlar, MENU);
const gorsel = modulGorseli(ORTAK.katmanlar, modul && modul.href ? modul.href.replace(/[?#].*$/, '') : null);
// "+ Yeni oluştur": sayfanın eylem çubuğunda menü, kabuk aramasında eylem olarak çıkar.
const YENI = [
  { grup: 'Web sitesi', ad: 'Blog yazısı', eylem: 'Yeni blog yazısı', aciklama: 'Sitedeki blogda yayınlanır', url: '/site-content?file=posts&new=1' },
  { grup: 'Web sitesi', ad: 'Üyelere özel yazı / kaynak', eylem: 'Yeni yazı ya da kaynak', aciklama: 'Herkese, üyelere ya da seçtiğiniz kişilere', url: '/articles?new=1' },
  { grup: 'Web sitesi', ad: 'Paket', eylem: 'Yeni paket', aciklama: 'Paketler sayfasına yeni paket', url: '/site-content?file=packages&new=1' },
  { grup: 'Web sitesi', ad: 'Hizmet', eylem: 'Yeni hizmet', aciklama: 'Hizmet alanının içinden eklenir', url: '/site-content?file=services' },
  { grup: 'Web sitesi', ad: 'Haftalık bülten sayısı', eylem: 'Yeni haftalık bülten sayısı', aciklama: 'AI ve dijital pazarlama gelişmeleri, kaynaklı özet', url: '/weekly-newsletter?new=1' },
  { grup: 'Web sitesi', ad: 'Banner, duyuru ya da açılır pencere', eylem: 'Yeni banner ya da duyuru', aciklama: 'Kayan/sabit şerit, görsel banner, pop-up, köşe kutusu', url: '/banners?new=1' },
  { grup: 'Web sitesi', ad: 'Sık sorulan soru', eylem: 'Yeni sık sorulan soru', aciklama: 'Ana sayfadaki sorular', url: '/site-content?file=faq&new=1' },
  { grup: 'Satış ve iş', ad: 'Müşteri', eylem: 'Yeni müşteri', aciklama: 'CRM’e elle müşteri kaydı', url: '/crm?new=1' },
  { grup: 'Satış ve iş', ad: 'Teklif', eylem: 'Yeni teklif', aciklama: 'Kalemli, KDV’li teklif hazırlayın', url: '/proposals?new=1' },
  { grup: 'Satış ve iş', ad: 'Görev', eylem: 'Yeni görev', aciklama: 'Takvime görev ve hatırlatma', url: '/tasks?new=1' }
];
const YENI_GRUP = [...new Set(YENI.map((y) => y.grup))];
// Bandın sağındaki soru düğmesi: ortak Kullanım kılavuzu (sol menü, Ayarlar altında; IDOS'ta). os adresinde kabuk-bagla.js önekli yola çevirir.
const KILAVUZ = 'https://marketing.idexya.com/settings/guide';
// Ayarlar sayfasındaki "Modül ayarları": panelin gerçekten var olan ayar ve yönetim sayfaları (ad ve adres menüden). Panelin
// tamamı aynı kapının (Cloudflare Access) arkasında ve tek yetki düzeyinde olduğu için süzülecek ayrı yetki yoktur.
const AYAR_ACIKLAMA = { entegre: 'Bağlı hizmetler ve bağlantı durumu', esitle: 'Reklam verisi çekimi ve IDOS eşleştirmesi', uyeler: 'Site üyeleri ve erişim yetkileri', yedek: 'Veri yedekleri', gecmis: 'Panelde yapılan değişikliklerin kaydı' };
const AYAR_BAGLANTILARI = MENU.flatMap((g) => g.ogeler).filter((o) => o.href && AYAR_ACIKLAMA[o.k]).map((o) => ({ ad: o.ad, url: o.href, aciklama: AYAR_ACIKLAMA[o.k] }));
// Etkin sayfa derlemede modül adresidir; gerçek adres (?tab= dahil) tarayıcıda kabuk kurulmadan önce yazılır (kabuk-bagla.js).
const ayar = {
  katman: 'web',
  katmanlar,
  etkin: { modulUrl: modul && modul.href ? modul.href : null, sayfaUrl: modul && modul.href ? modul.href : null, ad: '' },
  kullanici: { ad: 'Kullanıcı', rol: '' },
  durum: { baglanti: null, esitleme: '' },
  eylemler: YENI.map((y) => ({ ad: y.eylem, url: y.url, katman: 'web' })),
  // Asistan kedisi (IDOST): IDOS'taki ayarla aynı etiket; tıklanınca IDOS'ta açılır (kabuk-bagla.js).
  asistan: { etiket: 'Idexya AI’ya sor' },
  bildirimUrl: '/notifications',
  cikisUrl: '/cdn-cgi/access/logout',
  // Ayarlar sayfası (Muhittin, 15 Kas 2026): yan menünün altındaki Ayarlar buraya gider; sayfanın üstünde ortak <idexya-ayarlar>.
  ayarlarUrl: '/settings',
  ayarBaglantilari: AYAR_BAGLANTILARI
};
// Yapım kuralı 6: JSON içindeki her "<" < olarak yazılır; </script> bloğu erken kapatamaz.
const ayarMetni = JSON.stringify(ayar).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{baslik} · Idexya | Website Yönetim</title>
<link rel="icon" href="/favicon-panel.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-panel-32.png" type="image/png" sizes="32x32">
<link rel="icon" href="/favicon-panel-64.png" type="image/png" sizes="64x64">
<link rel="icon" href="/favicon-panel-512.png" type="image/png" sizes="512x512">
<link rel="apple-touch-icon" href="/favicon-panel-180.png" sizes="180x180">
<!-- Telefona uygulama olarak kurulum (PWA, 30 Eki 2026). Cloudflare Access arkasında olduğu için bildirim dosyası çerezle istenir. -->
<link rel="manifest" href="/panel.webmanifest" crossorigin="use-credentials">
<meta name="theme-color" content="#F07A23">
<meta name="apple-mobile-web-app-title" content="Website">
<meta name="apple-mobile-web-app-capable" content="yes">
<link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<!-- Oturumdaki kullanıcı: Worker Access kimliğini yazar (worker/index.js); yerelde boş kalır. Veri, betik değil. -->
<meta name="idexya-kullanici" content="">
<!-- Tema ilk boyamadan önce (yanıp sönme yok) ve eski tema seçiminin idx-gorunum'a taşınması; satır içi betik değil. -->
<script is:inline src="/panel-gorunum.js"></script>
<!-- Kabuk klasik betik olarak <head>'de (tools/panel-kabuk.mjs): öğe kapanır kapanmaz, ilk boyamadan önce kurulur; sayfa geçişinde
     içerik hiçbir karede kabuksuz çizilmez. Derleme adrese içerik özeti ekler (?v=…), dosya bir yıl önbellekte kalır. -->
<script is:inline src="/panel-kabuk.js"></script>
{onYukle.map((v) => <link rel="preload" href={`/api/yonetim/${v}`} as="fetch" crossorigin="anonymous">)}
<style is:global>
/* Yazı tipleri depoda (public/fonts, SIL OFL: OFL-inter.txt); dış yazı tipi isteği yok. Yazı Inter, kalınlık ortak kabuğun sabit
   değerleri (--w-govde 400, --w-orta 500, --w-vurgu 600; idexya-ortak arayuz-kabugu.md "Ortak parçalar"); seçim yoktur (24 Kas 2026). */
@font-face{font-family:'Inter';font-style:normal;font-weight:400;font-display:swap;src:url(/fonts/inter-latin-ext-400-normal.woff2) format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{font-family:'Inter';font-style:normal;font-weight:400;font-display:swap;src:url(/fonts/inter-latin-400-normal.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Inter';font-style:normal;font-weight:500;font-display:swap;src:url(/fonts/inter-latin-ext-500-normal.woff2) format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{font-family:'Inter';font-style:normal;font-weight:500;font-display:swap;src:url(/fonts/inter-latin-500-normal.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Inter';font-style:normal;font-weight:600;font-display:swap;src:url(/fonts/inter-latin-ext-600-normal.woff2) format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{font-family:'Inter';font-style:normal;font-weight:600;font-display:swap;src:url(/fonts/inter-latin-600-normal.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
body{margin:0}
[hidden]{display:none!important}
/* Renkler: zemin, yüzey, çizgi ve yazı ortak kabukla aynı; vurgu (--brand, --acc, --tint, --tintx, --btnline) kabuğun mavisi;
   turuncu yalnız ana eylem (--fill) ve karar bekleyen işte (--karar; 24 Kas 2026, tuval 8. tur). Tema ortak kabuktan: <html data-tema="acik|koyu"> (tema düğmesi ve Ayarlar sayfası, idx-gorunum). */
:root{--bg:#F6F7F9;--card:255 255 255;--panel:255 255 255;--card2:#F3F5F8;--line:230 233 238;--track:#E9EDF2;--tx:#17202B;--tx2:#56606E;--head:#17202B;--brand:#2F55D4;--acc:#2F55D4;--fill:#B84406;--karar:#B84406;--tint:#EEF2FD;--tintx:#2443B0;--ok:#176041;--okb:#E2F2E9;--info:#1F4E8C;--infob:#E3ECF8;--warn:#7A4E00;--warnb:#FCEFD3;--err:#8A1F2E;--errb:#FCE4E6;--shadow:rgba(23,32,43,.12);--btnline:#C3CFF4;--tx3:#6B737E;--raised:#F3F5F8;--pop:0 18px 50px -12px rgba(0,0,0,.45)}
/* Koyu zemin Marketing'in laciverti (Muhittin, 13 Kas 2026); metin ve durum renkleri aynı. */
html[data-tema=koyu]{--bg:#15202B;--card:28 39 51;--panel:25 39 52;--card2:#22303C;--line:47 61 74;--track:#22303C;--tx:#F1F3F5;--tx2:#B4BECB;--head:#F1F3F5;--brand:#7F9AF2;--acc:#9DB2F5;--fill:#B84406;--karar:#F7A866;--tint:rgba(127,154,242,.18);--tintx:#B7C6F8;--ok:#7ADFB0;--okb:rgba(122,223,176,.13);--info:#9CC3FF;--infob:rgba(156,195,255,.14);--warn:#F3C56D;--warnb:rgba(243,197,109,.14);--err:#FF9AA6;--errb:rgba(255,122,138,.14);--shadow:rgba(0,0,0,.5);--btnline:rgba(127,154,242,.45);--tx3:#8C98A5;--raised:#22303C}
a{color:var(--acc)}a:hover{color:var(--tintx)}
.yonetim{color:var(--tx);font-size:14px;line-height:1.6}
.baslik-font,.sayfa h2{letter-spacing:-.015em}
.yonetim b,.yonetim strong,.yonetim th,.yonetim h2,.yonetim h3,.yonetim h4,.yonetim dt{font-weight:var(--w-vurgu)}
.ikon{width:38px;height:38px;flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;border:1px solid rgb(var(--line));border-radius:var(--ik-yaricap);background:rgb(var(--card));color:var(--head);cursor:pointer;padding:0}
.ikon:hover{background:var(--card2)}
.ikon[aria-pressed=true]{background:var(--tint);color:var(--tintx);border-color:var(--btnline)}
/* A kuralı: tablo sayfalama (src/scripts/yonetim/tablo-sayfa.js). Yazdırırken bütün satırlar çıkar. */
tr[data-sayfa-gizli]{display:none}
.tablo-sayfa{display:flex;justify-content:space-between;align-items:center;gap:8px 16px;flex-wrap:wrap;padding:10px 2px 0;font-size:13px;color:var(--tx2)}
.tablo-sayfa label{display:inline-flex;align-items:center;gap:8px}
.tablo-sayfa select{padding:4px 8px;border:1px solid rgb(var(--line));border-radius:var(--ik-yaricap);background:rgb(var(--card));color:var(--head);font:inherit}
.tablo-sayfa .ts-sag{display:inline-flex;align-items:center;gap:6px}
.tablo-sayfa .ts-aralik{font-variant-numeric:tabular-nums;margin-right:4px}
@media print{tr[data-sayfa-gizli]{display:table-row!important}.tablo-sayfa{display:none!important}}
/* B kuralı: kart başlığı + kapsam/dönem satırı + "i" açıklaması (src/scripts/yonetim/kart-bilgi.js). */
.kart-baslik{display:inline-flex;align-items:center;gap:8px}
.kart-alt{display:block;margin:2px 0 0;font-size:12.5px;color:var(--tx3)}
.kart-i{flex:0 0 auto;width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;border:1px solid rgb(var(--line));border-radius:50%;background:rgb(var(--card));color:var(--tx2);font:var(--w-vurgu) 12px/1 Inter,system-ui,sans-serif;cursor:pointer;padding:0}
.kart-i:hover,.kart-i[aria-expanded=true]{color:var(--tintx);background:var(--tint);border-color:var(--btnline)}
.kart-i:focus-visible{outline:2px solid var(--brand);outline-offset:1px}
.kart-i-metin{margin:6px 0 0;padding:8px 10px;border-radius:var(--ik-yaricap);background:var(--card2);font-size:13px;color:var(--tx);max-width:760px}
@media print{.kart-i,.kart-i-metin{display:none!important}}
/* Toplu seçim (src/scripts/yonetim/toplu-secim.js): onay kutusu sütunu ve seçim çubuğu. */
.toplu-hucre{width:36px;padding-left:12px!important;padding-right:4px!important;text-align:left}
.toplu-hucre input,.toplu-kart-kutu input,.toplu-tumu input{width:17px;height:17px;accent-color:var(--brand);cursor:pointer;margin:0}
.toplu-kart-kutu{display:inline-flex;align-items:center;margin-right:2px}
.toplu-tumu{display:inline-flex;align-items:center;gap:8px;font-size:13px;color:var(--tx2);padding:0 4px;cursor:pointer;width:max-content}
.toplu-cubuk{display:flex;align-items:center;gap:8px 12px;flex-wrap:wrap;padding:10px 12px;margin:0 0 8px;border:1px solid var(--btnline);border-radius:var(--ik-yaricap);background:var(--tint);color:var(--tintx);font-size:13px}
.toplu-cubuk[hidden]{display:none}
.toplu-cubuk .toplu-eylemler{display:contents}
.toplu-cubuk .toplu-eylemler[hidden]{display:none}
.toplu-cubuk .toplu-grup{display:inline-flex;gap:6px;align-items:center;flex-wrap:wrap}
.toplu-cubuk select,.toplu-cubuk input[type=text]{min-height:32px;padding:4px 8px;border:1px solid rgb(var(--line));border-radius:var(--ik-yaricap);background:rgb(var(--card));color:var(--head);font:inherit}
.toplu-cubuk input[type=text]{width:140px}
.toplu-cubuk .toplu-mesaj{color:var(--head)}
@media print{.toplu-cubuk,.toplu-tumu,.toplu-hucre,.toplu-kart-kutu{display:none!important}}
.dugme{min-height:40px;display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:0 16px;border:1px solid rgb(var(--line));border-radius:var(--ik-yaricap);background:rgb(var(--card));color:var(--head);font:inherit;font-weight:400;cursor:pointer;text-decoration:none;box-sizing:border-box}
.dugme:hover{background:var(--card2);color:var(--head)}
.dugme.ana{border:0;background:var(--fill);color:#FFFFFF;font-weight:500}
.dugme.ana:hover{background:var(--fill);filter:brightness(1.08);color:#FFFFFF}
.dugme.ikincil{border-color:var(--btnline);color:var(--acc)}
.dugme:disabled{opacity:.55;cursor:default}
.dugme.kucuk{min-height:36px;padding:0 12px;font-size:13px}
.sayfa{padding:24px 32px 56px;display:flex;flex-direction:column;gap:24px;box-sizing:border-box}
.kart{background:rgb(var(--card));border:1px solid rgb(var(--line));border-radius:var(--ik-yaricap-kart);box-shadow:var(--ik-golge);box-sizing:border-box;min-width:0}
.cip{display:inline-flex;align-items:center;padding:3px 10px;border-radius:var(--ik-yaricap-kucuk);font-size:12px;font-weight:500;white-space:nowrap}
.cip.yeni{background:var(--infob);color:var(--info)}.cip.crm,.cip.kazanildi{background:var(--okb);color:var(--ok)}.cip.spam,.cip.kaybedildi{background:var(--errb);color:var(--err)}
.cip.gorusme,.cip.teklif,.cip.goruldu{background:var(--warnb);color:var(--warn)}
.alan{display:flex;flex-direction:column;gap:6px;font-size:13px;font-weight:400;color:var(--head)}
.alan input,.alan select,.alan textarea{min-height:42px;padding:8px 12px;border:1px solid rgb(var(--line));border-radius:var(--ik-yaricap);background:rgb(var(--card));color:var(--tx);font:inherit;box-sizing:border-box;width:100%}
.bos{padding:36px 20px;text-align:center;color:var(--tx2)}
/* Özet kutusu (imzalı görünüm 3. adım, IDOS ile aynı): sayfanın tek cümlelik özeti, solda simge, sağda tek ana eylem. Karar gerektiren sayı turuncu (--karar). */
/* Zengin görünüm (9. tur, 25 Kas 2026; IDOS index.css ile aynı): --k modülün ya da konunun rengi (üçlü). Bant rengi ortak menüden
   gelir (src/data/modul-gorsel.js); simge ve çizim src/scripts/yonetim/gorsel.js. Renkler beyaz yazıyla en az 4,5:1. */
:root{--beyaz:255 255 255;--siyah:0 0 0;--turuncu:240 122 35;--k-mavi:26 111 224;--k-yesil:20 125 76;--k-turkuaz:11 122 116;--k-mor:107 75 216;--k-pembe:192 47 109;--k-kirmizi:184 50 63;--k-altin:140 92 0;--k-gri:92 102 117}
[data-renk=mavi]{--k:var(--k-mavi)}[data-renk=yesil]{--k:var(--k-yesil)}[data-renk=turkuaz]{--k:var(--k-turkuaz)}[data-renk=mor]{--k:var(--k-mor)}[data-renk=pembe]{--k:var(--k-pembe)}[data-renk=kirmizi]{--k:var(--k-kirmizi)}[data-renk=altin]{--k:var(--k-altin)}[data-renk=gri]{--k:var(--k-gri)}
.kare,.avatar,.bant,.renkli{--kz:color-mix(in srgb,rgb(var(--k,var(--k-mavi))) 12%,rgb(var(--card)));--ky:color-mix(in srgb,rgb(var(--k,var(--k-mavi))) 88%,rgb(var(--siyah)))}
html[data-tema=koyu] :is(.kare,.avatar,.bant,.renkli){--kz:color-mix(in srgb,rgb(var(--k,var(--k-mavi))) 24%,rgb(var(--card)));--ky:color-mix(in srgb,rgb(var(--k,var(--k-mavi))) 50%,rgb(var(--beyaz)))}
.kare{display:grid;place-items:center;flex:0 0 auto;width:36px;height:36px;border-radius:var(--ik-yaricap);background:var(--kz);color:var(--ky)}
.kare svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
.kare-kucuk{width:28px;height:28px}.kare-kucuk svg{width:15px;height:15px}
.kare-buyuk{width:48px;height:48px;border-radius:14px}.kare-buyuk svg{width:25px;height:25px}
.kare-dolu,html[data-tema=koyu] .kare-dolu{background:rgb(var(--k,var(--k-mavi)));color:rgb(var(--beyaz))}
.avatar{display:grid;place-items:center;flex:0 0 auto;width:34px;height:34px;border-radius:50%;background:rgb(var(--k,var(--k-mavi)));color:rgb(var(--beyaz));font-size:11.5px;font-weight:var(--w-vurgu);box-shadow:0 0 0 2px rgb(var(--card))}
.bant-yuva .ozet-kutusu{padding:0}.bant-yuva :is(.ozet-simge,.ozet-etiket){display:none}
/* Konum satırı ve başlık bandı (IDOS ile birebir, 28 Kas 2026): UstCubuk.tsx konum yolu + ikon araçlar (32 px), ui.tsx Sayfa
   bandı (index.css .bant, .bant-ic, .bant-yuva). Ölçüler canlı IDOS'tan: bant 24/28, h1 29 (dar 24)/600/-.025em, simge 48, alt 13.5. */
.konum-satiri{display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;min-height:48px;padding:16px 32px 0;box-sizing:border-box}
.konum{flex:1 1 260px;min-width:0;font-size:13px;color:var(--tx3)}
.konum ol{display:flex;align-items:center;gap:4px;margin:0;padding:0;list-style:none;min-width:0}
.konum li{display:flex;align-items:center;gap:4px;min-width:0;color:var(--tx2)}.konum li:last-child{flex-shrink:0}
.konum li>span[aria-hidden]{color:var(--tx3)}
.konum li>:not([aria-hidden]){overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.konum a{color:var(--tx2);text-decoration:none;border-radius:2px}.konum a:hover{color:var(--brand);text-decoration:underline;text-underline-offset:2px}
.konum-araclar{display:flex;flex-wrap:wrap;align-items:center;gap:8px}
.guncelleme{white-space:nowrap;font-size:12.5px;color:var(--tx2)}
.arac{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;box-sizing:border-box;padding:0;border:1px solid rgb(var(--line));border-radius:var(--ik-yaricap);background:rgb(var(--card));color:var(--tx2);cursor:pointer;text-decoration:none;list-style:none}
.arac:hover{border-color:var(--tx3);color:var(--tx)}.arac svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.yeni-menu[open]>summary.arac{border-color:var(--tx3);color:var(--tx)}
.bant{container-type:inline-size;margin:12px 32px 0;padding:24px 28px;border:1px solid color-mix(in srgb,rgb(var(--k)) 22%,rgb(var(--line)));border-radius:var(--ik-yaricap-kart);background:linear-gradient(100deg,color-mix(in srgb,rgb(var(--k)) 19%,rgb(var(--card))),color-mix(in srgb,rgb(var(--k)) 6%,rgb(var(--card))))}
.bant-ic{display:grid;grid-template-columns:fit-content(34%) minmax(0,1fr) auto;align-items:center;gap:16px 32px}
.bant-ic:not(:has(>.bant-yuva>:not([hidden]))){grid-template-columns:minmax(0,1fr) auto}
.bant-bas{display:flex;align-items:center;gap:16px;min-width:0}.bant-metin{min-width:0}
.bant h1{margin:0;font-size:24px;font-weight:600;line-height:1.25;letter-spacing:-.025em;color:var(--tx)}
.bant h1 .alt-baslik{color:var(--tx2);font-weight:var(--w-govde)}
.bant-metin p{margin:4px 0 0;font-size:13.5px;line-height:1.5;color:var(--tx2)}
.bant-yuva{min-width:0;padding-left:32px;border-left:2px solid color-mix(in srgb,rgb(var(--k)) 26%,transparent)}
.bant-yuva:not(:has(>:not([hidden]))){display:none}
.bant-yuva .ozet-kutusu{padding:0;gap:12px 20px}.bant-yuva :is(.ozet-simge,.ozet-etiket){display:none}
.bant-sag{display:flex;flex-wrap:wrap;align-items:center;gap:8px}
.bant .dugme{min-height:36px;height:36px;padding:0 14px;font-size:13.5px;font-weight:500}
.bant .dugme.ana{padding:0 16px}
.dugme.kare-dugme{width:36px;padding:0!important;color:var(--tx)}.kare-dugme svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
@container (max-width:900px){.bant-ic,.bant-ic:not(:has(>.bant-yuva>:not([hidden])))  {grid-template-columns:minmax(0,1fr) auto}.bant-yuva{grid-column:1/-1;grid-row:2;padding-left:0;border-left:0}}
@container (max-width:560px){.bant-ic,.bant-ic:not(:has(>.bant-yuva>:not([hidden]))){grid-template-columns:minmax(0,1fr)}.bant-yuva{grid-row:auto}}
@media (min-width:640px){.bant h1{font-size:29px}}
@media (max-width:639px){.konum-satiri{padding:16px 16px 0}.bant{margin:12px 16px 0}.sayfa{padding-left:16px;padding-right:16px}}
@media (max-width:767px){.guncelleme{display:none}}
@media (max-width:1535px){.konum-dar{display:none!important}}
@media print{.konum-satiri,.bant-sag{display:none!important}}
.ozet-maddeler{display:flex;flex-direction:column;gap:7px;margin:0;padding:0;list-style:none;font-size:14.5px;line-height:1.4;color:var(--tx)}.ozet-maddeler li{position:relative;padding-left:18px}.ozet-maddeler li::before{content:"";position:absolute;left:0;top:.5em;width:7px;height:7px;border-radius:50%;background:rgb(var(--k,var(--k-mavi)))}.ozet-maddeler li.karar::before{background:rgb(var(--turuncu))}
.ozet-bag{font-weight:600;color:var(--ky,var(--acc));text-decoration:underline;text-decoration-color:color-mix(in srgb,currentColor 35%,transparent);text-underline-offset:4px}.ozet-bag:hover{text-decoration-color:currentColor}.ozet-bag.ozet-karar{color:var(--karar)}
.bas-simgeli{display:grid;grid-template-columns:auto minmax(0,1fr);column-gap:12px;align-items:center}.bas-simgeli>.kare{grid-row:1/span 4}.bas-simgeli>:not(.kare){grid-column:2}
.bos-cizim{display:block;width:120px;height:96px;margin:0 auto 12px}
.bos-cizim .cz1{fill:rgb(var(--k)/.14)}.bos-cizim .cz2{fill:rgb(var(--k)/.32)}.bos-cizim .cz3{fill:rgb(var(--k)/.85)}.bos-cizim .cz-vurgu{fill:rgb(var(--turuncu))}
.bos-cizim .cz-kutu{fill:rgb(var(--card));stroke:rgb(var(--k));stroke-width:5}.bos-cizim .cz-cizgi{fill:none;stroke:rgb(var(--k));stroke-width:5;stroke-linecap:round;stroke-linejoin:round}
.bos-cizim .cz-ince{fill:none;stroke:rgb(var(--k)/.45);stroke-width:5;stroke-linecap:round}.bos-cizim .cz-beyaz{fill:none;stroke:rgb(var(--beyaz));stroke-width:3.4;stroke-linecap:round;stroke-linejoin:round}
/* Gösterge kartı (IDOS Sablon.tsx GöstergeKartı): kart 16 px köşe, 20/20/16 iç boşluk; üst satır 36 px renkli kare + ad 13/500 tx2;
   değer 28/600/-.02em; alt satırlar 12,5 px tx3. Sayfa betiklerinin satır içi yazı ölçüleri burada eşitlenir (gorsel.js üst satırı kurar). */
.yonetim .kpi{position:relative;display:flex;flex-direction:column;gap:8px;min-width:0;box-sizing:border-box;padding:20px 20px 16px;border:1px solid rgb(var(--line));border-radius:var(--ik-yaricap-kart);background:rgb(var(--card));box-shadow:var(--ik-golge);color:var(--tx);text-decoration:none}
.yonetim a.kpi:hover{border-color:color-mix(in srgb,var(--tx3) 70%,transparent);color:var(--tx)}.yonetim a.kpi:hover .kpi-ad{color:var(--tx)!important;text-decoration:underline;text-underline-offset:4px}
.kpi-ust{display:flex;align-items:center;gap:10px;min-height:36px}.kpi-ust>.kare{margin:0}
.yonetim .kpi .kpi-ad{min-width:0;flex:1;font-size:13px!important;font-weight:500!important;line-height:1.25;color:var(--tx2)!important;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.yonetim .kpi>b{font-size:28px!important;font-weight:600!important;line-height:1.25!important;letter-spacing:-.02em!important;color:var(--tx)!important;font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.yonetim .kpi>span:not(.kpi-ust),.yonetim .kpi>small{font-size:12.5px!important;color:var(--tx3)!important;line-height:1.45}
.yonetim .kpi .degisim .ok-u{color:var(--ok)}.yonetim .kpi .degisim .ok-a{color:var(--err)}.yonetim .kpi .degisim :is(.ok-u,.ok-a){font-weight:600}
.yonetim .kpi .kivilcim{margin-top:auto;padding-top:8px}
/* Bölüm kartı başlığı (IDOS): h2 15,5/600, alt açıklama 12,5 px tx3. */
.yonetim .sayfa .kart h2,.yonetim .modul-bas h2{font-size:15.5px!important;font-weight:600!important;letter-spacing:-.01em;color:var(--tx)!important}
.yonetim .kart-alt{font-size:12.5px;color:var(--tx3)}
/* Sayfa içi süzgeç seçimleri (IDOS Raporlar.tsx seçici): 36 px, 8 px köşe, 13,5 px; form alanları (.alan) ayrı ölçüdedir. */
.yonetim .sayfa select:not(.alan *):not(.toplu-cubuk *):not(.tablo-sayfa *),.yonetim .sayfa input[type=search]:not(.alan *):not(.toplu-cubuk *){height:36px;min-height:36px;padding:0 10px;border:1px solid rgb(var(--line));border-radius:var(--ik-yaricap);background-color:rgb(var(--card));color:var(--tx);font:inherit;font-size:13.5px;box-sizing:border-box}
.yonetim .sayfa select:not(.alan *):not(.toplu-cubuk *):not(.tablo-sayfa *):hover{border-color:var(--tx3)}
.yonetim .sayfa :is(select,input[type=search]):focus{outline:0;border-color:var(--brand)}
/* Durum sekmeleri ve görünüm seçimi (IDOS MusteriDurumu.tsx): çerçeveli gri zemin, 32 px düğme, sayı tx3. */
.yonetim [role=tablist][data-sekmeler][style*="padding: 4px"],.yonetim [role=group][style*="padding: 4px"],.gv-grup{display:inline-flex!important;flex-wrap:wrap;gap:0!important;padding:2px!important;border:1px solid rgb(var(--line))!important;border-radius:var(--ik-yaricap)!important;background:var(--raised)!important;width:max-content;max-width:100%}
.yonetim [role=tablist][data-sekmeler][style*="padding: 4px"]>button,.yonetim [role=group][style*="padding: 4px"]>button,.gv-grup>button{height:32px!important;min-height:32px!important;padding:0 12px!important;border:0!important;border-radius:var(--ik-yaricap-kucuk)!important;background:transparent!important;box-shadow:none!important;color:var(--tx2)!important;font-size:12.5px!important;font-weight:500!important}
.yonetim [role=tablist][data-sekmeler][style*="padding: 4px"]>button:hover,.yonetim [role=group][style*="padding: 4px"]>button:hover,.gv-grup>button:hover{color:var(--tx)!important}
.yonetim [role=tablist][data-sekmeler][style*="padding: 4px"]>[aria-selected=true],.yonetim [role=group][style*="padding: 4px"]>[aria-pressed=true],.gv-grup>[aria-pressed=true]{background:rgb(var(--card))!important;color:var(--tx)!important;box-shadow:0 1px 2px rgba(0,0,0,.06)!important}
.yonetim [role=tablist][data-sekmeler]>button>span{opacity:1!important;color:var(--tx3);font-variant-numeric:tabular-nums}
.asama-pano{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(250px,1fr);gap:12px;overflow-x:auto;padding-bottom:6px;align-items:start}
.asama-bas{display:flex;align-items:baseline;justify-content:space-between;gap:6px;padding:2px 4px}.asama-bas strong{color:var(--ky)}
.asama-sutun{background:var(--kz);border:1px solid color-mix(in srgb,rgb(var(--k)) 18%,rgb(var(--line)));border-radius:var(--ik-yaricap-kart);padding:12px;display:flex;flex-direction:column;gap:10px;min-width:0}
.asama-kart{padding:12px;display:grid;grid-template-columns:auto minmax(0,1fr);gap:4px 10px;align-items:center}
@media print{.bant{background:none}.bos-cizim{display:none}}
.ozet-kutusu{display:flex;flex-wrap:wrap;align-items:center;gap:20px;padding:22px 24px}
.ozet-simge{flex:0 0 auto;width:40px;height:40px;display:grid;place-items:center;border-radius:var(--ik-yaricap);background:var(--tint);color:var(--acc)}
.ozet-govde{flex:1 1 320px;min-width:0}
.ozet-etiket{margin:0;font-size:12px;color:var(--tx2)}
.ozet-karar{font-weight:600;color:var(--karar)}
.uyari{padding:12px 14px;border-radius:var(--ik-yaricap);font-size:14px}
.uyari.hata{background:var(--errb);color:var(--err)}.uyari.bilgi{background:var(--infob);color:var(--info)}.uyari.ok{background:var(--okb);color:var(--ok)}
/* Site bileşeni IcerikStil "R G B" değişkenlerine uyarlanır. */
.yonetim .icerik-kilit,.yonetim .icerik-yorum-form,.yonetim .icerik-kart{background:rgb(var(--card));border-color:rgb(var(--line))}
.yonetim .icerik-dugme.ikincil,.yonetim .icerik-yorum-form input:not([type=checkbox]),.yonetim .icerik-yorum-form textarea{border-color:rgb(var(--line))}
.yonetim .icerik-yorumlar{border-top-color:rgb(var(--line))}
.segment{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px;padding:4px;border-radius:var(--ik-yaricap);background:var(--bg)}
.segment button{height:36px;border:0;border-radius:var(--ik-yaricap);background:transparent;color:var(--tx2);font:inherit;font-size:13px;font-weight:400;cursor:pointer}
.segment button[aria-pressed=true]{font-weight:500;background:rgb(var(--card));color:var(--head);box-shadow:0 1px 3px var(--shadow)}
:focus-visible{outline:3px solid var(--brand);outline-offset:2px}
/* Üst alandaki ortak müşteri seçicisi (src/scripts/yonetim/musteri-secici.js; kabuğun ürün yuvasında). */
.ms{position:relative;font-size:13px}
.ms-dugme{display:inline-flex;align-items:center;gap:6px;height:32px;max-width:230px;padding:0 10px;border:1px solid rgb(var(--line));border-radius:var(--ik-yaricap);background:rgb(var(--card));color:var(--tx);font:inherit;font-size:13px;cursor:pointer;box-sizing:border-box}
.ms-dugme:hover{border-color:var(--tx3)}
.ms-dugme[data-suzulur=hayir]{color:var(--tx2)}
.ms-ad{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}
.ms-nokta{width:6px;height:6px;flex:0 0 auto;border-radius:50%;background:var(--tx3)}
.ms-ok{width:14px;height:14px;flex:0 0 auto;fill:none;stroke:var(--tx3);stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.ms-acilir{position:absolute;left:0;top:40px;z-index:60;width:min(92vw,340px);border:1px solid rgb(var(--line));border-radius:var(--ik-yaricap-kart);background:rgb(var(--card));box-shadow:var(--pop,0 18px 50px -12px rgba(0,0,0,.45));padding:0;display:flex;flex-direction:column}
.ms-ipucu{margin:0;padding:8px 12px;border-bottom:1px solid rgb(var(--line));font-size:12px;color:var(--tx3)}
.ms-ara{height:32px;margin:8px;padding:0 10px;border:0;border-radius:var(--ik-yaricap-kucuk);background:var(--raised);color:var(--tx);font:inherit;font-size:13px}
.ms-ara:focus{outline:2px solid var(--brand);outline-offset:0}
.ms-liste{list-style:none;margin:0;padding:4px;border-top:1px solid rgb(var(--line));max-height:50vh;overflow-y:auto}
.ms-secenek{display:block;width:100%;text-align:left;padding:7px 10px;border:0;border-radius:var(--ik-yaricap-kucuk);background:none;color:var(--tx);font:inherit;font-size:13px;cursor:pointer}
.ms-secenek:hover,.ms-secenek:focus-visible{background:var(--raised)}
.ms-secenek[aria-selected=true]{background:color-mix(in srgb,var(--brand) 10%,transparent);color:var(--brand);font-weight:500}
.ms-durum{margin:0;padding:8px 12px;font-size:12px;color:var(--tx3)}
@media print{.ms{display:none!important}}
/* Dönem seçici (IDOS TarihSecici.tsx): 36 px, takvim simgesi, ad, ok; açılır kutu 16 px köşe, ızgarada seçili ay mavi. */
.ay-secici{position:relative;font:14px/1.5 Inter,system-ui,sans-serif;color:var(--tx)}
.ay-dugme{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 12px;border:1px solid rgb(var(--line));border-radius:var(--ik-yaricap);background:rgb(var(--card));color:var(--tx);font:inherit;font-size:13px;white-space:nowrap;cursor:pointer;box-sizing:border-box}
.ay-dugme:hover{border-color:var(--tx3)}
.ay-dugme svg,.ay-bas svg{width:15px;height:15px;flex:0 0 auto;fill:none;stroke:var(--tx3);stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.ay-dugme .ay-ok{width:14px;height:14px}
.ay-acilir{position:absolute;right:0;top:44px;z-index:60;width:272px;padding:12px;box-sizing:border-box;border:1px solid rgb(var(--line));border-radius:var(--ik-yaricap-kart);background:rgb(var(--card));box-shadow:var(--pop,0 18px 50px -12px rgba(0,0,0,.45))}
.ay-bas{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;font-size:13.5px;font-weight:600}
.ay-bas button{display:grid;place-items:center;width:28px;height:28px;padding:0;border:0;border-radius:var(--ik-yaricap-kucuk);background:none;color:var(--tx2);cursor:pointer}.ay-bas button:hover{background:var(--raised)}
.ay-izgara{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px}
.ay-izgara button{height:32px;border:0;border-radius:var(--ik-yaricap-kucuk);background:none;color:var(--tx);font:inherit;font-size:13px;cursor:pointer}
.ay-izgara button:hover{background:var(--raised)}.ay-izgara button[aria-checked=true]{background:color-mix(in srgb,var(--brand) 10%,transparent);color:var(--brand);font-weight:500}
.ay-alt{display:flex;justify-content:space-between;gap:4px;margin-top:10px;padding-top:10px;border-top:1px solid rgb(var(--line))}
.ay-alt button{height:28px;padding:0 8px;border:0;border-radius:var(--ik-yaricap-kucuk);background:none;color:var(--brand);font:inherit;font-size:12.5px;font-weight:500;cursor:pointer}.ay-alt button:hover{background:var(--raised)}
/* Ayarlar sayfası (settings.astro): ortak <idexya-ayarlar> altında firma ayarları başlığı. */
.firma-baslik{margin:12px 0 0;font-size:17px;font-weight:var(--w-vurgu);color:var(--head)}
.firma-aciklama{margin:-12px 0 0;max-width:820px;font-size:14px;color:var(--tx2)}
.yeni-menu{position:relative}
.yeni-menu summary{list-style:none;cursor:pointer}.yeni-menu summary::-webkit-details-marker{display:none}
.yeni-liste{position:absolute;right:0;top:calc(100% + 8px);z-index:60;width:320px;padding:8px;border-radius:var(--ik-yaricap);background:rgb(var(--card));border:1px solid rgb(var(--line));box-shadow:0 24px 60px var(--shadow);display:flex;flex-direction:column}
.yeni-liste b{padding:8px 10px 4px;font-size:11.5px;font-weight:500;color:var(--tx2)}
.yeni-liste a{display:flex;flex-direction:column;gap:1px;padding:8px 10px;border-radius:var(--ik-yaricap);text-decoration:none;color:var(--tx)}
.yeni-liste a:hover,.yeni-liste a:focus-visible{background:var(--card2,var(--bg))}
.yeni-liste strong{font-size:14px;color:var(--head)}.yeni-liste span{font-size:12.5px;color:var(--tx2)}
</style>
</head>
<body>
<script is:inline type="application/json" id="idexya-kabuk-ayar" set:html={ayarMetni}></script>
<idexya-kabuk>
  <div class="yonetim" data-sayfa-adi={baslik} data-musteri-suzgec={musteriSuzgec ? 'evet' : undefined}>
    <!-- Konum satırı (IDOS UstCubuk.tsx ile aynı): solda konum yolu, sağda ikon araçlar (32 px). Bandın üstündedir. -->
    <div class="konum-satiri">
      <nav class="konum" aria-label="Konum" data-konum>
        <ol>
          <li><span data-konum-musteri>{musteriSuzgec ? 'Tüm müşteriler' : 'Ajans geneli'}</span></li>
          <li><span aria-hidden="true">/</span><a href="/dashboard">Website ve CRM</a></li>
          {grupAdi && <li class="konum-dar"><span aria-hidden="true">/</span><span>{grupAdi}</span></li>}
          {modulYolda && <li><span aria-hidden="true">/</span><a href={modul.href}>{modul.ad}</a></li>}
          <li><span aria-hidden="true">/</span><span aria-current="page">{baslik}</span></li>
        </ol>
      </nav>
      <div class="konum-araclar">
        <span class="guncelleme" data-guncelleme aria-live="polite" title="Panelin ekrandaki veriyi aldığı saat. Reklam verisinin son eşitleme saati üst çubuktadır."></span>
        <button type="button" class="arac" data-yenile aria-label="Verileri yenile" title="Verileri yenile"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg></button>
        <button type="button" class="arac" data-yazdir aria-label="Yazdır" title="Yazdır"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9V2h12v7"></path><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><path d="M6 14h12v8H6z"></path></svg></button>
        <a class="arac" href="https://idexya.com/" target="_blank" rel="noopener" aria-label="Siteyi aç (yeni sekmede)" title="Siteyi aç"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg></a>
        <details class="yeni-menu" data-yeni-menu>
          <summary class="arac" aria-label="Yeni oluştur" title="Yeni oluştur"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg></summary>
          <div class="yeni-liste" role="menu" aria-label="Ne oluşturmak istiyorsunuz?">
            {YENI_GRUP.map((g) => (
              <>
                <b>{g}</b>
                {YENI.filter((y) => y.grup === g).map((y) => <a role="menuitem" href={y.url}><strong>{y.ad}</strong><span>{y.aciklama}</span></a>)}
              </>
            ))}
          </div>
        </details>
      </div>
    </div>
    <!-- Başlık bandı (IDOS ui.tsx Sayfa): simge + başlık · maddeli özet · sayfanın kendi eylemleri ve kılavuz. -->
    <header class="bant" style={`--k: ${gorsel.ton}`} data-bant={gorsel.anahtar}>
      <div class="bant-ic">
        <div class="bant-bas">
          <span class="kare kare-buyuk kare-dolu" aria-hidden="true"><svg viewBox="0 0 24 24">{gorsel.yollar.map((d) => <path d={d}></path>)}</svg></span>
          <div class="bant-metin">
            <h1><span data-baslik>{baslik}</span><span class="alt-baslik" data-alt-baslik hidden></span></h1>
            {aciklama && <p>{aciklama}</p>}
          </div>
        </div>
        <div class="bant-yuva" data-bant-yuva></div>
        <div class="bant-sag">
          <slot name="eylemler" />
          <a class="dugme kare-dugme" href={KILAVUZ} data-os-adres aria-label="Bu sayfanın kılavuzu" title="Bu sayfanın kılavuzu"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><path d="M12 17h.01"></path></svg></a>
        </div>
      </div>
    </header>
    <div class="sayfa">
      <div data-genel-hata hidden class="uyari hata" role="alert"></div>
      <slot />
    </div>
  </div>
</idexya-kabuk>
<script>
  // Kabuk <head>'deki /panel-kabuk.js ile gelir. Yüklenemediyse (ör. astro dev, ağ hatası) aynı kod modül olarak sonradan gelir.
  if (!customElements.get('idexya-kabuk')) import('../scripts/yonetim/kabuk-giris.js');
  import { tabloSayfalama } from '../scripts/yonetim/tablo-sayfa.js';
  import { kartBilgi } from '../scripts/yonetim/kart-bilgi.js';
  import { gorsel } from '../scripts/yonetim/gorsel.js';
  tabloSayfalama();
  // Sayfanın dönem seçicisi üst çubuğun sağ yuvasına (IDOS'ta tarih seçicinin yeri) taşınır; betik bağları öğeyle gider.
  const kabukOge = document.querySelector('idexya-kabuk');
  const sagaTasi = () => { const y = kabukOge && kabukOge.ustYuvaSag; if (!y) return false; document.querySelectorAll('.yonetim [data-ust-sag]').forEach((e) => y.append(e)); return true; };
  if (!sagaTasi() && kabukOge) kabukOge.addEventListener('idexya-kabuk:hazir', sagaTasi, { once: true });
  gorsel();
  kartBilgi();
</script>
</body>
</html>
