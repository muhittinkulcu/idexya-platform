---
// Yönetim paneli yerleşimi (Website ve CRM katmanı). İskelet idexya-ortak'taki ortak kabuk <idexya-kabuk>:
// paket çubuğu, mega menü, arama, Görünüm paneli, yan menü, sayfa sekmeleri (src/idexya-kabuk, scripts/ortak_esitle.sh ile
// eşitlenir; elle düzenlenmez). Bu dosya yalnız kabuğun ayarını yazar ve sayfa başlığını, eylem çubuğunu ve içeriği verir.
// Sayfa verisi tarayıcıda /api/yonetim/* uçlarından okunur; sayfalar derlemede veri içermez.
import { MENU, menuAdi } from '../data/panel-menu.js';
import ORTAK from '../idexya-kabuk/katmanlar.json';
import '../idexya-kabuk/kabuk.css';
// baslik verilmezse sayfanın menüdeki adı kullanılır (menüyle aynı ad iki yerde elle yazılmaz).
// veri: sayfanın açılışta okuduğu /api/yonetim/* uçları (ör. ['talepler']). İstek HTML ayrıştırılırken başlar (preload);
// sayfa betiği aynı adresi fetch ile isteyince yanıt hazırdır. Özet (ozet) her sayfada kabuk rozetleri için okunur.
interface Props { baslik?: string; aktif: string; yol?: string; aciklama?: string; veri?: string[]; }
const { aktif, yol = '', aciklama = '', veri = [] } = Astro.props;
const onYukle = [...new Set(['ozet', ...veri])];
const baslik = Astro.props.baslik || menuAdi('/' + Astro.url.pathname.replace(/^\/yonetim\/|\/$/g, ''));
// Konum yolu: Website ve CRM › grup › modül. Modül yalnız sayfa başlığı modül adından farklıysa görünür (ör. Müşteri kartı).
// Grubu olmayan sayfa kendi yol metnini kullanır.
const grup = MENU.find((g) => g.ogeler.some((o) => o.k === aktif));
const modul = grup ? grup.ogeler.find((o) => o.k === aktif) : null;
const grupAdi = grup && grup.ad !== 'Özet' ? grup.ad : yol;
const modulYolda = modul && modul.href && modul.ad !== baslik;

// Kabuk ayarı (idexya-ortak kabuk/README.md "Ayar şeması"). Katman listesi ortak (katmanlar.json); bu katman kendi menüsünden
// ezilir: adresi olmayan ("Yakında") modül ve sayfa konmaz. Grup simgeleri: Muhittin, 14 Kas 2026.
const GRUP_SIMGE = { 'Özet': 'izgara', 'Satış': 'kisiler', 'Pazarlama ve iletişim': 'megafon', 'Web sitesi': 'dunya', 'Analiz': 'grafik', 'Üyelik ve erişim': 'kisiler', 'Finans': 'belge', 'Sistem': 'esitle' };
const gruplar = MENU.map((g) => ({
  baslik: g.ad,
  simge: GRUP_SIMGE[g.ad] || 'izgara',
  moduller: g.ogeler.filter((o) => o.href).map((o) => ({
    ad: o.ad,
    url: o.href,
    sayfalar: (o.altlar || []).filter((a) => a.href).map((a) => ({ ad: a.ad, url: a.href }))
  }))
}));
const katmanlar = ORTAK.katmanlar.map((k) => (k.anahtar === 'website' ? { ...k, url: '/dashboard', gruplar } : k));
// "+ Yeni oluştur": sayfanın eylem çubuğunda menü, kabuk aramasında eylem olarak çıkar.
const YENI = [
  { grup: 'Web sitesi', ad: 'Blog yazısı', eylem: 'Yeni blog yazısı', aciklama: 'Sitedeki blogda yayınlanır', url: '/site-content?file=posts&new=1' },
  { grup: 'Web sitesi', ad: 'Üyelere özel yazı / kaynak', eylem: 'Yeni yazı ya da kaynak', aciklama: 'Herkese, üyelere ya da seçtiğiniz kişilere', url: '/articles?new=1' },
  { grup: 'Web sitesi', ad: 'Paket', eylem: 'Yeni paket', aciklama: 'Paketler sayfasına yeni paket', url: '/site-content?file=packages&new=1' },
  { grup: 'Web sitesi', ad: 'Hizmet', eylem: 'Yeni hizmet', aciklama: 'Hizmet alanının içinden eklenir', url: '/site-content?file=services' },
  { grup: 'Web sitesi', ad: 'Haftalık bülten sayısı', eylem: 'Yeni haftalık bülten sayısı', aciklama: 'AI ve dijital pazarlama gelişmeleri, kaynaklı özet', url: '/weekly-newsletter?new=1' },
  { grup: 'Web sitesi', ad: 'Banner, duyuru ya da açılır pencere', eylem: 'Yeni banner ya da duyuru', aciklama: 'Kayan/sabit şerit, görsel banner, pop-up, köşe kutusu', url: '/banners?new=1' },
  { grup: 'Web sitesi', ad: 'Sık sorulan soru', eylem: 'Yeni sık sorulan soru', aciklama: 'Ana sayfadaki sorular', url: '/site-content?file=faq&new=1' },
  { grup: 'Satış ve iş', ad: 'Müşteri', eylem: 'Yeni müşteri', aciklama: 'CRM’e elle müşteri kaydı', url: '/crm?new=1' },
  { grup: 'Satış ve iş', ad: 'Teklif', eylem: 'Yeni teklif', aciklama: 'Kalemli, KDV’li teklif hazırlayın', url: '/proposals?new=1' },
  { grup: 'Satış ve iş', ad: 'Görev', eylem: 'Yeni görev', aciklama: 'Takvime görev ve hatırlatma', url: '/tasks?new=1' }
];
const YENI_GRUP = [...new Set(YENI.map((y) => y.grup))];
// Etkin sayfa derlemede modül adresidir; gerçek adres (?tab= dahil) tarayıcıda kabuk kurulmadan önce yazılır (kabuk-bagla.js).
const ayar = {
  katman: 'website',
  katmanlar,
  etkin: { modulUrl: modul && modul.href ? modul.href : null, sayfaUrl: modul && modul.href ? modul.href : null, ad: '' },
  kullanici: { ad: 'Kullanıcı', rol: '' },
  durum: { baglanti: null, esitleme: '' },
  eylemler: YENI.map((y) => ({ ad: y.eylem, url: y.url, katman: 'website' })),
  bildirimUrl: '/notifications',
  cikisUrl: '/cdn-cgi/access/logout'
};
// Yapım kuralı 6: JSON içindeki her "<" < olarak yazılır; </script> bloğu erken kapatamaz.
const ayarMetni = JSON.stringify(ayar).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{baslik} · Idexya | Website Yönetim</title>
<link rel="icon" href="/favicon-panel.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-panel-32.png" type="image/png" sizes="32x32">
<link rel="icon" href="/favicon-panel-64.png" type="image/png" sizes="64x64">
<link rel="icon" href="/favicon-panel-512.png" type="image/png" sizes="512x512">
<link rel="apple-touch-icon" href="/favicon-panel-180.png" sizes="180x180">
<!-- Telefona uygulama olarak kurulum (PWA, 30 Eki 2026). Cloudflare Access arkasında olduğu için bildirim dosyası çerezle istenir. -->
<link rel="manifest" href="/panel.webmanifest" crossorigin="use-credentials">
<meta name="theme-color" content="#B84406">
<meta name="apple-mobile-web-app-title" content="Website">
<meta name="apple-mobile-web-app-capable" content="yes">
<link rel="preload" href="/fonts/inter-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin>
<!-- Oturumdaki kullanıcı: Worker Access kimliğini yazar (worker/index.js); yerelde boş kalır. Veri, betik değil. -->
<meta name="idexya-kullanici" content="">
<!-- Tema ilk boyamadan önce (yanıp sönme yok) ve eski tema seçiminin idx-gorunum'a taşınması; satır içi betik değil. -->
<script is:inline src="/panel-gorunum.js"></script>
<!-- Kabuk klasik betik olarak <head>'de (tools/panel-kabuk.mjs): öğe kapanır kapanmaz, ilk boyamadan önce kurulur; sayfa geçişinde
     içerik hiçbir karede kabuksuz çizilmez. Derleme adrese içerik özeti ekler (?v=…), dosya bir yıl önbellekte kalır. -->
<script is:inline src="/panel-kabuk.js"></script>
{onYukle.map((v) => <link rel="preload" href={`/api/yonetim/${v}`} as="fetch" crossorigin="anonymous">)}
<style is:global>
/* Yazı tipleri depoda (public/fonts, SIL OFL: OFL-inter.txt); dış yazı tipi isteği yok. Yazı ailesi ve kalınlık ortak kabuğun
   Görünüm panelinden gelir (--ik-yazi, --w-govde, --w-vurgu; idexya-ortak arayuz-kabugu.md "Ortak parçalar"). */
@font-face{font-family:'Inter';font-style:normal;font-weight:300;font-display:swap;src:url(/fonts/inter-latin-ext-300-normal.woff2) format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{font-family:'Inter';font-style:normal;font-weight:300;font-display:swap;src:url(/fonts/inter-latin-300-normal.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Inter';font-style:normal;font-weight:400;font-display:swap;src:url(/fonts/inter-latin-ext-400-normal.woff2) format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{font-family:'Inter';font-style:normal;font-weight:400;font-display:swap;src:url(/fonts/inter-latin-400-normal.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Inter';font-style:normal;font-weight:500;font-display:swap;src:url(/fonts/inter-latin-ext-500-normal.woff2) format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{font-family:'Inter';font-style:normal;font-weight:500;font-display:swap;src:url(/fonts/inter-latin-500-normal.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
body{margin:0}
[hidden]{display:none!important}
/* Renkler: zemin, yüzey, çizgi ve yazı ortak kabukla aynı; turuncu vurgular (--brand, --acc, --fill, --tint, --tintx, --btnline)
   bu modülün rengi. Tema ortak kabuktan: <html data-tema="acik|koyu"> (Görünüm paneli, idx-gorunum). */
:root{--bg:#F2F4F7;--card:255 255 255;--panel:255 255 255;--card2:#F7F8FA;--line:220 225 232;--track:#E6EAF0;--tx:#17202B;--tx2:#56606E;--head:#15202B;--brand:#F07A23;--acc:#B84406;--fill:#B84406;--tint:#FDE9DB;--tintx:#A9420A;--ok:#176041;--okb:#E2F2E9;--info:#1F4E8C;--infob:#E3ECF8;--warn:#7A4E00;--warnb:#FCEFD3;--err:#8A1F2E;--errb:#FCE4E6;--shadow:rgba(0,37,89,.12);--btnline:#F5C7A6}
/* Koyu zemin Marketing'in laciverti (Muhittin, 13 Kas 2026); turuncu vurgu, metin ve durum renkleri aynı. */
html[data-tema=koyu]{--bg:#15202B;--card:28 39 51;--panel:25 39 52;--card2:#22303C;--line:47 61 74;--track:#22303C;--tx:#F1F3F5;--tx2:#B4BECB;--head:#F1F3F5;--brand:#F07A23;--acc:#F7894A;--fill:#B84406;--tint:rgba(240,122,35,.16);--tintx:#FFB58A;--ok:#7ADFB0;--okb:rgba(122,223,176,.13);--info:#9CC3FF;--infob:rgba(156,195,255,.14);--warn:#F3C56D;--warnb:rgba(243,197,109,.14);--err:#FF9AA6;--errb:rgba(255,122,138,.14);--shadow:rgba(0,0,0,.5);--btnline:rgba(247,137,74,.35)}
a{color:var(--acc)}a:hover{color:var(--tintx)}
.yonetim{color:var(--tx);font-size:14.5px;line-height:1.65}
.baslik-font,.sayfa h2{letter-spacing:-.01em}
.yonetim b,.yonetim strong,.yonetim th,.yonetim h2,.yonetim h3,.yonetim h4,.yonetim dt{font-weight:var(--w-vurgu)}
.ikon{width:38px;height:38px;flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;border:1px solid rgb(var(--line));border-radius:8px;background:rgb(var(--card));color:var(--head);cursor:pointer;padding:0}
.ikon:hover{background:var(--card2)}
.ikon[aria-pressed=true]{background:var(--tint);color:var(--tintx);border-color:var(--btnline)}
/* A kuralı: tablo sayfalama (src/scripts/yonetim/tablo-sayfa.js). Yazdırırken bütün satırlar çıkar. */
tr[data-sayfa-gizli]{display:none}
.tablo-sayfa{display:flex;justify-content:space-between;align-items:center;gap:8px 16px;flex-wrap:wrap;padding:10px 2px 0;font-size:13px;color:var(--tx2)}
.tablo-sayfa label{display:inline-flex;align-items:center;gap:8px}
.tablo-sayfa select{padding:4px 8px;border:1px solid rgb(var(--line));border-radius:8px;background:rgb(var(--card));color:var(--head);font:inherit}
.tablo-sayfa .ts-sag{display:inline-flex;align-items:center;gap:6px}
.tablo-sayfa .ts-aralik{font-variant-numeric:tabular-nums;margin-right:4px}
@media print{tr[data-sayfa-gizli]{display:table-row!important}.tablo-sayfa{display:none!important}}
/* B kuralı: kart başlığı + kapsam/dönem satırı + "i" açıklaması (src/scripts/yonetim/kart-bilgi.js). */
.kart-baslik{display:inline-flex;align-items:center;gap:8px}
.kart-alt{display:block;margin:2px 0 0;font-size:12px;color:var(--tx2)}
.kart-i{flex:0 0 auto;width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;border:1px solid rgb(var(--line));border-radius:50%;background:rgb(var(--card));color:var(--tx2);font:600 12px/1 Georgia,serif;font-style:italic;cursor:pointer;padding:0}
.kart-i:hover,.kart-i[aria-expanded=true]{color:var(--tintx);background:var(--tint);border-color:var(--btnline)}
.kart-i:focus-visible{outline:2px solid var(--brand);outline-offset:1px}
.kart-i-metin{margin:6px 0 0;padding:8px 10px;border-radius:10px;background:var(--card2);font-size:13px;color:var(--tx);max-width:760px}
@media print{.kart-i,.kart-i-metin{display:none!important}}
/* Toplu seçim (src/scripts/yonetim/toplu-secim.js): onay kutusu sütunu ve seçim çubuğu. */
.toplu-hucre{width:36px;padding-left:12px!important;padding-right:4px!important;text-align:left}
.toplu-hucre input,.toplu-kart-kutu input,.toplu-tumu input{width:17px;height:17px;accent-color:var(--brand);cursor:pointer;margin:0}
.toplu-kart-kutu{display:inline-flex;align-items:center;margin-right:2px}
.toplu-tumu{display:inline-flex;align-items:center;gap:8px;font-size:13px;color:var(--tx2);padding:0 4px;cursor:pointer;width:max-content}
.toplu-cubuk{display:flex;align-items:center;gap:8px 12px;flex-wrap:wrap;padding:10px 12px;margin:0 0 8px;border:1px solid var(--btnline);border-radius:12px;background:var(--tint);color:var(--tintx);font-size:13px}
.toplu-cubuk[hidden]{display:none}
.toplu-cubuk .toplu-eylemler{display:contents}
.toplu-cubuk .toplu-eylemler[hidden]{display:none}
.toplu-cubuk .toplu-grup{display:inline-flex;gap:6px;align-items:center;flex-wrap:wrap}
.toplu-cubuk select,.toplu-cubuk input[type=text]{min-height:32px;padding:4px 8px;border:1px solid rgb(var(--line));border-radius:8px;background:rgb(var(--card));color:var(--head);font:inherit}
.toplu-cubuk input[type=text]{width:140px}
.toplu-cubuk .toplu-mesaj{color:var(--head)}
@media print{.toplu-cubuk,.toplu-tumu,.toplu-hucre,.toplu-kart-kutu{display:none!important}}
.dugme{min-height:40px;display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:0 14px;border:1px solid rgb(var(--line));border-radius:8px;background:rgb(var(--card));color:var(--head);font:inherit;font-weight:400;cursor:pointer;text-decoration:none;box-sizing:border-box}
.dugme:hover{background:var(--card2);color:var(--head)}
.dugme.ana{border:0;background:var(--fill);color:#FFFFFF;font-weight:500}
.dugme.ana:hover{background:#9E3A05;color:#FFFFFF}
.dugme.ikincil{border-color:var(--btnline);color:var(--acc)}
.dugme:disabled{opacity:.55;cursor:default}
.dugme.kucuk{min-height:32px;padding:0 10px;font-size:13px}
.sayfa{padding:20px clamp(14px,3vw,36px) 60px;display:flex;flex-direction:column;gap:20px;box-sizing:border-box}
.kart{background:rgb(var(--card));border:1px solid rgb(var(--line));border-radius:12px;box-sizing:border-box;min-width:0}
.cip{display:inline-flex;align-items:center;padding:2px 10px;border-radius:999px;font-size:12px;font-weight:400;white-space:nowrap}
.cip.yeni{background:var(--infob);color:var(--info)}.cip.crm,.cip.kazanildi{background:var(--okb);color:var(--ok)}.cip.spam,.cip.kaybedildi{background:var(--errb);color:var(--err)}
.cip.gorusme,.cip.teklif,.cip.goruldu{background:var(--warnb);color:var(--warn)}
.alan{display:flex;flex-direction:column;gap:6px;font-size:13px;font-weight:400;color:var(--head)}
.alan input,.alan select,.alan textarea{min-height:42px;padding:8px 12px;border:1px solid rgb(var(--line));border-radius:8px;background:var(--bg);color:var(--tx);font:inherit;font-weight:300;box-sizing:border-box;width:100%}
.bos{padding:28px 18px;text-align:center;color:var(--tx2)}
.uyari{padding:12px 14px;border-radius:14px;font-size:14px}
.uyari.hata{background:var(--errb);color:var(--err)}.uyari.bilgi{background:var(--infob);color:var(--info)}.uyari.ok{background:var(--okb);color:var(--ok)}
/* Site bileşeni IcerikStil "R G B" değişkenlerine uyarlanır. */
.yonetim .icerik-kilit,.yonetim .icerik-yorum-form,.yonetim .icerik-kart{background:rgb(var(--card));border-color:rgb(var(--line))}
.yonetim .icerik-dugme.ikincil,.yonetim .icerik-yorum-form input:not([type=checkbox]),.yonetim .icerik-yorum-form textarea{border-color:rgb(var(--line))}
.yonetim .icerik-yorumlar{border-top-color:rgb(var(--line))}
.segment{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px;padding:4px;border-radius:12px;background:var(--bg)}
.segment button{height:36px;border:0;border-radius:9px;background:transparent;color:var(--tx2);font:inherit;font-size:13px;font-weight:400;cursor:pointer}
.segment button[aria-pressed=true]{font-weight:500;background:rgb(var(--card));color:var(--head);box-shadow:0 1px 3px var(--shadow)}
:focus-visible{outline:3px solid var(--brand);outline-offset:2px}
/* Sayfa başlığı (ortak kabuk ik-sayfa-bas): konum yolu, başlık ve eylem çubuğu. */
.ik-konum a{color:inherit;text-decoration:none}.ik-konum a:hover,.ik-konum a:focus-visible{color:var(--acc);text-decoration:underline;text-underline-offset:3px}
.ik-sayfa-bas h1 .alt-baslik{color:var(--tx2);font-weight:var(--w-govde)}
.ik-sayfa-bas>div:first-child{flex:1 1 360px;min-width:0}
.ik-sayfa-bas p{margin:4px 0 0;max-width:820px;color:var(--tx2)}
@media print{.ik-eylemler{display:none!important}}
.yeni-menu{position:relative}
.yeni-menu summary{list-style:none;cursor:pointer}.yeni-menu summary::-webkit-details-marker{display:none}
.yeni-liste{position:absolute;right:0;top:calc(100% + 8px);z-index:60;width:320px;padding:8px;border-radius:16px;background:rgb(var(--card));border:1px solid rgb(var(--line));box-shadow:0 24px 60px var(--shadow);display:flex;flex-direction:column}
.yeni-liste b{padding:8px 10px 4px;font-size:11.5px;font-weight:500;color:var(--tx2)}
.yeni-liste a{display:flex;flex-direction:column;gap:1px;padding:8px 10px;border-radius:10px;text-decoration:none;color:var(--tx)}
.yeni-liste a:hover,.yeni-liste a:focus-visible{background:var(--card2,var(--bg))}
.yeni-liste strong{font-size:14px;color:var(--head)}.yeni-liste span{font-size:12.5px;color:var(--tx2)}
</style>
</head>
<body>
<script is:inline type="application/json" id="idexya-kabuk-ayar" set:html={ayarMetni}></script>
<idexya-kabuk>
  <div class="yonetim" data-sayfa-adi={baslik}>
    <header class="ik-sayfa-bas">
      <div>
        <nav class="ik-konum" aria-label="Konum" data-konum>
          <span>Website ve CRM</span>{grupAdi && <> › <span>{grupAdi}</span></>}{modulYolda && <> › <a href={modul.href}>{modul.ad}</a></>}
        </nav>
        <h1><span data-baslik>{baslik}</span><span class="alt-baslik" data-alt-baslik hidden></span></h1>
        {aciklama && <p>{aciklama}</p>}
      </div>
      <div class="ik-eylemler">
        <button type="button" class="ik-dugme" data-yenile>Yenile</button>
        <button type="button" class="ik-dugme" data-yazdir>Yazdır</button>
        <a class="ik-dugme" href="https://idexya.com/" target="_blank" rel="noopener">Siteyi aç ↗</a>
        <details class="yeni-menu" data-yeni-menu>
          <summary class="ik-dugme ik-dugme-ana">+ Yeni oluştur</summary>
          <div class="yeni-liste" role="menu" aria-label="Ne oluşturmak istiyorsunuz?">
            {YENI_GRUP.map((g) => (
              <>
                <b>{g}</b>
                {YENI.filter((y) => y.grup === g).map((y) => <a role="menuitem" href={y.url}><strong>{y.ad}</strong><span>{y.aciklama}</span></a>)}
              </>
            ))}
          </div>
        </details>
      </div>
    </header>
    <div class="sayfa">
      <div data-genel-hata hidden class="uyari hata" role="alert"></div>
      <slot />
    </div>
  </div>
</idexya-kabuk>
<script>
  // Kabuk <head>'deki /panel-kabuk.js ile gelir. Yüklenemediyse (ör. astro dev, ağ hatası) aynı kod modül olarak sonradan gelir.
  if (!customElements.get('idexya-kabuk')) import('../scripts/yonetim/kabuk-giris.js');
  import { tabloSayfalama } from '../scripts/yonetim/tablo-sayfa.js';
  import { kartBilgi } from '../scripts/yonetim/kart-bilgi.js';
  tabloSayfalama();
  kartBilgi();
</script>
</body>
</html>
