<script>
  // "+ Yeni oluştur" menüsü: dışarı tıklayınca ya da Esc ile kapanır. ?yeni=1 ile açılan sayfada o sayfanın "yeni" düğmesine basılır.
  {
    // Açılır menüler (Yeni oluştur, Ürünler): dışarı tıklama ve Esc kapatır.
    document.querySelectorAll<HTMLDetailsElement>('[data-yeni-menu], [data-acilir-menu]').forEach((d) => {
      document.addEventListener('click', (o) => { if (d.open && !d.contains(o.target as Node)) d.open = false; });
      d.addEventListener('keydown', (o) => { if (o.key === 'Escape' && d.open) { d.open = false; d.querySelector('summary')!.focus(); } });
    });
    const m = document.querySelector<HTMLDetailsElement>('[data-yeni-menu]');
    if (m) {
      // Bazı sayfalar adres çubuğunu yeniden yazdığı için "yeni" isteği oturumda da tutulur
      m.querySelectorAll<HTMLAnchorElement>('a').forEach((a) => a.addEventListener('click', () => { try { if (a.search.includes('new=1')) sessionStorage.setItem('idx-yeni', a.pathname); } catch (e) {} }));
    }
    // PWA: service worker yalnız panel alan adında kaydedilir (idexya.com sitesine karışmaz). Kabuk varlıklarını saklar, veriyi saklamaz.
    if ('serviceWorker' in navigator && /^panel\.(idexya\.com|localhost)$/.test(location.hostname)) {
      addEventListener('load', () => { navigator.serviceWorker.register('/panel-sw.js', { scope: '/' }).catch(() => {}); });
    }
    let yeniIstek = new URLSearchParams(location.search).get('new') === '1';
    try { if (sessionStorage.getItem('idx-yeni') === location.pathname) { yeniIstek = true; } sessionStorage.removeItem('idx-yeni'); } catch (e) {}
    if (yeniIstek && !location.pathname.startsWith('/proposals')) {
      let deneme = 0;
      const bas = () => {
        const d = document.querySelector<HTMLElement>('main [data-yeni], main [data-yeni-ac]') || [...document.querySelectorAll<HTMLButtonElement>('main .si-liste ~ button, main button')].filter((b) => /^\+ Yeni /.test(b.textContent || '')).pop();
        if (d) { d.click(); d.scrollIntoView({ block: 'center' }); return; }
        if (++deneme < 40) setTimeout(bas, 150);
      };
      setTimeout(bas, 200);
    }
  }
</script>
<script>
  import { kabuk } from '../scripts/yonetim/ortak.js';
  import { tabloSayfalama } from '../scripts/yonetim/tablo-sayfa.js';
  import { kartBilgi } from '../scripts/yonetim/kart-bilgi.js';
