<script>
  // Hizmetler açılır menüsü (açıkken .acilmis; .acik açık tema sınıfıdır, karışmasın): fareyle üzerine gelince, ok düğmesiyle (klavye, dokunmatik) açılır; Esc veya dışarı tıklama kapatır.
  // Fare sağa (alt listeye) doğru giderken yoldaki başka kategoriye hemen geçilmez.
  document.querySelectorAll('[data-acilir]').forEach((k) => {
    const d = k.querySelector('[data-acilir-dugme]');
    const ac = (v) => { k.classList.toggle('acilmis', v); d.setAttribute('aria-expanded', String(v)); };
    let kapanis, gecis, onceki = 0, son = 0;
    k.addEventListener('mousemove', (o) => { onceki = son; son = o.clientX; });
    k.addEventListener('mouseenter', () => { clearTimeout(kapanis); ac(true); });
    k.addEventListener('mouseleave', () => { kapanis = setTimeout(() => ac(false), 180); });
    d.addEventListener('click', () => ac(!k.classList.contains('acilmis')));
    k.addEventListener('focusout', (o) => { if (!k.contains(o.relatedTarget)) ac(false); });
    k.addEventListener('keydown', (o) => { if (o.key === 'Escape' && k.classList.contains('acilmis')) { ac(false); d.focus(); } });
    const kategoriler = [...k.querySelectorAll('[data-kat]')];
    const liste = k.querySelector('.ust-kat');
    if (liste) new MutationObserver(() => { if (k.classList.contains('acilmis')) liste.style.minHeight = Math.max(...kategoriler.map((x) => x.querySelector('.ust-alt').offsetHeight)) + 'px'; }).observe(k, { attributes: true, attributeFilter: ['class'] });
    const sec = (li) => kategoriler.forEach((x) => x.classList.toggle('etkin', x === li));
    kategoriler.forEach((li) => {
      li.addEventListener('mouseenter', () => { clearTimeout(gecis); if (son > onceki) gecis = setTimeout(() => { if (li.matches(':hover')) sec(li); }, 220); else sec(li); });
      li.addEventListener('focusin', () => sec(li));
    });
    document.addEventListener('click', (o) => { if (!k.contains(o.target)) ac(false); });
  });
</script>
