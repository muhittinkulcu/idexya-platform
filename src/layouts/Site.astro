.koyu #ust a[href="#analiz"]{background:#F07A23!important;color:#1A1206!important;box-shadow:0 18px 40px rgba(240,122,35,.35)!important}
.koyu #ust figure [role=img]>div{box-shadow:0 40px 90px rgba(0,0,0,.45)!important}
.koyu #ust>div:nth-of-type(2)>div{background:rgba(255,255,255,.04)!important;border-color:rgba(255,255,255,.12)!important;color:#C6D2E3!important;backdrop-filter:blur(8px)}
.koyu #ust>div:nth-of-type(2)>div [style*="color: var(--acc)"]{color:#FFB58A!important}
.koyu .site-ust.ust-koyu:not(.kaydi){background:#00163A!important;border-color:rgba(255,255,255,.08)!important}
.koyu .site-ust.ust-koyu:not(.kaydi) .ust-logo,.koyu .site-ust.ust-koyu:not(.kaydi) .ust-menu>a,.koyu .site-ust.ust-koyu:not(.kaydi) .ust-acilir>a,.koyu .site-ust.ust-koyu:not(.kaydi) .ust-acilir-ok,.koyu .site-ust.ust-koyu:not(.kaydi) .ust-giris,.koyu .site-ust.ust-koyu:not(.kaydi) .ikon-dugme{color:#FFFFFF}
.koyu .site-ust.ust-koyu:not(.kaydi) .logo-alt{color:#A9B9CF!important}.koyu .site-ust.ust-koyu:not(.kaydi) .logo-cizgi{background:rgba(255,255,255,.18)}
.koyu .site-ust.ust-koyu:not(.kaydi) .ikon-dugme{border-color:rgba(255,255,255,.2);background:rgba(255,255,255,.05)}
.koyu .site-ust.ust-koyu:not(.kaydi) .arama-dugme{color:#C6D2E3}.koyu .site-ust.ust-koyu:not(.kaydi) .arama-dugme kbd{border-color:rgba(255,255,255,.25);color:#C6D2E3}
.koyu .site-ust.ust-koyu:not(.kaydi) .ust-menu a[aria-current=page]{color:#FFB58A}
/* Koyu tema tek palet (25 Eki 2026): açık temadaki lacivert (#002559) marka blokları koyu temada mavi değil,
   bir kademe yükseltilmiş kömür yüzeye ve turuncu ışığa döner. Böylece açılış, IDOS, analiz ve çağrı kutuları sayfanın geri kalanıyla aynı ailede kalır. */
.koyu{--yuzey-vurgu:#1D2531;--yuzey-vurgu2:#232C3A;--cizgi-vurgu:rgba(255,255,255,.09)}
.koyu #ust{background:radial-gradient(900px 520px at var(--mx,72%) var(--my,38%),rgba(240,122,35,.20),transparent 62%),radial-gradient(1200px 600px at 0% 0%,rgba(255,255,255,.035),transparent 60%),var(--bg)!important;color:var(--tx2);border-bottom:1px solid var(--line)}
.koyu #ust>svg{display:none}
.koyu #ust>div:nth-of-type(2)>div{background:var(--card)!important;border-color:var(--line)!important;backdrop-filter:none}
.koyu .site-ust.ust-koyu:not(.kaydi){background:var(--bg)!important;border-color:var(--line)!important}
.koyu .site-ust.kaydi,.koyu .site-ust:has(.ust-acilir.acilmis),.koyu .site-ust:has([aria-expanded=true]){background:var(--bg)!important;backdrop-filter:none;-webkit-backdrop-filter:none}
.koyu #idos{background:radial-gradient(700px 420px at 85% 10%,rgba(240,122,35,.14),transparent 65%),var(--yuzey-vurgu)!important;border-top:1px solid var(--cizgi-vurgu);border-bottom:1px solid var(--cizgi-vurgu)}
.koyu #idos>svg{display:none}
.koyu #idos [style*="background: rgba(255"]{background:var(--yuzey-vurgu2)!important;border-color:var(--cizgi-vurgu)!important}
.koyu [style*="background: #002559"]{background:radial-gradient(520px 320px at 100% 0%,rgba(240,122,35,.13),transparent 65%),var(--yuzey-vurgu)!important;border:1px solid var(--cizgi-vurgu)}
.koyu section[style*="background: #002559"]{border:0;border-bottom:1px solid var(--cizgi-vurgu)}
.koyu section[style*="background: #002559"]>svg{display:none}
.koyu section[style*="background: #002559"] [style*="background: #FFFFFF"]{background:var(--card)!important}
.koyu section[style*="background: #002559"] [style*="background: #F7F9FC"],.koyu section[style*="background: #002559"] [style*="background: #EAF0F7"]{background:var(--card2)!important}
.koyu section[style*="background: #002559"] [style*="#E3E9F1"],.koyu section[style*="background: #002559"] [style*="#D8E1EC"]{border-color:var(--line)!important}
