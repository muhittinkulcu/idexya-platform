---
// Ortak yerleşim: üst menü, alt kısım, tema, çerez onayı.
interface Props { baslik?: string; aciklama?: string; aktif?: string; dil?: 'tr' | 'en'; aramayaKapali?: boolean; }
const { baslik = '', aciklama = '', aktif = '', dil = 'tr', aramayaKapali = false } = Astro.props;
// Yayın öncesi: tüm site arama motorlarına kapalı. idexya.com yayına alınınca false yapılır;
// aramayaKapali olan sayfalar (ör. IDOS tanıtımı, Muhittin 19 Eki 2026) yine kapalı kalır.
const YAYIN_ONCESI = true;
const kapali = YAYIN_ONCESI || aramayaKapali;
const MENU = [
  { ad: 'Hizmetler', href: '/tr/hizmetler', ust: true, alt: '27 hizmet, beş alan' },
  { ad: 'Paketler', href: '/tr/paketler', ust: true, alt: 'Sihirbazla paketinizi seçin' },
  { ad: 'IDOS', href: '/tr/idos', ust: true, alt: 'Ajans operasyon panelimiz' },
  { ad: 'Blog', href: '/tr/haberler', ust: true, alt: 'Reklam, e-ticaret ve ölçüm' },
  { ad: 'Hakkımızda', href: '/tr/sayfa/hakkimizda', ust: false, alt: 'Kim olduğumuz' },
  { ad: 'İletişim', href: '/tr/iletisim', ust: true, alt: 'Ücretsiz analiz isteyin' }
];
const tamBaslik = baslik ? `${baslik} | Idexya | Good Things` : 'Idexya | Good Things · 360° dijital performans ajansı';
const kanonik = new URL(Astro.url.pathname, Astro.site);
// Robot doğrulaması: Cloudflare Turnstile site anahtarı (gizli değildir) derleme ortamından gelir; yoksa form doğrulamasız çalışır, sunucu yine sınır uygular.
const turnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';

import gruplar from '../data/hizmetler.json';
---
<!doctype html>
<html lang={dil} data-turnstile={turnstile || undefined}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{tamBaslik}</title>
{aciklama && <meta name="description" content={aciklama}>}
{kapali && <meta name="robots" content="noindex, nofollow">}
<link rel="canonical" href={kanonik.href}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:title" content={tamBaslik}>
{aciklama && <meta property="og:description" content={aciklama}>}
<meta property="og:type" content="website">
<meta property="og:locale" content={dil === 'en' ? 'en_US' : 'tr_TR'}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap">
<style is:global>
[hidden]{display:none!important}
/* Akışkan yerleşim (Muhittin, 20 Eki 2026): bölümler tam genişlik, içerik geniş ekranda 1600 px'e kadar açılır, metin satırları okunur boyda kalır. */
:root{--kap:1840px;--kenar:clamp(20px,4vw,72px)}
.kap{max-width:var(--kap);margin:0 auto;padding-inline:var(--kenar);box-sizing:border-box}
main [style*="max-width: 1240px"],footer [style*="max-width: 1240px"]{max-width:var(--kap)!important;padding-left:var(--kenar)!important;padding-right:var(--kenar)!important}
main [style*="max-width: 1100px"]{max-width:1360px!important;padding-left:var(--kenar)!important;padding-right:var(--kenar)!important}
main [style*="max-width: 1192px"]{max-width:calc(var(--kap) - 2 * var(--kenar))!important}
main p{max-width:76ch}

/* Üst menü */
.site-ust{background:var(--bg);border-bottom:1px solid var(--line)}
.ust{display:flex;align-items:center;gap:12px 36px;min-height:76px;padding-top:10px;padding-bottom:10px}
.ust-logo{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--head);flex:none}
.ust-menu{display:flex;gap:4px 30px;font-size:15px;font-weight:500;flex:1 1 auto}
.ust-menu a{position:relative;color:var(--tx);text-decoration:none;padding:12px 0}
.ust-menu a::after{content:"";position:absolute;left:0;right:0;bottom:6px;height:2px;border-radius:2px;background:var(--brand);transform:scaleX(0);transform-origin:left;transition:transform .25s ease}
.ust-menu a:hover::after,.ust-menu a[aria-current=page]::after{transform:scaleX(1)}
.ust-menu a[aria-current=page]{color:var(--acc);font-weight:600}
.ust-eylem{display:flex;align-items:center;gap:8px;margin-left:auto}
.ikon-dugme{min-height:44px;min-width:44px;padding:0 12px;border:1px solid var(--line);border-radius:12px;background:transparent;color:var(--head);font:inherit;font-size:15px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:background-color .2s,border-color .2s}
.ikon-dugme:hover{background:var(--card);border-color:var(--brand)}
.arama-dugme{min-width:200px;justify-content:flex-start;color:var(--tx2);font-weight:500;background:var(--card)}
.arama-dugme kbd{margin-left:auto;padding:1px 6px;border:1px solid var(--line);border-radius:6px;font:inherit;font-size:12px;color:var(--tx2)}
.ust-giris{min-height:44px;display:inline-flex;align-items:center;padding:0 12px;color:var(--head);text-decoration:none;font-size:15px;font-weight:600}
.ust-cta{min-height:44px;display:inline-flex;align-items:center;padding:0 18px;border-radius:12px;background:var(--fill);color:#FFFFFF!important;text-decoration:none;font-size:15px;font-weight:600;white-space:nowrap}
.menu-cizgi{display:inline-flex;flex-direction:column;gap:5px;width:18px}.menu-cizgi i{display:block;height:2px;border-radius:2px;background:currentColor;transition:transform .3s}.menu-cizgi i+i{width:12px}
.menu-dugme:hover .menu-cizgi i+i{transform:translateX(6px)}
@media (max-width:1280px){.arama-dugme{min-width:0}.arama-dugme .arama-yazi,.arama-dugme kbd{display:none}}
@media (max-width:1100px){.ust-menu{display:none}}
@media (max-width:760px){.ust-eylem .ust-giris,.ust-eylem .ust-cta,.ust-eylem [data-tema-dugme]{display:none}.menu-yazi{display:none}.ust{min-height:64px}}
/* Yandan açılan menü */
.cekmece{margin:0 0 0 auto;padding:0;border:0;height:100dvh;max-height:100dvh;width:min(560px,100vw);max-width:100vw;background:var(--bg);color:var(--tx);box-shadow:-30px 0 80px rgba(0,0,0,.25)}
.cekmece::backdrop{background:rgba(0,20,48,.45);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px)}
.cekmece-ic{min-height:100%;box-sizing:border-box;padding:18px clamp(20px,5vw,40px) 32px;display:flex;flex-direction:column;gap:28px}
.cekmece-bas{display:flex;align-items:center;justify-content:space-between}
.cekmece-ana{display:flex;flex-direction:column}
.cekmece-ana a{display:flex;align-items:baseline;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid var(--line);text-decoration:none;color:var(--head)}
.cekmece-ana a span{font-size:clamp(28px,6vw,40px);font-weight:700;letter-spacing:-.02em;line-height:1.1;transition:color .2s,transform .25s}
.cekmece-ana a small{font-size:14px;color:var(--tx2);text-align:right}
.cekmece-ana a:hover span,.cekmece-ana a[aria-current=page] span{color:var(--acc);transform:translateX(6px)}
.cekmece-hizmet{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:20px 24px}
.cekmece-grup{display:block;font-weight:700;color:var(--head);text-decoration:none;margin-bottom:6px}
.cekmece-hizmet ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:2px}
.cekmece-hizmet li a{display:block;padding:4px 0;color:var(--tx2);text-decoration:none;font-size:14px}
.cekmece-hizmet li a:hover{color:var(--acc)}
.cekmece-alt{margin-top:auto;display:flex;flex-direction:column;gap:16px;padding-top:20px;border-top:1px solid var(--line)}
.cekmece-iletisim{display:flex;flex-wrap:wrap;gap:8px 20px;font-size:15px}.cekmece-iletisim a{color:var(--head);font-weight:600}.cekmece-iletisim span{color:var(--tx2)}
.cekmece-eylem{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.dil-sec{display:flex;border:1px solid var(--line);border-radius:10px;overflow:hidden}.dil-sec a{min-height:44px;min-width:44px;display:flex;align-items:center;justify-content:center;text-decoration:none;color:var(--tx);font-size:14px}.dil-sec a[aria-current=true]{background:var(--tint);color:var(--tintx);font-weight:600}
/* Arama */
.arama{margin:min(12vh,120px) auto auto;padding:0;border:0;width:min(720px,calc(100vw - 32px));max-height:min(76vh,680px);border-radius:22px;background:var(--card);color:var(--tx);box-shadow:0 40px 120px rgba(0,0,0,.35);overflow:hidden}
.arama::backdrop{background:rgba(0,20,48,.5);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
.arama-ic{display:flex;flex-direction:column;max-height:inherit}
.arama-kutu{display:flex;align-items:center;gap:12px;padding:12px 12px 12px 20px;border-bottom:1px solid var(--line);color:var(--tx2)}
.arama-kutu input{flex:1;min-width:0;min-height:52px;border:0;background:transparent;color:var(--head);font:inherit;font-size:20px;outline:none}
.arama-kutu input::-webkit-search-cancel-button{display:none}
.arama-sonuc{margin:0;padding:8px;list-style:none;overflow-y:auto}
.arama-sonuc:empty{display:none}
.arama-sonuc a{display:flex;flex-direction:column;gap:2px;padding:12px 14px;border-radius:12px;text-decoration:none;color:var(--tx)}
.arama-sonuc a[aria-selected=true],.arama-sonuc a:hover{background:var(--tint)}
.arama-sonuc strong{color:var(--head);font-size:16px}.arama-sonuc mark{background:none;color:var(--acc);font-weight:700}
.arama-sonuc small{font-size:12px;color:var(--acc);font-weight:600}.arama-sonuc span{font-size:14px;color:var(--tx2)}
.arama-ipucu{margin:0;padding:16px 20px;color:var(--tx2);font-size:14px;display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.arama-ipucu button{padding:4px 12px;border:1px solid var(--line);border-radius:999px;background:transparent;color:var(--head);font:inherit;font-size:14px;cursor:pointer}
.arama-bos{padding:24px 14px;color:var(--tx2)}
@media (prefers-reduced-motion:no-preference){
  .cekmece[open]{animation:cekmeceGir .42s cubic-bezier(.2,.8,.2,1)}
  .cekmece[open]::backdrop{animation:belir .3s ease}
  .cekmece[open] .cekmece-ana a{animation:yuksel .5s calc(.06s * var(--s) + .12s) cubic-bezier(.2,.7,.2,1) both}
  .arama[open]{animation:aramaGir .28s cubic-bezier(.2,.8,.2,1)}
  .arama[open]::backdrop{animation:belir .25s ease}
}
@keyframes cekmeceGir{from{transform:translateX(100%)}to{transform:none}}
@keyframes aramaGir{from{opacity:0;transform:translateY(-12px) scale(.98)}to{opacity:1;transform:none}}
body:has(dialog[open]){overflow:hidden}
/* Ana sayfa açılışı: tam genişlik lacivert sahne, imleci izleyen turuncu ışık, IDOS paneli üstünde kendini kurar. */
#ust{position:relative;isolation:isolate;overflow:hidden;color:#C6D2E3;background:radial-gradient(900px 520px at var(--mx,72%) var(--my,38%),rgba(240,122,35,.24),transparent 62%),linear-gradient(165deg,#00163A 0%,#002559 52%,#0A3270 100%)}
#ust::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px);background-size:64px 64px;-webkit-mask-image:radial-gradient(ellipse 80% 70% at 60% 40%,#000 30%,transparent 80%);mask-image:radial-gradient(ellipse 80% 70% at 60% 40%,#000 30%,transparent 80%)}
#ust>svg{display:none}
#ust>div:nth-of-type(1){min-height:calc(100dvh - 190px);padding-top:clamp(56px,8vh,110px)!important}
#ust>div:nth-of-type(1)>div:first-child{flex:1.25 1 560px!important}
#ust h1{color:#FFFFFF!important;font-size:clamp(40px,5vw,92px)!important;letter-spacing:-.035em!important}
#ust h1 span{color:#FF8636!important}
@media (max-width:520px){#ust [style*="padding-left: 28px"]{padding-left:0!important}#ust [style*="border-right: 1px"]{border-right:0!important;padding-right:32px!important}}
#ust>div:nth-of-type(1)>div:first-child [style*="color: var(--acc)"]{color:#FFB58A!important}
#ust>div:nth-of-type(1)>div:first-child [style*="color: var(--tx2)"],#ust figcaption{color:#A9B9CF!important}
#ust>div:nth-of-type(1)>div:first-child [style*="color: var(--head)"]{color:#FFFFFF!important}
#ust>div:nth-of-type(1)>div:first-child [style*="border-right"]{border-color:rgba(255,255,255,.16)!important}
#ust a[href^="https://wa.me"]{background:rgba(255,255,255,.06)!important;border-color:rgba(255,255,255,.28)!important;color:#FFFFFF!important;backdrop-filter:blur(6px)}
#ust a[href="#analiz"]{background:#F07A23!important;color:#1A1206!important;box-shadow:0 18px 40px rgba(240,122,35,.35)!important}
#ust figure [role=img]>div{box-shadow:0 40px 90px rgba(0,0,0,.45)!important}
#ust>div:nth-of-type(2)>div{background:rgba(255,255,255,.04)!important;border-color:rgba(255,255,255,.12)!important;color:#C6D2E3!important;backdrop-filter:blur(8px)}
#ust>div:nth-of-type(2)>div [style*="color: var(--acc)"]{color:#FFB58A!important}
.site-ust.ust-koyu:not(.kaydi){background:#00163A!important;border-color:rgba(255,255,255,.08)!important}
.site-ust.ust-koyu:not(.kaydi) .ust-logo,.site-ust.ust-koyu:not(.kaydi) .ust-menu a,.site-ust.ust-koyu:not(.kaydi) .ust-giris,.site-ust.ust-koyu:not(.kaydi) .ikon-dugme{color:#FFFFFF}
.site-ust.ust-koyu:not(.kaydi) .ust-logo span span+span{color:#A9B9CF!important}
.site-ust.ust-koyu:not(.kaydi) .ikon-dugme{border-color:rgba(255,255,255,.2);background:rgba(255,255,255,.05)}
.site-ust.ust-koyu:not(.kaydi) .arama-dugme{color:#C6D2E3}.site-ust.ust-koyu:not(.kaydi) .arama-dugme kbd{border-color:rgba(255,255,255,.25);color:#C6D2E3}
.site-ust.ust-koyu:not(.kaydi) .ust-menu a[aria-current=page]{color:#FFB58A}


/* Efektler (Muhittin, 19 Eki 2026). Tek imza an: ana sayfada IDOS panelinin kendini kurması. Diğerleri kullanıcı eylemine yanıt. */
.site-ust{position:sticky;top:0;z-index:50;transition:background-color .25s,box-shadow .25s,backdrop-filter .25s}
.site-ust.kaydi{background:color-mix(in srgb,var(--bg) 93%,transparent)!important;backdrop-filter:saturate(1.4) blur(16px);-webkit-backdrop-filter:saturate(1.4) blur(16px);box-shadow:0 8px 30px var(--shadow)}
main a[style*="background: var(--fill)"],main button[style*="background: var(--fill)"],main a[style*="background: #F07A23"]{transition:transform .18s ease,box-shadow .18s ease,filter .18s}
main a[style*="background: var(--fill)"]:hover,main button[style*="background: var(--fill)"]:hover,main a[style*="background: #F07A23"]:hover{transform:translateY(-2px);filter:brightness(1.06);box-shadow:0 14px 30px rgba(184,68,6,.28)}
main a[style*="background: var(--fill)"]:active,main button[style*="background: var(--fill)"]:active{transform:translateY(0) scale(.98)}
main a svg path[d^="M5 12h14"]{transition:transform .2s}main a:hover svg path[d^="M5 12h14"]{transform:translateX(3px)}
.isik{position:relative;isolation:isolate}.isik::after{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;opacity:0;transition:opacity .3s;background:radial-gradient(260px circle at var(--x,50%) var(--y,50%),rgba(240,122,35,.20),transparent 70%);z-index:-1}.isik:hover::after{opacity:1}
@keyframes yuksel{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
@keyframes ciz{from{stroke-dashoffset:var(--boy,600)}to{stroke-dashoffset:0}}
@keyframes belir{from{opacity:0}to{opacity:1}}
@keyframes dolgu{from{opacity:0}to{opacity:.12}}
@keyframes dus{0%{opacity:0;transform:translateY(-14px) scale(.96)}70%{opacity:1;transform:translateY(2px) scale(1.01)}100%{opacity:1;transform:none}}
@keyframes nabiz{0%{box-shadow:0 0 0 0 rgba(184,68,6,.45)}100%{box-shadow:0 0 0 12px rgba(184,68,6,0)}}
@keyframes yan{0%{opacity:0;transform:scale(.6)}100%{opacity:1;transform:none}}
@media (prefers-reduced-motion:no-preference){
  #ust h1,#ust h1+p,#ust h1+p+div,#ust h1+p+div+div{animation:yuksel .7s cubic-bezier(.2,.7,.2,1) both}
  #ust h1 span{display:inline-block;animation:yuksel .7s .14s cubic-bezier(.2,.7,.2,1) both}
  #ust h1+p{animation-delay:.22s}#ust h1+p+div{animation-delay:.32s}#ust h1+p+div+div{animation-delay:.42s}
  #ust figure [role=img]>div:nth-child(1){animation:yuksel .8s .35s cubic-bezier(.2,.7,.2,1) both}
  #ust figure polyline{stroke-dasharray:var(--boy,160);--boy:160;animation:ciz 1.1s .8s ease-out both}
  #ust figure svg[viewBox="0 0 400 130"] path[fill="none"]{stroke-dasharray:var(--boy,600);--boy:600;animation:ciz 1.4s .9s ease-in-out both}
  #ust figure svg[viewBox="0 0 400 130"] path[stroke-dasharray="5 5"]{stroke-dasharray:5 5;animation:belir .6s 1.6s both}
  #ust figure svg[viewBox="0 0 400 130"] path[opacity]{animation:dolgu .9s 1.4s both}
  #ust figure [role=img]>div:nth-child(2){animation:dus .6s 1.7s cubic-bezier(.2,.7,.2,1) both}
  #ust figure [role=img]>div:nth-child(2) span[style*="var(--fill)"]{animation:nabiz 1.2s 2.4s 2 ease-out}
  #ust figure [role=img]>div:nth-child(3){animation:yuksel .6s 2s cubic-bezier(.2,.7,.2,1) both}
  #ust figure [role=img]>div:nth-child(3) span>span{animation:yan .35s cubic-bezier(.3,1.6,.5,1) both}
  #ust figure [role=img]>div:nth-child(3) span:nth-child(1)>span{animation-delay:2.35s}
  #ust figure [role=img]>div:nth-child(3) span:nth-child(2)>span{animation-delay:2.5s}
  #ust figure [role=img]>div:nth-child(3) span:nth-child(3)>span{animation-delay:2.65s}
  #ust figure [role=img]>div:nth-child(3) span:nth-child(4)>span{animation-delay:2.8s}
  .adim-sira>li{opacity:.35;transition:opacity .5s}.adim-sira>li.gorundu{opacity:1}
  .adim-sira>li span[style*="border-radius: 50%"]{transition:background-color .4s,color .4s}
  .adim-sira>li.gorundu span[style*="border-radius: 50%"]{background:var(--brand);color:#1A1206}
}

html,body{margin:0}body{background:var(--bg);color:var(--tx);font-family:'IBM Plex Sans',system-ui,sans-serif;font-size:16px;line-height:1.55;overflow-x:hidden}*,*::before,*::after{box-sizing:border-box}img{max-width:100%;height:auto}:focus-visible{outline:3px solid var(--brand);outline-offset:2px}.gizli{display:none!important}
.acik{--bg:#FBF8F4;--bg2:#F4EEE6;--card:#FFFFFF;--card2:#F7F1EA;--line:#E9DED2;--tx:#2A2622;--tx2:#5F574F;--head:#002559;--brand:#F07A23;--acc:#B84406;--fill:#B84406;--tint:#FDE9DB;--tintx:#A9420A;--ok:#176041;--okb:#E2F2E9;--err:#8A1F2E;--errb:#FCE4E6;--shadow:rgba(0,37,89,.12);--blob:#FCE7D6;--blob2:#E7EDF6}
.koyu{--bg:#171C24;--bg2:#131820;--card:#202630;--card2:#262D38;--line:#394352;--tx:#F1F3F5;--tx2:#B4BECB;--head:#F1F3F5;--brand:#F07A23;--acc:#F7894A;--fill:#B84406;--tint:rgba(240,122,35,.16);--tintx:#FFB58A;--ok:#7ADFB0;--okb:rgba(122,223,176,.13);--err:#FF9AA6;--errb:rgba(255,122,138,.14);--shadow:rgba(0,0,0,.5);--blob:rgba(240,122,35,.10);--blob2:rgba(156,195,255,.07)}
a{color:var(--acc)}a:hover{color:var(--tintx)}
.acik{--info:#1F4E8C;--infob:#E3ECF8;--warn:#7A4E00;--warnb:#FCEFD3}.koyu{--info:#9CC3FF;--infob:rgba(156,195,255,.14);--warn:#F3C56D;--warnb:rgba(243,197,109,.14)}

/* Kurumsal metin düzeni: paragraflar iki yana yaslı, Türkçe heceleme açık. Dar ekranda boşluk açılmaması için sola yaslı. */
p,li,blockquote{hyphens:auto;-webkit-hyphens:auto}@media (min-width:640px){main p.yasli{text-align:justify}}
@media print{header,footer,#cerez,[data-tema-dugme],nav[aria-label="Dil seçimi"]{display:none!important}body{background:#fff;color:#000}a{color:#000}}
@media (max-width:640px){main h1{font-size:clamp(32px,9vw,44px)!important}main h2{font-size:clamp(24px,7vw,34px)!important}}
</style>
<script is:inline>try{if(localStorage.getItem('idx-tema')==='koyu'){document.documentElement.dataset.tema='koyu'}}catch(e){}</script>
</head>
<body class="acik">
<script is:inline>if(document.documentElement.dataset.tema==='koyu'){document.body.className='koyu'}</script>
