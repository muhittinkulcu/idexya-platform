.cm-kanallar a,.cm-kanal-satir{display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:14px;background:var(--card);border:1px solid var(--line);text-decoration:none;color:var(--tx2);font-size:14px;transition:border-color .2s,transform .2s}
.cm-kanallar a:hover{border-color:var(--brand);transform:translateX(3px)}
.cm-kanallar a>span:nth-child(2),.cm-kanal-satir>span:nth-child(2){flex:1;display:flex;flex-direction:column;gap:2px}.cm-kanallar b{color:var(--head);font-size:15px}
.cm-kanallar a>svg{color:var(--brand)}
.cm-kanal-ikon{width:38px;height:38px;flex:none;border-radius:11px;background:var(--tint);color:var(--tintx);display:flex;align-items:center;justify-content:center}.cm-kanal-ikon.wa{background:#E3F6EA;color:#1E8E4E}
.koyu .cm-kanal-ikon.wa{background:rgba(76,195,138,.15);color:#7ADFB0}
.cm-cizelge{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px}
.cm-cizelge>a,.cm-cizelge>div{display:flex;flex-direction:column;gap:4px;padding:16px 18px;border-radius:14px;background:var(--card);border:1px solid var(--line);text-decoration:none;color:var(--head);font-weight:600;transition:border-color .2s,transform .2s}
.cm-cizelge>a:hover{border-color:var(--brand);transform:translateY(-2px)}
.cm-cizelge span{font-weight:400;color:var(--tx2);font-size:14px}.cm-cizelge small{font-size:12px;color:var(--acc);font-weight:600}
.cm-tek{grid-template-columns:1fr}
.cm-metin{margin:0;font-size:19px;line-height:1.6;color:var(--tx);max-width:60ch}
.cm-dip{flex:none;width:100%;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;padding-top:14px;padding-bottom:14px;border-top:1px solid var(--line);font-size:14px;color:var(--tx2)}
.cm-dip-sag{display:flex;gap:8px;align-items:center}
.dil-sec{display:flex;border:1px solid var(--line);border-radius:10px;overflow:hidden}.dil-sec a{min-height:44px;min-width:44px;display:flex;align-items:center;justify-content:center;text-decoration:none;color:var(--tx);font-size:14px}.dil-sec a[aria-current=true]{background:var(--tint);color:var(--tintx);font-weight:600}
@media (max-width:900px){
  .cm-govde{grid-template-columns:1fr}
  .cm-sahne{display:none}
  .cm-liste a{padding:14px 4px;border-radius:0;border-bottom:1px solid var(--line)}.cm-liste a.etkin{box-shadow:none;background:transparent}.cm-liste a.etkin::before{display:none}
  .cm-ok{opacity:1;transform:none}
  .cm-ara span{font-size:14px}.cm-ara kbd{display:none}
}
.cm-mobil{display:none}
@media (max-width:640px){.cm-mobil{display:flex;gap:10px;align-items:center;padding-top:8px}.cm-mobil .ust-cta{flex:1;justify-content:center;min-height:50px}.cm-ara span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.cm-ust-eylem .ust-giris,.cm-ust-eylem .ust-cta{display:none}.cm-kapat span{display:none}.cm-ust-ic{gap:10px}}
@media (prefers-reduced-motion:no-preference){
  .cekmece[open]{animation:cmGir .55s cubic-bezier(.7,0,.2,1) both}
  .cekmece[open] .cm-liste a{animation:yuksel .55s calc(.05s * var(--s) + .25s) cubic-bezier(.2,.7,.2,1) both}
  .cekmece[open] .cm-sahne{animation:yuksel .6s .35s cubic-bezier(.2,.7,.2,1) both}
  .cm-pano:not([hidden]) .cm-kutu{animation:yuksel .45s calc(.04s * var(--s)) cubic-bezier(.2,.7,.2,1) both}
  .cm-pano:not([hidden]){animation:belir .3s ease both}
}
@keyframes cmGir{from{clip-path:circle(0 at calc(100% - 70px) 38px)}to{clip-path:circle(150% at calc(100% - 70px) 38px)}}
/* Arama: Spotlight gibi — panel parlak, sayfanın geri kalanı soluk. */
.arama{margin:min(14vh,140px) auto auto;padding:0;border:0;width:min(680px,calc(100vw - 24px));max-height:min(72vh,640px);border-radius:20px;background:#FFFFFF;color:#1F2733;box-shadow:0 0 0 1px rgba(255,255,255,.6) inset,0 0 0 1px rgba(0,0,0,.08),0 50px 140px rgba(0,0,0,.45);overflow:hidden;backdrop-filter:saturate(1.8) blur(30px);-webkit-backdrop-filter:saturate(1.8) blur(30px)}
.arama::backdrop{background:rgba(10,14,22,.55);backdrop-filter:blur(3px) saturate(.6) brightness(.8);-webkit-backdrop-filter:blur(3px) saturate(.6) brightness(.8)}
.arama-ic{display:flex;flex-direction:column;max-height:inherit}
.arama-kutu{display:flex;align-items:center;gap:12px;padding:10px 10px 10px 20px;color:#6B7585}
.arama-kutu svg{width:22px;height:22px}
.arama-kutu input{flex:1;min-width:0;min-height:56px;border:0;background:transparent;color:#0B1B33;font:inherit;font-size:22px;font-weight:400;outline:none}
.arama-kutu input::placeholder{color:#8A93A0}
.arama-kutu input::-webkit-search-cancel-button{display:none}
.arama-kutu .ikon-dugme{border-color:transparent;color:#6B7585;background:transparent}.arama-kutu .ikon-dugme:hover{background:rgba(0,0,0,.05)}
.arama-sonuc{margin:0;padding:6px 8px 8px;list-style:none;overflow-y:auto;border-top:1px solid rgba(0,0,0,.08)}
.arama-sonuc:empty{display:none}
.arama-baslik{padding:10px 12px 4px;font-size:12px;font-weight:600;color:#6B7585}
.arama-sonuc a{display:flex;align-items:center;gap:12px;padding:9px 12px;border-radius:10px;text-decoration:none;color:#1F2733}
.arama-sonuc a[aria-selected=true]{background:#B84406;color:#FFFFFF}
.arama-sonuc a:hover:not([aria-selected=true]){background:rgba(0,0,0,.05)}
.arama-ikon{flex:none;width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:#FDE9DB;color:#A9420A}
.arama-sonuc a[aria-selected=true] .arama-ikon{background:rgba(255,255,255,.2);color:#FFFFFF}
.arama-metin{display:flex;flex-direction:column;min-width:0;flex:1}
.arama-sonuc strong{font-size:15px;font-weight:600;color:inherit}.arama-sonuc mark{background:none;color:inherit;text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:3px}
.arama-sonuc span.aciklama{font-size:13px;color:#5F6875;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.arama-sonuc a[aria-selected=true] span.aciklama{color:rgba(255,255,255,.85)}
.arama-sonuc small{flex:none;font-size:12px;color:#8A93A0}.arama-sonuc a[aria-selected=true] small{color:rgba(255,255,255,.8)}
.arama-bos{padding:22px 12px;color:#5F6875}
.arama-alt{display:flex;gap:18px;padding:10px 18px;border-top:1px solid rgba(0,0,0,.08);font-size:12px;color:#6B7585;background:rgba(0,0,0,.025)}
.arama-alt kbd{display:inline-block;min-width:18px;padding:0 5px;margin-right:3px;border:1px solid rgba(0,0,0,.15);border-radius:5px;background:#FFFFFF;font:inherit;font-size:11px;text-align:center}
.koyu .arama{background:#262C38;color:#EEF1F4;box-shadow:0 0 0 1px rgba(255,255,255,.12) inset,0 50px 140px rgba(0,0,0,.6)}
.koyu .arama-kutu input{color:#FFFFFF}.koyu .arama-sonuc,.koyu .arama-alt{border-color:rgba(255,255,255,.1)}.koyu .arama-sonuc a{color:#EEF1F4}.koyu .arama-sonuc span.aciklama{color:#AEB9C7}
.koyu .arama-ikon{background:rgba(240,122,35,.18);color:#FFB58A}.koyu .arama-alt{background:rgba(255,255,255,.03);color:#AEB9C7}.koyu .arama-alt kbd{background:transparent;border-color:rgba(255,255,255,.2)}
@media (max-width:640px){.arama{margin-top:12px;max-height:calc(100dvh - 24px)}.arama-alt{display:none}.arama-sonuc small{display:none}}
@media (prefers-reduced-motion:no-preference){
  .arama[open]{animation:aramaGir .28s cubic-bezier(.2,.8,.2,1)}
  .arama[open]::backdrop{animation:belir .25s ease}
}
@keyframes aramaGir{from{opacity:0;transform:translateY(-12px) scale(.98)}to{opacity:1;transform:none}}
body:has(dialog[open]){overflow:hidden}
/* Idexya Asistan */
.as-dugme{position:fixed;right:20px;bottom:20px;z-index:45;min-height:52px;display:inline-flex;align-items:center;gap:10px;padding:0 20px 0 16px;border:0;border-radius:999px;background:#002559;color:#FFFFFF;font:inherit;font-size:15px;font-weight:600;cursor:pointer;box-shadow:0 18px 44px rgba(0,37,89,.35);transition:transform .2s,box-shadow .2s}
.as-dugme:hover{transform:translateY(-2px);box-shadow:0 22px 50px rgba(0,37,89,.45)}
.as-dugme svg{color:#FF9A4D}
.as-dugme.as-acik span{display:none}.as-dugme.as-acik{padding:0 16px}
body:has(#cerez:not(.gizli)) .as-dugme{display:none}
.as-panel{position:fixed;right:20px;bottom:84px;z-index:46;width:min(400px,calc(100vw - 24px));height:min(620px,calc(100dvh - 110px));display:flex;flex-direction:column;background:var(--card);color:var(--tx);border:1px solid var(--line);border-radius:22px;box-shadow:0 40px 100px rgba(0,0,0,.25);overflow:hidden}
.as-panel[hidden]{display:none}
.as-bas{display:flex;align-items:center;gap:12px;padding:14px 14px 14px 16px;background:linear-gradient(120deg,#002559,#0A3270);color:#FFFFFF}
.as-avatar{width:38px;height:38px;border-radius:12px;background:#F07A23;color:#1A1206;display:flex;align-items:center;justify-content:center;font-weight:800}
.as-baslik{display:flex;flex-direction:column;flex:1;min-width:0;line-height:1.25}.as-baslik strong{font-size:16px}
.as-durum{font-size:12px;color:#C6D2E3;display:flex;align-items:center;gap:6px}.as-durum::before{content:"";width:7px;height:7px;border-radius:50%;background:#5BD39A}
.as-kucult{width:36px;height:36px;border:0;border-radius:10px;background:rgba(255,255,255,.1);color:#FFFFFF;font-size:22px;line-height:1;cursor:pointer}
.as-liste{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px;background:var(--bg)}
.as-balon{max-width:86%;padding:10px 14px;border-radius:16px;font-size:15px;line-height:1.5;overflow-wrap:anywhere}
.as-balon p,.as-balon ul{margin:0}.as-balon p+p,.as-balon p+ul,.as-balon ul+p{margin-top:6px}.as-balon ul{padding-left:18px}
.as-asistan{align-self:flex-start;background:var(--card);border:1px solid var(--line);border-bottom-left-radius:6px}
.as-ziyaretci{align-self:flex-end;background:#B84406;color:#FFFFFF;border-bottom-right-radius:6px}
.as-yaziyor{display:flex;gap:4px;padding:14px}.as-yaziyor i{width:7px;height:7px;border-radius:50%;background:var(--tx2);animation:asNokta 1s infinite ease-in-out}.as-yaziyor i:nth-child(2){animation-delay:.15s}.as-yaziyor i:nth-child(3){animation-delay:.3s}
@keyframes asNokta{0%,80%,100%{opacity:.25;transform:translateY(0)}40%{opacity:1;transform:translateY(-3px)}}
.as-eylemler{display:flex;flex-wrap:wrap;gap:6px}
.as-cip{padding:7px 12px;border:1px solid var(--line);border-radius:999px;background:var(--card);color:var(--head);font:inherit;font-size:13px;font-weight:600;cursor:pointer;text-decoration:none}
.as-cip:hover{border-color:var(--brand);color:var(--acc)}
.as-form{display:flex;gap:8px;align-items:flex-end;padding:10px;border-top:1px solid var(--line);background:var(--card)}
.as-form textarea{flex:1;min-height:44px;max-height:120px;padding:11px 12px;border:1px solid var(--line);border-radius:12px;background:var(--bg);color:var(--tx);font:inherit;font-size:15px;resize:none;box-sizing:border-box}
.as-gonder{flex:none;width:44px;height:44px;border:0;border-radius:12px;background:#B84406;color:#FFFFFF;cursor:pointer;display:flex;align-items:center;justify-content:center}.as-gonder:disabled{opacity:.5}
.as-not{margin:0;padding:0 12px 10px;font-size:11px;color:var(--tx2);background:var(--card)}
.as-kart{align-self:stretch;display:flex;flex-direction:column;gap:8px;padding:14px;border:1px solid var(--brand);border-radius:16px;background:var(--card)}
.as-kart strong{color:var(--head)}
.as-kart label{display:flex;flex-direction:column;gap:4px;font-size:13px;font-weight:600;color:var(--head)}
.as-kart input:not([type=checkbox]),.as-kart textarea{min-height:40px;padding:8px 10px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--tx);font:inherit;font-size:15px;font-weight:400;box-sizing:border-box;width:100%}
.as-kart .as-onay{flex-direction:row;gap:8px;align-items:flex-start;font-weight:400;color:var(--tx2)}
.as-kart-gonder{min-height:46px;border:0;border-radius:12px;background:#B84406;color:#FFFFFF;font:inherit;font-weight:600;cursor:pointer}
.as-kart p{margin:0;padding:8px 10px;border-radius:8px;font-size:13px}.as-hata{background:var(--errb);color:var(--err)}.as-ok{background:var(--okb);color:var(--ok)}
@media (max-width:560px){.as-panel{right:0;bottom:0;width:100vw;height:100dvh;border-radius:0}.as-dugme span{display:none}.as-dugme{padding:0 16px;right:16px;bottom:16px}body.as-gorunur .as-dugme{display:none}body.as-gorunur{overflow:hidden}}
@media (prefers-reduced-motion:no-preference){.as-panel:not([hidden]){animation:aramaGir .25s cubic-bezier(.2,.8,.2,1)}}
@media print{.as-dugme,.as-panel{display:none!important}}

/* Ana sayfa açılışı: açık temada krem sahne, koyu temada lacivert; ızgara ve imleci izleyen turuncu ışık. */
#ust{position:relative;isolation:isolate;overflow:hidden;background:radial-gradient(900px 520px at var(--mx,72%) var(--my,38%),rgba(240,122,35,.16),transparent 62%),radial-gradient(700px 500px at 10% 0%,rgba(0,37,89,.06),transparent 70%),var(--bg)}
#ust::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background-image:linear-gradient(rgba(0,37,89,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(0,37,89,.06) 1px,transparent 1px);background-size:64px 64px;-webkit-mask-image:radial-gradient(ellipse 80% 70% at 60% 40%,#000 30%,transparent 80%);mask-image:radial-gradient(ellipse 80% 70% at 60% 40%,#000 30%,transparent 80%)}
#ust>svg{display:none}
#ust>div:nth-of-type(1){min-height:calc(100dvh - 190px);padding-top:clamp(56px,8vh,110px)!important}
#ust>div:nth-of-type(1)>div:first-child{flex:1.25 1 560px!important}
#ust h1{font-size:clamp(40px,5vw,92px)!important;letter-spacing:-.035em!important}
@media (max-width:520px){#ust [style*="padding-left: 28px"]{padding-left:0!important}#ust [style*="border-right: 1px"]{border-right:0!important;padding-right:32px!important}}
#ust>div:nth-of-type(2)>div{background:color-mix(in srgb,var(--card) 70%,transparent)!important;backdrop-filter:blur(8px)}
.koyu #ust{position:relative;isolation:isolate;overflow:hidden;color:#C6D2E3;background:radial-gradient(900px 520px at var(--mx,72%) var(--my,38%),rgba(240,122,35,.24),transparent 62%),linear-gradient(165deg,#00163A 0%,#002559 52%,#0A3270 100%)}
.koyu #ust::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px);background-size:64px 64px;-webkit-mask-image:radial-gradient(ellipse 80% 70% at 60% 40%,#000 30%,transparent 80%);mask-image:radial-gradient(ellipse 80% 70% at 60% 40%,#000 30%,transparent 80%)}
.koyu #ust h1{color:#FFFFFF!important;font-size:clamp(40px,5vw,92px)!important;letter-spacing:-.035em!important}
.koyu #ust h1 span{color:#FF8636!important}
.koyu #ust>div:nth-of-type(1)>div:first-child [style*="color: var(--acc)"]{color:#FFB58A!important}
.koyu #ust>div:nth-of-type(1)>div:first-child [style*="color: var(--tx2)"],.koyu #ust figcaption{color:#A9B9CF!important}
.koyu #ust>div:nth-of-type(1)>div:first-child [style*="color: var(--head)"]{color:#FFFFFF!important}
.koyu #ust>div:nth-of-type(1)>div:first-child [style*="border-right"]{border-color:rgba(255,255,255,.16)!important}
