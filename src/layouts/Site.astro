---
// Ortak yerleşim: üst menü, alt kısım, tema, çerez onayı.
interface Props { baslik?: string; aciklama?: string; aktif?: string; dil?: 'tr' | 'en'; aramayaKapali?: boolean; }
const { baslik = '', aciklama = '', aktif = '', dil = 'tr', aramayaKapali = false } = Astro.props;
// Yayın öncesi: tüm site arama motorlarına kapalı. idexya.com yayına alınınca false yapılır;
// aramayaKapali olan sayfalar (ör. IDOS tanıtımı, Muhittin 19 Eki 2026) yine kapalı kalır.
const YAYIN_ONCESI = true;
const kapali = YAYIN_ONCESI || aramayaKapali;
const MENU = [
  { ad: 'Hizmetler', href: '/tr/hizmetler' }, { ad: 'Paketler', href: '/tr/paketler' }, { ad: 'IDOS', href: '/tr/idos' },
  { ad: 'Blog', href: '/tr/haberler' }, { ad: 'Hakkımızda', href: '/tr/sayfa/hakkimizda' }, { ad: 'İletişim', href: '/tr/iletisim' }
];
const tamBaslik = baslik ? `${baslik} | Idexya | Good Things` : 'Idexya | Good Things · 360° dijital performans ajansı';
const kanonik = new URL(Astro.url.pathname, Astro.site);
// Robot doğrulaması: Cloudflare Turnstile site anahtarı (gizli değildir) derleme ortamından gelir; yoksa form doğrulamasız çalışır, sunucu yine sınır uygular.
const turnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';

---
<!doctype html>
<html lang={dil} data-turnstile={turnstile || undefined}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{tamBaslik}</title>
{aciklama && <meta name="description" content={aciklama}>}
{kapali && <meta name="robots" content="noindex, nofollow">}
<link rel="canonical" href={kanonik.href}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:title" content={tamBaslik}>
{aciklama && <meta property="og:description" content={aciklama}>}
<meta property="og:type" content="website">
<meta property="og:locale" content={dil === 'en' ? 'en_US' : 'tr_TR'}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap">
<style is:global>
[hidden]{display:none!important}
/* Efektler (Muhittin, 19 Eki 2026). Tek imza an: ana sayfada IDOS panelinin kendini kurması. Diğerleri kullanıcı eylemine yanıt. */
.site-ust{position:sticky;top:0;z-index:50;transition:background-color .25s,box-shadow .25s,backdrop-filter .25s}
.site-ust:has(.menu-acik){background:var(--bg)!important;backdrop-filter:none;-webkit-backdrop-filter:none;max-height:100vh;overflow-y:auto}
.site-ust.kaydi:not(:has(.menu-acik)){background:color-mix(in srgb,var(--bg) 93%,transparent)!important;backdrop-filter:saturate(1.4) blur(16px);-webkit-backdrop-filter:saturate(1.4) blur(16px);box-shadow:0 8px 30px var(--shadow)}
main a[style*="background: var(--fill)"],main button[style*="background: var(--fill)"],main a[style*="background: #F07A23"]{transition:transform .18s ease,box-shadow .18s ease,filter .18s}
main a[style*="background: var(--fill)"]:hover,main button[style*="background: var(--fill)"]:hover,main a[style*="background: #F07A23"]:hover{transform:translateY(-2px);filter:brightness(1.06);box-shadow:0 14px 30px rgba(184,68,6,.28)}
main a[style*="background: var(--fill)"]:active,main button[style*="background: var(--fill)"]:active{transform:translateY(0) scale(.98)}
main a svg path[d^="M5 12h14"]{transition:transform .2s}main a:hover svg path[d^="M5 12h14"]{transform:translateX(3px)}
.isik{position:relative;isolation:isolate}.isik::after{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;opacity:0;transition:opacity .3s;background:radial-gradient(260px circle at var(--x,50%) var(--y,50%),rgba(240,122,35,.20),transparent 70%);z-index:-1}.isik:hover::after{opacity:1}
@keyframes yuksel{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
@keyframes ciz{from{stroke-dashoffset:var(--boy,600)}to{stroke-dashoffset:0}}
@keyframes belir{from{opacity:0}to{opacity:1}}
@keyframes dolgu{from{opacity:0}to{opacity:.12}}
@keyframes dus{0%{opacity:0;transform:translateY(-14px) scale(.96)}70%{opacity:1;transform:translateY(2px) scale(1.01)}100%{opacity:1;transform:none}}
@keyframes nabiz{0%{box-shadow:0 0 0 0 rgba(184,68,6,.45)}100%{box-shadow:0 0 0 12px rgba(184,68,6,0)}}
@keyframes yan{0%{opacity:0;transform:scale(.6)}100%{opacity:1;transform:none}}
@media (prefers-reduced-motion:no-preference){
  #ust h1,#ust h1+p,#ust h1+p+div,#ust h1+p+div+div{animation:yuksel .7s cubic-bezier(.2,.7,.2,1) both}
  #ust h1 span{display:inline-block;animation:yuksel .7s .14s cubic-bezier(.2,.7,.2,1) both}
  #ust h1+p{animation-delay:.22s}#ust h1+p+div{animation-delay:.32s}#ust h1+p+div+div{animation-delay:.42s}
  #ust figure [role=img]>div:nth-child(1){animation:yuksel .8s .35s cubic-bezier(.2,.7,.2,1) both}
  #ust figure polyline{stroke-dasharray:var(--boy,160);--boy:160;animation:ciz 1.1s .8s ease-out both}
  #ust figure svg[viewBox="0 0 400 130"] path[fill="none"]{stroke-dasharray:var(--boy,600);--boy:600;animation:ciz 1.4s .9s ease-in-out both}
  #ust figure svg[viewBox="0 0 400 130"] path[stroke-dasharray="5 5"]{stroke-dasharray:5 5;animation:belir .6s 1.6s both}
  #ust figure svg[viewBox="0 0 400 130"] path[opacity]{animation:dolgu .9s 1.4s both}
  #ust figure [role=img]>div:nth-child(2){animation:dus .6s 1.7s cubic-bezier(.2,.7,.2,1) both}
  #ust figure [role=img]>div:nth-child(2) span[style*="var(--fill)"]{animation:nabiz 1.2s 2.4s 2 ease-out}
  #ust figure [role=img]>div:nth-child(3){animation:yuksel .6s 2s cubic-bezier(.2,.7,.2,1) both}
  #ust figure [role=img]>div:nth-child(3) span>span{animation:yan .35s cubic-bezier(.3,1.6,.5,1) both}
  #ust figure [role=img]>div:nth-child(3) span:nth-child(1)>span{animation-delay:2.35s}
  #ust figure [role=img]>div:nth-child(3) span:nth-child(2)>span{animation-delay:2.5s}
  #ust figure [role=img]>div:nth-child(3) span:nth-child(3)>span{animation-delay:2.65s}
  #ust figure [role=img]>div:nth-child(3) span:nth-child(4)>span{animation-delay:2.8s}
  .adim-sira>li{opacity:.35;transition:opacity .5s}.adim-sira>li.gorundu{opacity:1}
  .adim-sira>li span[style*="border-radius: 50%"]{transition:background-color .4s,color .4s}
  .adim-sira>li.gorundu span[style*="border-radius: 50%"]{background:var(--brand);color:#1A1206}
}

html,body{margin:0}body{background:var(--bg);color:var(--tx);font-family:'IBM Plex Sans',system-ui,sans-serif;font-size:16px;line-height:1.55;overflow-x:hidden}*,*::before,*::after{box-sizing:border-box}img{max-width:100%;height:auto}:focus-visible{outline:3px solid var(--brand);outline-offset:2px}.gizli{display:none!important}
.acik{--bg:#FBF8F4;--bg2:#F4EEE6;--card:#FFFFFF;--card2:#F7F1EA;--line:#E9DED2;--tx:#2A2622;--tx2:#5F574F;--head:#002559;--brand:#F07A23;--acc:#B84406;--fill:#B84406;--tint:#FDE9DB;--tintx:#A9420A;--ok:#176041;--okb:#E2F2E9;--err:#8A1F2E;--errb:#FCE4E6;--shadow:rgba(0,37,89,.12);--blob:#FCE7D6;--blob2:#E7EDF6}
.koyu{--bg:#171C24;--bg2:#131820;--card:#202630;--card2:#262D38;--line:#394352;--tx:#F1F3F5;--tx2:#B4BECB;--head:#F1F3F5;--brand:#F07A23;--acc:#F7894A;--fill:#B84406;--tint:rgba(240,122,35,.16);--tintx:#FFB58A;--ok:#7ADFB0;--okb:rgba(122,223,176,.13);--err:#FF9AA6;--errb:rgba(255,122,138,.14);--shadow:rgba(0,0,0,.5);--blob:rgba(240,122,35,.10);--blob2:rgba(156,195,255,.07)}
a{color:var(--acc)}a:hover{color:var(--tintx)}
.acik{--info:#1F4E8C;--infob:#E3ECF8;--warn:#7A4E00;--warnb:#FCEFD3}.koyu{--info:#9CC3FF;--infob:rgba(156,195,255,.14);--warn:#F3C56D;--warnb:rgba(243,197,109,.14)}

/* Kurumsal metin düzeni: paragraflar iki yana yaslı, Türkçe heceleme açık. Dar ekranda boşluk açılmaması için sola yaslı. */
p,li,blockquote{hyphens:auto;-webkit-hyphens:auto}@media (min-width:640px){main p.yasli,article p{text-align:justify}}
@media print{header,footer,#cerez,[data-tema-dugme],nav[aria-label="Dil seçimi"]{display:none!important}body{background:#fff;color:#000}a{color:#000}}
@media (max-width:900px){.ust-menu,.ust-eylem{display:none!important}.ust.menu-acik .ust-menu{display:flex!important;flex:1 1 100%!important;flex-direction:column;gap:0!important}.ust.menu-acik .ust-menu a{padding:12px 0!important;border-bottom:1px solid var(--line)}.ust.menu-acik .ust-eylem{display:flex!important;flex:1 1 100%}.ust-ac{display:flex!important}}
@media (max-width:640px){main h1{font-size:clamp(32px,9vw,44px)!important}main h2{font-size:clamp(24px,7vw,34px)!important}}
</style>
<script is:inline>try{if(localStorage.getItem('idx-tema')==='koyu'){document.documentElement.dataset.tema='koyu'}}catch(e){}</script>
</head>
<body class="acik">
<script is:inline>if(document.documentElement.dataset.tema==='koyu'){document.body.className='koyu'}</script>
<a href="#icerik" style="position: absolute; left: -9999px; top: 8px; padding: 8px 12px; background: var(--card); color: var(--head); border-radius: 8px; z-index: 100" onfocus="this.style.left='8px'" onblur="this.style.left='-9999px'">İçeriğe geç</a>
<header class="site-ust" style="border-bottom: 1px solid var(--line); background: var(--bg)">
<div class="ust" style="max-width: 1240px; margin: 0 auto; padding: 14px 24px; box-sizing: border-box; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 32px">
<a href="/" style="display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--head)">
<svg viewBox="0 0 1000 1000" width="34" height="34" role="img" aria-label="Idexya logosu"><path fill="#F07A23" fill-rule="evenodd" d="M805.5 941.0C789.5 939.6 773.1 936.9 764.5 934.3C756.7 931.9 756.3 931.6 746.0 921.1C720.9 895.7 667.2 833.4 568.0 714.7C530.9 670.3 500.2 634.0 499.9 634.0C497.9 634.0 368.7 785.5 284.0 887.0L239.0 941.0L164.7 941.0C123.9 941.0 85.5 940.5 79.4 940.0C63.6 938.6 56.3 936.2 51.0 930.4C40.2 918.6 33.5 891.3 39.1 882.0C43.7 874.4 70.2 843.0 241.0 642.0C332.3 534.6 409.4 443.6 475.3 365.5C505.5 329.8 577.5 245.7 635.2 178.8L740.3 57.0L784.4 57.0C881.2 57.1 907.3 59.5 922.5 69.4C931.9 75.6 943.7 87.6 947.1 94.5L950.2 100.9L947.5 105.6C938.4 121.1 872.8 202.1 816.0 268.0C775.4 315.1 659.1 452.8 640.6 475.8C631.9 486.6 630.8 488.3 631.7 490.3C632.8 492.5 666.2 532.8 697.4 569.5C734.7 613.3 800.8 690.6 817.0 709.5C880.9 783.6 951.0 872.7 961.4 892.7C963.7 897.3 963.4 900.9 960.0 907.6C955.9 915.9 943.1 930.3 937.5 933.0C932.5 935.4 919.2 938.3 905.0 940.1C893.5 941.5 819.7 942.2 805.5 941.0ZM208.3 288.3C124.9 190.0 109.8 171.6 92.2 146.6C59.9 100.5 56.7 78.3 80.8 67.3C88.5 63.7 102.8 61.1 119.7 60.2C137.8 59.1 266.0 59.9 266.0 61.1C266.0 63.5 318.9 126.0 381.0 197.0C446.5 271.9 463.4 293.0 471.3 309.8C474.0 315.5 474.5 317.6 474.5 324.0C474.5 330.7 474.1 332.4 470.6 339.4C465.6 349.8 459.5 356.3 452.2 359.0C439.2 363.9 432.8 364.3 350.5 364.7L273.5 365.0L208.3 288.3Z"></path></svg>
<span style="display: flex; flex-direction: column; line-height: 1.1"><span style="font-weight: 700; font-size: 20px; letter-spacing: -0.01em">Idexya</span><span style="font-size: 12px; color: var(--tx2); letter-spacing: 0.04em">GOOD THINGS</span></span>
</a>
<button type="button" class="ust-ac" aria-expanded="false" aria-controls="ana-menu" style="display: none; margin-left: auto; min-height: 44px; padding: 0 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); color: var(--head); font: inherit; font-weight: 600; cursor: pointer; align-items: center; gap: 8px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>Menü</button>
<nav aria-label="Ana menü" id="ana-menu" class="ust-menu" style="display: flex; flex-wrap: wrap; gap: 4px 26px; flex: 1 1 420px; font-size: 15px; font-weight: 500">
{MENU.map((m) => (aktif === m.ad
  ? <a href={m.href} aria-current="page" style="color: var(--acc); text-decoration: none; padding: 10px 0; font-weight: 600">{m.ad}</a>
  : <a href={m.href} style="color: var(--tx); text-decoration: none; padding: 10px 0">{m.ad}</a>))}
</nav>
<div class="ust-eylem" style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px">
<nav aria-label="Dil seçimi" style="display: flex; border: 1px solid var(--line); border-radius: 10px; overflow: hidden">
<a href="/" aria-current={dil === 'tr' ? 'true' : undefined} hreflang="tr" style={`min-height: 44px; min-width: 44px; padding: 0 10px; display: flex; align-items: center; justify-content: center; text-decoration: none; font-size: 14px; ${dil === 'tr' ? 'background: var(--tint); color: var(--tintx); font-weight: 600' : 'color: var(--tx2)'}`}>TR</a>
<a href="/en/" aria-current={dil === 'en' ? 'true' : undefined} hreflang="en" style={`min-height: 44px; min-width: 44px; padding: 0 10px; display: flex; align-items: center; justify-content: center; text-decoration: none; font-size: 14px; ${dil === 'en' ? 'background: var(--tint); color: var(--tintx); font-weight: 600' : 'color: var(--tx2)'}`}>EN</a>
</nav>
<button type="button" data-tema-dugme aria-label="Koyu temaya geç" style="min-height: 44px; min-width: 44px; padding: 0 12px; border: 1px solid var(--line); border-radius: 10px; background: transparent; color: var(--tx); font: inherit; cursor: pointer; display: flex; align-items: center; justify-content: center">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
</button>

<a href="/tr/iletisim#form" style="min-height: 44px; display: flex; align-items: center; padding: 0 18px; border-radius: 10px; background: var(--fill); color: #FFFFFF; text-decoration: none; font-size: 15px; font-weight: 600">Ücretsiz analiz iste</a>
</div>
</div>
</header>
<main id="icerik">
<slot />
</main>
<footer style="background: var(--bg2); border-top: 1px solid var(--line)">
<div style="max-width: 1240px; margin: 0 auto; padding: 60px 24px 32px; box-sizing: border-box; display: flex; flex-direction: column; gap: 40px">
<div style="display: flex; flex-wrap: wrap; gap: 40px">
<div style="flex: 2 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 14px">
<span style="font-weight: 700; font-size: 20px; color: var(--head)">Idexya | Good Things</span>
<span style="color: var(--tx2); font-size: 15px; max-width: 360px">360° dijital performans ajansı. Reklam, e-ticaret, SEO ve yazılım tek ekipte.</span>
<div style="display: flex; gap: 8px">
<a href="https://www.instagram.com/idexya.ads" aria-label="Instagram" style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--line); border-radius: 10px; color: var(--head); background: var(--card)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.5"></circle></svg></a>
<a href="https://www.facebook.com/idexya.ads" aria-label="Facebook" style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--line); border-radius: 10px; color: var(--head); background: var(--card)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h-2a4 4 0 0 0-4 4v3H7v4h2v7h4v-7h2.5l.5-4h-3V7a1 1 0 0 1 1-1h2z"></path></svg></a>
<a href="https://twitter.com/idexya_ads" aria-label="X" style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--line); border-radius: 10px; color: var(--head); background: var(--card)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20"></path></svg></a>
</div>
</div>
<nav aria-label="Kurumsal" style="flex: 1 1 160px; display: flex; flex-direction: column; gap: 2px; font-size: 15px"><span style="font-weight: 600; padding-bottom: 8px; color: var(--head)">Kurumsal</span><a href="/tr/sayfa/hakkimizda" style="color: var(--tx2); text-decoration: none; padding: 7px 0">Hakkımızda</a><a href="/tr/haberler" style="color: var(--tx2); text-decoration: none; padding: 7px 0">Blog</a><a href="/tr/iletisim" style="color: var(--tx2); text-decoration: none; padding: 7px 0">İletişim</a></nav>
<nav aria-label="Hizmet alanları" style="flex: 1 1 160px; display: flex; flex-direction: column; gap: 2px; font-size: 15px"><span style="font-weight: 600; padding-bottom: 8px; color: var(--head)">Hizmetler</span><a href="/tr/hizmetler#e-ticaret" style="color: var(--tx2); text-decoration: none; padding: 7px 0">E-ticaret</a><a href="/tr/hizmetler#dijital-reklam" style="color: var(--tx2); text-decoration: none; padding: 7px 0">Dijital reklam</a><a href="/tr/hizmetler#seo" style="color: var(--tx2); text-decoration: none; padding: 7px 0">SEO</a><a href="/tr/hizmetler#web-yazilim" style="color: var(--tx2); text-decoration: none; padding: 7px 0">Web ve yazılım</a></nav>
<nav aria-label="Yasal" style="flex: 1 1 160px; display: flex; flex-direction: column; gap: 2px; font-size: 15px"><span style="font-weight: 600; padding-bottom: 8px; color: var(--head)">Yasal</span><a href="/tr/sayfa/kvkk-aydinlatma-metni" style="color: var(--tx2); text-decoration: none; padding: 7px 0">KVKK aydınlatma metni</a><a href="/tr/sayfa/cerez-politikasi" style="color: var(--tx2); text-decoration: none; padding: 7px 0">Çerez politikası</a><a href="/tr/sayfa/gizlilik-politikasi" style="color: var(--tx2); text-decoration: none; padding: 7px 0">Gizlilik politikası</a></nav>
</div>
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-top: 22px; border-top: 1px solid var(--line); font-size: 14px; color: var(--tx2)"><span>© 2026 Idexya | Good Things</span><span><a href="/" style="color: var(--tx2)">Türkçe</a> · <a href="/en/" style="color: var(--tx2)">English</a> · <button type="button" data-cerez-ac style="border: 0; background: none; padding: 0; color: var(--tx2); font: inherit; text-decoration: underline; cursor: pointer">Çerez tercihleri</button></span></div>
</div>
</footer>
<div id="cerez" role="dialog" aria-label="Çerez tercihleri" class="gizli" style="position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 50; max-width: 720px; margin: 0 auto; background: var(--card); border: 1px solid var(--line); border-radius: 20px; box-shadow: 0 24px 60px var(--shadow); padding: 20px; display: flex; flex-direction: column; gap: 14px">
<div style="display: flex; flex-direction: column; gap: 4px"><strong style="font-size: 17px; color: var(--head)">Çerezleri nasıl kullanalım?</strong><span style="font-size: 14px; color: var(--tx2)">Zorunlu çerezler site için gereklidir. Analitik ve pazarlama çerezleri yalnız izin verirseniz çalışır. <a href="/tr/sayfa/cerez-politikasi">Çerez politikası</a></span></div>
<div data-cerez-detay class="gizli" style="display: flex; flex-direction: column; gap: 8px">
<label style="display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 12px; border: 1px solid var(--line); background: var(--bg); font-size: 14px"><span style="display: flex; flex-direction: column"><b style="color: var(--head)">Zorunlu</b><span style="font-size: 13px; color: var(--tx2)">Site ve güvenlik için gerekli; kapatılamaz.</span></span><input type="checkbox" checked disabled style="width: 22px; height: 22px"></label>
<label style="display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 12px; border: 1px solid var(--line); background: var(--bg); font-size: 14px"><span style="display: flex; flex-direction: column"><b style="color: var(--head)">Analitik</b><span style="font-size: 13px; color: var(--tx2)">Ziyaretleri ölçmemize yardım eder (Google Analytics).</span></span><input type="checkbox" data-cerez-tur="analitik" style="width: 22px; height: 22px"></label>
