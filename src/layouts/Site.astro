@keyframes dus{0%{opacity:0;transform:translateY(-14px) scale(.96)}70%{opacity:1;transform:translateY(2px) scale(1.01)}100%{opacity:1;transform:none}}
@keyframes nabiz{0%{box-shadow:0 0 0 0 rgba(184,68,6,.45)}100%{box-shadow:0 0 0 12px rgba(184,68,6,0)}}
