---
// Ortak yerleşim: üst menü, alt kısım, tema, çerez onayı.
interface Props { baslik?: string; aciklama?: string; aktif?: string; dil?: 'tr' | 'en'; aramayaKapali?: boolean; }
const { baslik = '', aciklama = '', aktif = '', dil = 'tr', aramayaKapali = false } = Astro.props;
// Yayın öncesi: true iken tüm site arama motorlarına kapalıdır. idexya.com yayında olduğu için false;
// aramayaKapali olan sayfalar (ör. IDOS tanıtımı, Muhittin 19 Eki 2026) yine kapalı kalır.
const YAYIN_ONCESI = false;
const kapali = YAYIN_ONCESI || aramayaKapali;
// Üst menü, alt bilgi bağlantıları ve sosyal hesaplar src/data/site-menu.json'dan gelir (panelde Menüler ve SSS).
// Yayında ürün varsa "Ürünler" menüye kendiliğinden eklenir.
const urunVar = urunVeri.urunler.some((u) => u.aktif !== false);
const MENU = [...menuVeri.ust];
// Üst menü açılır panelleri: paketler dört sütunda kategoriye göre, blog son yazılar ve konularla.
const PAKET_SUTUN = [
  { ad: 'Reklam', alt: 'Google, Meta ve birleşik paketler', idler: ['google-ads', 'meta-ads', 'birlesik'] },
  { ad: 'E-ticaret', alt: 'Mağaza kurulumu, yönetim ve pazaryeri', idler: ['eticaret-site', 'eticaret-yonetim', 'pazaryeri'] },
  { ad: 'Web ve SEO', alt: 'Kurumsal site ve arama görünürlüğü', idler: ['kurumsal-site', 'seo'] },
  { ad: 'İçerik', alt: 'Sosyal medya ve içerik üretimi', idler: ['sosyal-medya'] }
].map((s) => ({ ...s, paketler: s.idler.map((id) => paketVeri.find((p) => p.id === id)).filter(Boolean) }));
const blogKonuSayi = Object.entries(yazilar.reduce((a, y) => ({ ...a, [y.kategori]: (a[y.kategori] || 0) + 1 }), {}));
// Çekmece: yazı başına tahmini okuma süresi (dakikada ~200 kelime).
const okumaDk = (y) => Math.max(1, Math.round(JSON.stringify(y.govde || '').split(/\s+/).length / 200));
const blogKategoriler = [...new Set(yazilar.map((y) => y.kategori))];
const HAKKIMIZDA = {
  rakamlar: [['10+', 'yıl e-ticaret ve dijital pazarlama'], ['27', 'hizmet, 5 alanda'], ['360°', 'reklam, mağaza, SEO ve yazılım tek planda'], ['%100', 'reklam hesapları ve veriler sizde kalır']],
  ilkeler: [['Önce ölçüm', 'Doğru ölçülmeyen reklam büyütülmez. İlk işimiz dönüşüm takibini düzeltmek.'], ['Onaysız değişiklik yok', 'Bütçe ve kampanya değişiklikleri sizin onayınızla yapılır; her adım kayıt altındadır.'],
    ['Hesaplar sizin', 'Reklam hesapları ve veriler sizin adınıza açılır. Ayrılırsanız her şey sizde kalır.'], ['Her an görünür', 'Sonuçlar IDOS panelinde her zaman açık; satış, form ve mesaj ayrı ayrı görünür.']],
  uzmanlik: ['Google Ads', 'Meta reklamları', 'E-ticaret', 'Ölçümleme ve GTM', 'BigQuery ve raporlama', 'Otomasyon']
};
// Çekmecedeki paket önizlemeleri: önce reklam ve SEO paketleri, sonra diğerleri. Her kartta önerilen kademenin ilk üç maddesi.
const PAKET_SIRA = ['google-ads', 'birlesik', 'meta-ads', 'seo', 'sosyal-medya', 'eticaret-site', 'eticaret-yonetim', 'pazaryeri', 'kurumsal-site'];
const paketOnizleme = [...paketVeri].sort((a, b) => (PAKET_SIRA.indexOf(a.id) + 99) % 99 - (PAKET_SIRA.indexOf(b.id) + 99) % 99).map((g) => {
  const one = g.kademeler.find((k) => k.rozet) || g.kademeler[Math.min(1, g.kademeler.length - 1)];
  return { id: g.id, etiket: g.turEtiket, ad: g.ad, ozet: g.ozet, not: g.ucretNotu, kademeler: g.kademeler.map((k) => k.ad), one: one.ad, maddeler: one.maddeler.filter((m) => !/ kapsamı$/.test(m)).slice(0, 3) };
});
if (urunVar && !MENU.some((m) => m.k === 'urunler')) MENU.splice(Math.max(1, MENU.findIndex((m) => m.k === 'paketler') + 1), 0, { k: 'urunler', ad: 'Ürünler', href: '/tr/urunler/', ust: true, alt: 'Ürün kataloğumuz' });
const SOSYAL_IKON = {
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.5"></circle>',
  facebook: '<path d="M15 3h-2a4 4 0 0 0-4 4v3H7v4h2v7h4v-7h2.5l.5-4h-3V7a1 1 0 0 1 1-1h2z"></path>',
  x: '<path d="M4 4l16 16M20 4L4 20"></path>',
  linkedin: '<rect x="3" y="3" width="18" height="18" rx="3"></rect><path d="M8 10v7M8 7v.5M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"></path>',
  youtube: '<rect x="2" y="5" width="20" height="14" rx="4"></rect><path d="M10 9l5 3-5 3z"></path>',
  tiktok: '<path d="M14 3v11a3 3 0 1 1-3-3"></path><path d="M14 3c.5 2.5 2.5 4 5 4"></path>'
};
const sosyalIkon = (ad) => SOSYAL_IKON[String(ad).toLocaleLowerCase('tr-TR').replace(/[^a-z]/g, '')] || '<circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"></path>';
const tamBaslik = baslik ? `${baslik} | Idexya | Good Things` : 'Idexya | Good Things · 360° dijital performans ajansı';
const kanonik = new URL(Astro.url.pathname, Astro.site);
// Robot doğrulaması: Cloudflare Turnstile site anahtarı (gizli değildir) derleme ortamından gelir; yoksa form doğrulamasız çalışır, sunucu yine sınır uygular.
const turnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';

import gruplar from '../data/hizmetler.json';
import menuVeri from '../data/site-menu.json';
import urunVeri from '../data/urunler.json';
import paketVeri from '../data/paketler.json';
import yazilar from '../data/yazilar.json';
import menuAyar from '../data/menu.json';
import { IKON } from '../data/hizmet-ikon';
import MenuGorsel from '../components/MenuGorsel.astro';
// Hizmetler menüsü görünümü (standart / orta / mega): src/data/menu.json. Simge kutusu ortak.
const ikon = (id: string, b = 20) => `<svg width="${b}" height="${b}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${IKON[id] || ''}</svg>`;
---
<!doctype html>
<html lang={dil} data-turnstile={turnstile || undefined} data-mk={menuAyar.kapali} data-ma={menuAyar.acik} data-olcum={Astro.url.pathname.startsWith('/404') ? '404' : undefined}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{tamBaslik}</title>
{aciklama && <meta name="description" content={aciklama}>}
{kapali && <meta name="robots" content="noindex, nofollow">}
<link rel="canonical" href={kanonik.href}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:title" content={tamBaslik}>
{aciklama && <meta property="og:description" content={aciklama}>}
<meta property="og:type" content="website">
<meta property="og:locale" content={dil === 'en' ? 'en_US' : 'tr_TR'}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap">
<style is:global>
[hidden]{display:none!important}
/* Akışkan yerleşim (Muhittin, 20 Eki 2026): bölümler tam genişlik, içerik geniş ekranda 1600 px'e kadar açılır, metin satırları okunur boyda kalır. */
:root{--kap:1840px;--kenar:clamp(20px,4vw,72px)}
.kap{max-width:var(--kap);margin:0 auto;padding-inline:var(--kenar);box-sizing:border-box}
main [style*="max-width: 1240px"],footer [style*="max-width: 1240px"]{max-width:var(--kap)!important;padding-left:var(--kenar)!important;padding-right:var(--kenar)!important}
main [style*="max-width: 1100px"]{max-width:1360px!important;padding-left:var(--kenar)!important;padding-right:var(--kenar)!important}
main [style*="max-width: 1192px"]{max-width:calc(var(--kap) - 2 * var(--kenar))!important}
main p{max-width:76ch}

/* Üst menü */
.site-ust{background:var(--bg);border-bottom:1px solid var(--line)}
.ust{display:flex;align-items:center;gap:12px 36px;min-height:76px;padding-top:10px;padding-bottom:10px}
.ust-logo{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--head);flex:none}
.logo-isaret{flex:none;transition:transform .45s cubic-bezier(.2,.8,.2,1);filter:drop-shadow(0 6px 14px rgba(240,122,35,.22))}
.ust-logo:hover .logo-isaret,.ust-logo:focus-visible .logo-isaret{transform:rotate(-12deg) scale(1.06)}
.logo-cizgi{width:1px;height:30px;background:var(--line);flex:none}
.logo-yazi{display:flex;flex-direction:column;gap:3px;line-height:1}
.logo-ad{font-weight:700;font-size:22px;letter-spacing:-.03em}
.logo-alt{display:flex;align-items:center;gap:6px;font-size:10.5px;font-weight:600;letter-spacing:.24em;color:var(--tx2)}
.logo-alt::before{content:"";width:12px;height:2px;border-radius:2px;background:var(--brand)}
@media (max-width:420px){.logo-cizgi{display:none}.ust-logo{gap:9px}.logo-ad{font-size:20px}}
@media (prefers-reduced-motion:reduce){.logo-isaret{transition:none}}
.ust-menu{display:flex;gap:4px 30px;font-size:15px;font-weight:500;flex:1 1 auto}
.ust-menu a{position:relative;color:var(--tx);text-decoration:none;padding:12px 0}
.ust-menu a::after{content:"";position:absolute;left:0;right:0;bottom:6px;height:2px;border-radius:2px;background:var(--brand);transform:scaleX(0);transform-origin:left;transition:transform .25s ease}
.ust-menu a:hover::after,.ust-menu a[aria-current=page]::after{transform:scaleX(1)}
.ust-menu a[aria-current=page]{color:var(--acc);font-weight:600}
.ust-eylem{display:flex;align-items:center;gap:8px;margin-left:auto}
.ikon-dugme{min-height:44px;min-width:44px;padding:0 12px;border:1px solid var(--line);border-radius:12px;background:transparent;color:var(--head);font:inherit;font-size:15px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:background-color .2s,border-color .2s}
.ikon-dugme:hover{background:var(--card);border-color:var(--brand)}
.arama-dugme{min-width:200px;justify-content:flex-start;color:var(--tx2);font-weight:500;background:var(--card)}
.arama-dugme kbd{margin-left:auto;padding:1px 6px;border:1px solid var(--line);border-radius:6px;font:inherit;font-size:12px;color:var(--tx2)}
.ust-giris{min-height:44px;display:inline-flex;align-items:center;padding:0 12px;color:var(--head);text-decoration:none;font-size:15px;font-weight:600}
.ust-cta{min-height:44px;display:inline-flex;align-items:center;padding:0 18px;border-radius:12px;background:var(--fill);color:#FFFFFF!important;text-decoration:none;font-size:15px;font-weight:600;white-space:nowrap}
.menu-cizgi{display:inline-flex;flex-direction:column;gap:5px;width:18px}.menu-cizgi i{display:block;height:2px;border-radius:2px;background:currentColor;transition:transform .3s}.menu-cizgi i+i{width:12px}
.menu-dugme:hover .menu-cizgi i+i{transform:translateX(6px)}
@media (max-width:1280px){.arama-dugme{min-width:0}.arama-dugme .arama-yazi,.arama-dugme kbd{display:none}}
.ust-menu{align-items:center}
/* Hizmetler açılır menüsü: Hizmetler > ana kategori > alt hizmetler (masaüstü). Telefonda "Menü" çekmecesi kullanılır. */
.ust-acilir{position:relative;display:flex;align-items:center;gap:2px}
.ust-acilir-ok{width:24px;height:28px;display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:6px;background:transparent;color:inherit;cursor:pointer;padding:0;transition:transform .2s}
.ust-acilir.acilmis .ust-acilir-ok{transform:rotate(180deg)}
.ust-panel{position:absolute;top:calc(100% + 10px);left:-24px;width:min(720px,calc(100vw - 48px));display:none;flex-direction:column;background:var(--card);border:1px solid var(--line);border-radius:20px;box-shadow:0 28px 60px -20px var(--shadow);padding:10px;z-index:60}
.ust-panel::before{content:"";position:absolute;left:0;right:0;top:-14px;height:14px}
.ust-acilir.acilmis .ust-panel{display:flex}
.ust-acilir.genis{position:static}
.site-ust .ust{position:relative}
.ust-genis-panel{left:var(--kenar);right:var(--kenar);width:auto;top:calc(100% - 4px);padding:16px}
.ust-genis-panel::before{top:-22px;height:22px}
.up-sutunlar{display:grid;grid-template-columns:repeat(4,minmax(0,1fr)) minmax(220px,.9fr);gap:12px}
.up-sutun{display:flex;flex-direction:column;gap:8px;padding:12px;border-radius:14px;background:var(--bg)}
.up-sutun-bas{display:flex;flex-direction:column;gap:2px;padding:2px 6px 6px}.up-sutun-bas b{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--acc)}.up-sutun-bas small{font-size:12px;color:var(--tx2)}
.up-sutun ul,.ub-yazilar ul,.ub-konular{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px}
.ust-menu .up-sutun a,.ust-menu .ub-yazilar a{display:flex;flex-direction:column;gap:3px;padding:10px 12px;border-radius:12px;background:var(--card);border:1px solid var(--line);color:var(--tx);transition:border-color .2s,transform .2s}
.ust-menu .up-sutun a:hover,.ust-menu .ub-yazilar a:hover,.ust-menu .up-sutun a:focus-visible,.ust-menu .ub-yazilar a:focus-visible{border-color:var(--brand);transform:translateY(-2px)}
.up-sutun a strong,.ub-yazilar a strong{font-size:14px;color:var(--head);font-weight:700;line-height:1.3}
.up-sutun a span,.ub-yazilar a span{font-size:12px;line-height:1.45;color:var(--tx2);font-weight:400;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.up-sutun a em{font-style:normal;font-size:11px;font-weight:600;color:var(--acc)}
.ust-menu .up-sihirbaz{display:flex;flex-direction:column;gap:6px;padding:18px;border-radius:14px;background:linear-gradient(135deg,var(--tint),var(--card) 70%);border:1px solid var(--line);color:var(--tx)}
.ust-menu .up-sihirbaz:hover{border-color:var(--brand)}
.up-sihirbaz small{font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--acc)}.up-sihirbaz strong{font-size:17px;color:var(--head)}.up-sihirbaz>span{font-size:13px;color:var(--tx2);font-weight:400;line-height:1.5}
.up-ok{margin-top:auto;display:inline-flex!important;align-items:center;gap:6px;font-weight:700!important;color:var(--acc)!important}
.ust-menu .up-sihirbaz::after,.ust-menu .up-sutun a::after,.ust-menu .ub-yazilar a::after,.ust-menu .ub-konular a::after{display:none}
.ub-izgara{display:grid;grid-template-columns:minmax(0,2.2fr) minmax(240px,1fr);gap:12px}
.ub-yazilar{display:flex;flex-direction:column;gap:8px;padding:12px;border-radius:14px;background:var(--bg)}
.ub-yazilar ul{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.ub-yazilar a small{font-size:11px;font-weight:700;color:var(--acc)}.ub-yazilar a span{-webkit-line-clamp:3}
.ub-yan{display:flex;flex-direction:column;gap:8px;padding:12px;border-radius:14px;background:var(--bg)}
.ust-menu .ub-konular a{display:flex;justify-content:space-between;align-items:center;padding:10px 12px;border-radius:10px;background:var(--card);border:1px solid var(--line);color:var(--head);font-weight:600}
.ust-menu .ub-konular a:hover{border-color:var(--brand);color:var(--acc)}.ub-konular small{font-size:12px;color:var(--tx2);font-weight:400}
@media (max-width:1200px){.up-sutunlar{grid-template-columns:repeat(3,minmax(0,1fr))}.ub-yazilar ul{grid-template-columns:1fr 1fr}}
.ust-rakam{text-decoration:none;transition:transform .2s}.ust-rakam:hover{transform:translateY(-2px)}.ust-rakam:hover span:first-child{color:var(--acc)!important}
.ust-platform{color:var(--tx2);text-decoration:none;border-bottom:2px solid transparent;padding-bottom:2px;transition:color .2s,border-color .2s}
.ust-platform:hover,.ust-platform:focus-visible{color:var(--head);border-color:var(--brand)}
.ust-platform-tum{color:var(--acc)}
.koyu #ust .ust-platform{color:#C6D2E3}.koyu #ust .ust-platform:hover{color:#FFFFFF}.koyu #ust .ust-platform-tum{color:#FFB58A}
.ust-kat{list-style:none;margin:0;padding:0;position:relative;min-height:280px;width:260px}
.ust-menu .ust-kat-bas{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px 14px;border-radius:12px;color:var(--head);font-weight:600}
.ust-menu .ust-kat-bas::after,.ust-menu .ust-alt a::after,.ust-menu .ust-panel-dip a::after{display:none}
.ust-kat-bas small{min-width:24px;height:24px;border-radius:999px;background:var(--bg);color:var(--tx2);font-size:12px;display:inline-flex;align-items:center;justify-content:center}
.ust-kat li.etkin>.ust-kat-bas{background:var(--tint);color:var(--tintx)}
.ust-kat li.etkin>.ust-kat-bas small{background:var(--card);color:var(--tintx)}
/* Seçili olmayan alt listeler görünmez ama yer ölçülebilir (visibility); liste yüksekliği en uzun kategoriye göre ayarlanır. */
.ust-alt{display:flex;visibility:hidden;pointer-events:none;position:absolute;top:0;left:272px;width:calc(min(720px,100vw - 48px) - 292px);flex-direction:column;gap:4px;padding:8px 6px}
.ust-kat li.etkin>.ust-alt{visibility:visible;pointer-events:auto}
.ust-alt strong{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--tx2);padding:4px 10px 8px}
.ust-alt ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}
.ust-menu .ust-alt a{display:block;padding:9px 10px;border-radius:10px;color:var(--tx);font-weight:500}
.ust-menu .ust-alt a:hover,.ust-menu .ust-alt a:focus-visible{background:var(--bg);color:var(--acc)}
.ust-menu .ust-alt .ust-alt-tum{margin-top:6px;color:var(--acc);font-weight:600}
.ust-menu .ust-panel-dip{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:6px;padding:10px 6px 2px 14px;border-top:1px solid var(--line)}
.ust-menu .ust-panel-dip a{color:var(--acc);font-weight:600;padding:8px 0}
.ust-menu .ust-panel-dip .ust-dip-cta{padding:9px 16px;border-radius:10px;background:var(--fill);color:#FFFFFF;font-size:14px}
/* Menü görünümleri (src/data/menu.json): standart = kategori > alt hizmet, simgeli; orta = beş sütunda tüm hizmetler;
   mega = simge, kısa açıklama, temsilî görsel ve iki sütun alt hizmet. data-mk üst çubuk, data-ma tam ekran menü içindir. */
.ust-menu .ust-kat-bas{justify-content:flex-start}
.uk-ikon{flex:none;width:32px;height:32px;border-radius:9px;background:var(--bg);color:var(--acc);display:inline-flex;align-items:center;justify-content:center}
.ust-kat li.etkin .uk-ikon{background:var(--card)}
.uk-ad{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}
.uk-ad em,.ust-gorsel,.ust-ozet{display:none}
[data-mk=orta] .ust,[data-mk=mega] .ust{position:relative}
[data-mk=orta] .ust-acilir,[data-mk=mega] .ust-acilir{position:static}
[data-mk=orta] .ust-panel,[data-mk=mega] .ust-panel{left:var(--kenar);right:var(--kenar);width:auto;top:calc(100% - 4px);padding:14px}
[data-mk=orta] .ust-panel::before,[data-mk=mega] .ust-panel::before{top:-22px;height:22px}
[data-mk=orta] .ust-kat{width:auto;min-height:0!important;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px}
[data-mk=orta] .ust-kat>li{display:flex;flex-direction:column;border-radius:14px;padding-bottom:6px;transition:background-color .2s}
[data-mk=orta] .ust-kat>li:hover{background:var(--bg)}
[data-mk=orta] .ust-kat li.etkin>.ust-kat-bas{background:transparent;color:var(--head)}
[data-mk=orta] .ust-kat li>.ust-kat-bas small{display:none}
[data-mk=orta] .ust-kat>li:hover .uk-ikon{background:var(--tint)}
[data-mk=orta] .ust-alt{position:static;visibility:visible;pointer-events:auto;width:auto;padding:0 4px;gap:0}
[data-mk=orta] .ust-alt>strong{display:none}
[data-mk=orta] .ust-menu .ust-alt a{padding:7px 10px;font-size:14px}
[data-mk=mega] .ust-kat{width:320px}
[data-mk=mega] .uk-ad em{display:block;font-style:normal;font-size:12.5px;font-weight:400;color:var(--tx2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
[data-mk=mega] .ust-kat li.etkin .uk-ad em{color:var(--tintx);opacity:.85}
