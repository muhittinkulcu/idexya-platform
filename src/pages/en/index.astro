---
import Site from '../../layouts/Site.astro';
---
<Site baslik="Digital performance agency" aciklama="Google Ads, Meta ads, e-commerce, SEO and software under one team." dil="en" aramayaKapali>
<section style="max-width: 1240px; margin: 0 auto; padding: 72px 24px 96px; display: flex; flex-direction: column; gap: 22px">
<div style="display: flex; align-items: center; gap: 12px"><span style="width: 36px; height: 2px; background: var(--brand)"></span><span style="font-size: 14px; font-weight: 600; letter-spacing: 0.06em; color: var(--acc)">360° DIGITAL PERFORMANCE AGENCY</span></div>
<h1 style="margin: 0; font-size: clamp(36px, 7vw, 60px); line-height: 1.06; letter-spacing: -0.03em; color: var(--head); max-width: 900px">Ads, e-commerce and SEO in one team. Measurable growth.</h1>
<p style="margin: 0; font-size: 20px; color: var(--tx2); max-width: 720px">The English version of our website is being prepared. In the meantime, you can reach us at <a href="mailto:info@idexya.com">info@idexya.com</a>.</p>
<div style="display: flex; gap: 12px; flex-wrap: wrap"><a href="mailto:info@idexya.com" style="min-height: 52px; display: flex; align-items: center; padding: 0 24px; border-radius: 12px; background: var(--fill); color: #FFFFFF; text-decoration: none; font-weight: 600">Contact us</a><a href="/" hreflang="tr" style="min-height: 52px; display: flex; align-items: center; padding: 0 22px; border-radius: 12px; border: 1px solid var(--line); background: var(--card); color: var(--head); text-decoration: none; font-weight: 600">Türkçe site</a></div>
</section>
</Site>
