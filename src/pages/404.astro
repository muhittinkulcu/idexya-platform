---
import Site from '../layouts/Site.astro';
---
<Site baslik="Sayfa bulunamadı">
<section style="max-width: 820px; margin: 0 auto; padding: 96px 24px; display: flex; flex-direction: column; gap: 18px; align-items: flex-start">
<span style="font-size: 72px; font-weight: 700; color: var(--brand); line-height: 1">404</span>
<h1 style="margin: 0; font-size: 40px; color: var(--head)">Aradığınız sayfa bulunamadı</h1>
<p style="margin: 0; color: var(--tx2); font-size: 18px">Adres değişmiş ya da yanlış yazılmış olabilir. Aşağıdaki bağlantılardan devam edebilirsiniz.</p>
<div style="display: flex; gap: 12px; flex-wrap: wrap"><a href="/" style="min-height: 50px; display: flex; align-items: center; padding: 0 22px; border-radius: 12px; background: var(--fill); color: #FFFFFF; text-decoration: none; font-weight: 600">Ana sayfa</a><a href="/tr/hizmetler" style="min-height: 50px; display: flex; align-items: center; padding: 0 20px; border-radius: 12px; border: 1px solid var(--line); background: var(--card); color: var(--head); text-decoration: none; font-weight: 600">Hizmetler</a><a href="/tr/iletisim" style="min-height: 50px; display: flex; align-items: center; padding: 0 20px; border-radius: 12px; border: 1px solid var(--line); background: var(--card); color: var(--head); text-decoration: none; font-weight: 600">İletişim</a></div>
</section>
</Site>
