---
import Yonetim from '../../layouts/Yonetim.astro';
---
<Yonetim baslik="Instagram gönderileri" aktif="instagram" yol="İçerik" aciklama="Ana sayfadaki Instagram şeridi. Hesap bağlıysa son gönderiler kendiliğinden gelir; bağlı değilse aşağıdan elle seçtiğiniz gönderiler gösterilir.">
<section class="kart" data-akis style="padding: 18px; display: flex; flex-direction: column; gap: 12px"></section>
<details class="kart" style="padding: 14px 18px">
<summary style="cursor: pointer; font-weight: 700">Otomatik akış nasıl bağlanır?</summary>
<ol style="margin: 10px 0 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; line-height: 1.55">
<li>@idexya.goodthings hesabı Instagram uygulamasında <b>profesyonel hesap</b> (İşletme veya İçerik üreticisi) olmalı.</li>
<li><a href="https://developers.facebook.com/apps" target="_blank" rel="noopener">Meta for Developers</a>’ta bir uygulama oluşturup <b>Instagram</b> ürününü ekleyin (“API setup with Instagram login”).</li>
<li>Hesabı uygulamaya ekleyip <b>instagram_business_basic</b> izniyle bir <b>uzun ömürlü erişim anahtarı</b> (long-lived access token) oluşturun.</li>
<li>Cloudflare’de Workers › idexya-platform › Ayarlar › Değişkenler bölümüne <code>INSTAGRAM_TOKEN</code> adıyla <b>gizli değer (Secret)</b> olarak girin. Anahtarı bu sohbete veya panele yazmayın.</li>
<li>Bu sayfaya dönüp “Şimdi çek”e basın. Sonrasında akış en geç 3 saatte bir kendiliğinden yenilenir; anahtar 30 günde bir kendiliğinden uzatılır.</li>
</ol>
</details>
<h2 style="margin: 8px 0 0; font-size: 18px">Elle seçilen gönderiler <small style="font-weight: 400; color: var(--tx2); font-size: 14px">(otomatik akış yokken gösterilir)</small></h2>
<form class="kart" data-form style="padding: 20px; display: grid; grid-template-columns: minmax(0, 1fr) 180px; gap: 16px; align-items: start">
<div style="display: flex; flex-direction: column; gap: 12px">
<label style="display: flex; flex-direction: column; gap: 6px; font-weight: 600">Gönderi bağlantısı<input name="baglanti" type="url" required placeholder="https://www.instagram.com/p/…" style="min-height: 42px; padding: 0 12px; border: 1px solid rgb(var(--line)); border-radius: 10px; background: rgb(var(--card)); color: var(--tx); font: inherit"></label>
<label style="display: flex; flex-direction: column; gap: 6px; font-weight: 600">Kısa açıklama (isteğe bağlı)<input name="aciklama" maxlength="200" placeholder="Görselin ne anlattığı; ekran okuyucular için de kullanılır" style="min-height: 42px; padding: 0 12px; border: 1px solid rgb(var(--line)); border-radius: 10px; background: rgb(var(--card)); color: var(--tx); font: inherit"></label>
<label style="display: flex; flex-direction: column; gap: 6px; font-weight: 600">Görsel<input name="dosya" type="file" accept="image/jpeg,image/png,image/webp" required></label>
<div style="display: flex; gap: 8px; align-items: center"><button type="submit" class="dugme ana">Gönderiyi ekle</button><span data-durum style="font-size: 14px; color: var(--tx2)"></span></div>
</div>
<div data-onizleme style="aspect-ratio: 1; border-radius: 12px; border: 1px dashed rgb(var(--line)); background: var(--card2) center/cover no-repeat; display: flex; align-items: center; justify-content: center; color: var(--tx2); font-size: 13px; text-align: center; padding: 8px">Görsel önizlemesi</div>
</form>
<section class="kart" aria-label="Eklenen gönderiler" data-liste style="padding: 16px; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px"></section>
<script>
  import { api, el, tarih, genelHata } from '../../scripts/yonetim/ortak.js';
  const form = document.querySelector('[data-form]'), liste = document.querySelector('[data-liste]'), onizleme = document.querySelector('[data-onizleme]'), durum = document.querySelector('[data-durum]');
  let gorsel = '';
  // Görsel tarayıcıda en fazla 720 piksele küçültülüp JPEG'e çevrilir (sunucu 280 KB'tan büyüğünü kabul etmez).
  async function kucult(dosya) {
    const resim = await createImageBitmap(dosya);
    const oran = Math.min(1, 720 / Math.max(resim.width, resim.height));
    const tuval = el('canvas', { width: Math.round(resim.width * oran), height: Math.round(resim.height * oran) });
    tuval.getContext('2d').drawImage(resim, 0, 0, tuval.width, tuval.height);
    for (const kalite of [0.82, 0.7, 0.55]) { const d = tuval.toDataURL('image/jpeg', kalite); if (d.length < 270 * 1024) return d; }
    throw new Error('Görsel küçültülemedi; daha küçük bir görsel seçin');
  }
  form.dosya.addEventListener('change', async () => {
    gorsel = ''; onizleme.style.backgroundImage = ''; onizleme.textContent = 'Hazırlanıyor…';
    const d = form.dosya.files[0]; if (!d) { onizleme.textContent = 'Görsel önizlemesi'; return; }
    try { gorsel = await kucult(d); onizleme.style.backgroundImage = `url("${gorsel}")`; onizleme.textContent = ''; }
    catch (h) { onizleme.textContent = h.message; }
  });
  form.addEventListener('submit', async (o) => {
    o.preventDefault();
    if (!gorsel) { durum.textContent = 'Önce bir görsel seçin.'; return; }
    const d = form.querySelector('button'); d.disabled = true; durum.textContent = 'Ekleniyor…';
    try {
      await api('instagram', { baglanti: form.baglanti.value.trim(), aciklama: form.aciklama.value.trim(), gorsel });
      form.reset(); gorsel = ''; onizleme.style.backgroundImage = ''; onizleme.textContent = 'Görsel önizlemesi'; durum.textContent = 'Eklendi.'; await yukle();
    } catch (h) { durum.textContent = h.message; } finally { d.disabled = false; }
  });
  async function islem(id, ne) {
    if (ne === 'sil' && !confirm('Gönderi siteden ve bu listeden kaldırılsın mı? (Instagram’daki gönderiye dokunulmaz.)')) return;
    try { await api(`instagram/${encodeURIComponent(id)}/${ne}`, {}); await yukle(); } catch (h) { genelHata('İşlem yapılamadı: ' + h.message); }
  }
  function akisCiz(r) {
    const a = r.akis, k = document.querySelector('[data-akis]');
    const dugme = el('button', { type: 'button', class: 'dugme ana', disabled: !a.kurulu, onclick: async (o) => {
      const d = o.currentTarget; d.disabled = true; d.textContent = 'Çekiliyor…';
      try { await api('instagram/akis-cek', {}); genelHata(''); await yukle(); } catch (h) { genelHata(h.message); d.disabled = false; d.textContent = 'Şimdi çek'; }
    } }, 'Şimdi çek');
    k.replaceChildren(...[
      el('div', { style: 'display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; align-items: center' },
        el('div', { style: 'display: flex; flex-direction: column; gap: 4px' },
          el('b', { style: 'font-size: 17px' }, 'Otomatik akış'),
          el('span', { style: 'color: var(--tx2); font-size: 14px' }, !a.kurulu ? 'Bağlı değil: INSTAGRAM_TOKEN tanımlanınca hesabın son gönderileri kendiliğinden gelir.'
            : `${a.kullanici ? '@' + a.kullanici + ' · ' : ''}${a.adet} gönderi · son çekim ${a.sonCekim ? tarih(a.sonCekim) : 'henüz yok'}`)),
        el('span', { style: 'display: flex; gap: 8px; align-items: center' }, el('span', { class: 'cip ' + (a.kurulu && !a.hata ? 'kazanildi' : a.kurulu ? 'kaybedildi' : 'yeni') }, a.kurulu ? (a.hata ? 'Hata' : 'Bağlı') : 'Kapalı'), dugme)),
      a.hata ? el('div', { class: 'uyari hata' }, 'Son çekim başarısız: ' + a.hata) : null,
      r.akisGonderiler.length ? el('div', { style: 'display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 8px' }, ...r.akisGonderiler.map((g) => el('a', { href: g.permalink, target: '_blank', rel: 'noopener', title: g.aciklama || '' },
        el('img', { src: `/api/instagram/akis/${encodeURIComponent(g.id)}/gorsel`, alt: '', loading: 'lazy', style: 'width: 100%; aspect-ratio: 2 / 3; object-fit: cover; border-radius: 8px; display: block' })))) : null].filter(Boolean));
  }
  async function yukle() {
    try {
      const r = await api('instagram'); genelHata(''); akisCiz(r);
      let gorunurSira = 0;
      liste.replaceChildren(...(r.gonderiler.length ? r.gonderiler.map((g) => {
        const sitede = g.gorunur && gorunurSira++ < 8;
        return el('article', { style: 'display: flex; flex-direction: column; gap: 8px; border: 1px solid rgb(var(--line)); border-radius: 12px; padding: 10px; background: rgb(var(--card))' },
          el('div', { style: 'position: relative' },
            g.gorunur ? el('img', { src: `/api/instagram/${encodeURIComponent(g.id)}/gorsel`, alt: g.aciklama || 'Instagram gönderisi', style: 'width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 8px; display: block' })
              : el('div', { style: 'aspect-ratio: 1; border-radius: 8px; background: var(--card2); display: flex; align-items: center; justify-content: center; color: var(--tx2); font-size: 13px' }, 'Gizli'),
            el('span', { class: 'cip ' + (sitede ? 'kazanildi' : 'kaybedildi'), style: 'position: absolute; left: 8px; top: 8px' }, sitede ? 'Sitede' : g.gorunur ? 'Sırada (ilk 8 dışında)' : 'Gizli')),
          el('a', { href: g.baglanti, target: '_blank', rel: 'noopener', style: 'font-size: 13px; overflow-wrap: anywhere' }, g.baglanti.replace(/^https:\/\/(www\.)?/, '')),
          g.aciklama ? el('span', { style: 'font-size: 13px; color: var(--tx2)' }, g.aciklama) : null,
          el('span', { style: 'font-size: 12px; color: var(--tx2)' }, tarih(g.olusturma)),
          el('div', { style: 'display: flex; gap: 6px; flex-wrap: wrap' },
            el('button', { type: 'button', class: 'dugme kucuk', 'aria-label': 'Yukarı taşı', onclick: () => islem(g.id, 'yukari') }, '↑'),
            el('button', { type: 'button', class: 'dugme kucuk', 'aria-label': 'Aşağı taşı', onclick: () => islem(g.id, 'asagi') }, '↓'),
            el('button', { type: 'button', class: 'dugme kucuk', onclick: () => islem(g.id, g.gorunur ? 'gizle' : 'goster') }, g.gorunur ? 'Gizle' : 'Göster'),
            el('button', { type: 'button', class: 'dugme kucuk', onclick: () => islem(g.id, 'sil') }, 'Sil')));
      }) : [el('div', { class: 'bos', style: 'grid-column: 1 / -1' }, 'Henüz gönderi eklenmedi. Gönderi eklenene kadar ana sayfada “bizi takip edin” kartı görünür.')]));
    } catch (h) { genelHata('Gönderiler yüklenemedi: ' + h.message); }
  }
  yukle();
</script>
</Yonetim>
