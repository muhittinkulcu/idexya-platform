---
import Yonetim from '../../layouts/Yonetim.astro';
---
<Yonetim baslik="Müşteri kartı" aktif="crm" yol="Müşteri ilişkileri › CRM">
<div data-ust style="display: flex; flex-direction: column; gap: 12px"></div>
<section class="kart" aria-label="Ana kayıt (IDOS)" data-ana-kayit hidden style="padding: 16px; display: flex; flex-direction: column; gap: 10px"></section>
<section class="kart" aria-label="Hesaplar ve erişimler" data-hesaplar style="padding: 16px; display: flex; flex-direction: column; gap: 10px"></section>
<section class="kart" aria-label="Reklam özeti (IDOS)" data-reklam hidden style="padding: 16px; display: flex; flex-direction: column; gap: 10px"></section>
<div style="display: flex; gap: 16px; flex-wrap: wrap; align-items: flex-start">
<section class="kart" aria-label="Müşteri bilgileri" style="flex: 1 1 320px; padding: 16px; display: flex; flex-direction: column; gap: 12px">
<div data-kart-bas><h2 style="margin: 0; font-size: 16px; color: var(--head)" data-kart-bilgi="Bu kart Panel'deki satış kaydıdır; ana kayıttaki müşteri bilgisi yukarıdaki IDOS kutusundadır.">Kart bilgileri: Panel CRM</h2><small class="kart-alt"><span data-baslik></span> · elle girilen satış bilgileri</small></div>
<form data-bilgi style="display: flex; flex-direction: column; gap: 10px">
<label class="alan">Firma<input name="firma"></label>
<label class="alan">Yetkili kişi<input name="ad"></label>
<label class="alan">E-posta<input name="eposta" type="email"></label>
<label class="alan">Telefon<input name="telefon" type="tel"></label>
<label class="alan">Sektör<input name="sektor"></label>
<label class="alan">İlgilendiği paket<input name="paket"></label>
<label class="alan">Tahmini aylık değer (TL, KDV hariç)<input name="deger" inputmode="numeric" pattern="[0-9]*"></label>
<button type="submit" class="dugme ana" style="align-self: flex-start">Bilgileri kaydet</button>
<p data-bilgi-durum role="status" hidden class="uyari" style="margin: 0"></p>
</form>
</section>
<section class="kart" aria-label="Günlük" style="flex: 2 1 460px; padding: 16px; display: flex; flex-direction: column; gap: 12px">
<div data-kart-bas><h2 style="margin: 0; font-size: 16px; color: var(--head)" data-kart-bilgi="Bu karta eklenen notlar, görüşmeler ve sistemin yazdığı kayıtlardır.">Günlük: notlar ve hareketler</h2><small class="kart-alt"><span data-baslik></span> · yeniden eskiye, en çok 300 kayıt</small></div>
<form data-not style="display: flex; flex-direction: column; gap: 8px">
<div role="group" aria-label="Kayıt türü" data-tur style="display: flex; gap: 6px; flex-wrap: wrap"></div>
<label class="alan"><span style="position: absolute; left: -10000px">Kayıt metni</span><textarea name="metin" rows="3" placeholder="Görüşme özeti, alınan karar, sonraki adım…" style="resize: vertical"></textarea></label>
<div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap"><button type="submit" class="dugme ana">Günlüğe ekle</button><span data-not-durum role="status" style="font-size: 13px; color: var(--err)"></span></div>
</form>
<ol data-gunluk style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column"></ol>
</section>
</div>
<section class="kart" aria-label="Teklifler" style="padding: 16px; display: flex; flex-direction: column; gap: 12px">
<div data-kart-bas style="display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; align-items: center"><div><h2 style="margin: 0; font-size: 16px; color: var(--head)" data-kart-bilgi="Bu müşteri için hazırlanan tekliflerin numarası, tutarı ve durumudur.">Teklifler: bu müşteriye hazırlananlar</h2><small class="kart-alt"><span data-baslik></span> · tüm teklifler</small></div><a class="dugme kucuk" data-teklif-yeni href="/proposals?new=1">+ Bu müşteriye teklif hazırla</a></div>
<ul data-teklifler style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column"></ul>
</section>
<script>
  import { api, el, ASAMALAR, tarih, para, KAYNAK, genelHata, prm } from '../../scripts/yonetim/ortak.js';
  const id = new URLSearchParams(location.search).get('id') || '';
  const ust = document.querySelector('[data-ust]'), bilgi = document.querySelector('[data-bilgi]'), gunluk = document.querySelector('[data-gunluk]');
  const TUR = [['not', 'Not'], ['gorusme', 'Görüşme'], ['eposta', 'E-posta'], ['gorev', 'Görev']];
  const TUR_RENK = { talep: '#1F4E8C', sistem: '#5F574F', not: '#B84406', gorusme: '#176041', eposta: '#6B3FA0', gorev: '#7A4E00', teklif: '#B84406' };
  let tur = 'not', m = null;

  function turCiz() {
    document.querySelector('[data-tur]').replaceChildren(...TUR.map(([k, ad]) => el('button', { type: 'button', class: 'dugme kucuk', 'aria-pressed': String(k === tur), style: k === tur ? 'background: var(--tint); border-color: var(--brand); color: var(--tintx)' : '', onclick: () => { tur = k; turCiz(); } }, ad)));
  }

  function ciz(veri) {
    m = veri.musteri;
    const ad = m.firma || m.ad || m.eposta || 'Adsız müşteri';
    document.title = ad + ' · Idexya Platform';
    document.querySelectorAll('[data-baslik]').forEach((b) => (b.textContent = ad));
    const asamaSatiri = el('div', { role: 'group', 'aria-label': 'Aşama', style: 'display: flex; gap: 6px; flex-wrap: wrap' }, ASAMALAR.map((a) => el('button', {
      type: 'button', class: 'dugme kucuk', 'aria-pressed': String(a.k === m.asama),
      style: a.k === m.asama ? 'background: var(--fill); border-color: var(--fill); color: #FFFFFF' : '',
      onclick: async (o) => {
        if (a.k === m.asama) return;
        o.currentTarget.disabled = true;
        try { await api(`musteriler/${encodeURIComponent(id)}/asama`, { asama: a.k }); yukle(); } catch (h) { genelHata('Aşama değiştirilemedi: ' + h.message); o.currentTarget.disabled = false; }
      }
    }, a.ad)));
    const iletisim = [m.ad && m.firma ? m.ad : null, m.eposta, m.telefon, m.kaynak ? 'Kaynak: ' + (KAYNAK[m.kaynak] || (m.kaynak === 'elle' ? 'Elle eklendi' : m.kaynak)) : null, 'Değer: ' + para(m.deger)].filter(Boolean).join(' · ');
    const yeniMi = prm('mevcut') === '1';
    ust.replaceChildren(
      yeniMi ? el('div', { class: 'uyari bilgi', role: 'status' }, 'Bu e-posta veya telefonla kayıtlı bir müşteri zaten vardı; yeni kart açılmadı, mevcut kart açıldı.') : '',
      m.arsiv ? el('div', { class: 'uyari', role: 'status', style: 'display: flex; gap: 10px; align-items: center; flex-wrap: wrap' },
        el('span', {}, `Bu kart ${tarih(m.arsiv)} tarihinde arşivlendi; CRM listesinde ve sayılarda görünmez. Kayıt silinmedi.`),
        el('button', { type: 'button', class: 'dugme kucuk', onclick: async (o) => { o.currentTarget.disabled = true; try { await api('musteriler/toplu', { ids: [id], islem: 'arsivden_cikar' }); yukle(); } catch (h) { genelHata('Arşivden çıkarılamadı: ' + h.message); } } }, 'Arşivden çıkar')) : '',
      el('div', { class: 'kart', style: 'padding: 16px; display: flex; flex-direction: column; gap: 10px' },
        el('div', { style: 'display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; align-items: center' },
          el('span', { style: 'color: var(--tx2); font-size: 13px; overflow-wrap: anywhere' }, iletisim),
          el('span', { style: 'display: flex; gap: 8px; flex-wrap: wrap' }, m.eposta ? el('a', { class: 'dugme kucuk', href: 'mailto:' + m.eposta }, 'E-posta yaz') : '', m.telefon ? el('a', { class: 'dugme kucuk', href: 'tel:' + m.telefon.replace(/[^\d+]/g, '') }, 'Ara') : '', el('button', { type: 'button', class: 'dugme kucuk', onclick: () => window.print() }, 'Yazdır'))),
        asamaSatiri)
    );
    ['firma', 'ad', 'eposta', 'telefon', 'sektor', 'paket'].forEach((k) => (bilgi.elements[k].value = m[k] || ''));
    bilgi.elements.deger.value = m.deger ?? '';
    gunluk.replaceChildren(...(veri.kayitlar.length ? veri.kayitlar.map((k) => el('li', { style: 'display: flex; gap: 12px; padding: 12px 0; border-top: 1px solid rgb(var(--line))' },
      el('span', { 'aria-hidden': 'true', style: `flex: none; width: 10px; height: 10px; margin-top: 6px; border-radius: 50%; background: ${TUR_RENK[k.tur] || '#5F574F'}` }),
      el('div', { style: 'flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px' },
        el('div', { style: 'display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap' }, el('strong', { style: 'color: var(--head)' }, k.baslik), el('span', { style: 'font-size: 12px; color: var(--tx2)' }, tarih(k.zaman) + ' · ' + k.kim)),
        k.detay ? el('span', { style: 'white-space: pre-wrap; overflow-wrap: anywhere' }, k.detay) : '')))
      : [el('li', { class: 'bos' }, 'Günlükte kayıt yok.')]));
  }

  // Müşterinin teklifleri (worker/teklif.js)
  const TEKLIF_DURUM = { taslak: ['Taslak', 'yeni'], gonderildi: ['Gönderildi', 'teklif'], kabul: ['Kabul edildi', 'kazanildi'], red: ['Reddedildi', 'kaybedildi'] };
  const tl = (n) => new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(Number(n) || 0) + ' TL';
  async function teklifleriYukle() {
    const kutu = document.querySelector('[data-teklifler]');
    document.querySelector('[data-teklif-yeni]').href = '/proposals?new=1&customer=' + encodeURIComponent(id);
    try {
      const r = await api('teklifler/musteri/' + encodeURIComponent(id));
      kutu.replaceChildren(...(r.teklifler.length ? r.teklifler.map((t) => el('li', { style: 'display: flex; justify-content: space-between; gap: 8px 12px; flex-wrap: wrap; padding: 10px 0; border-top: 1px solid rgb(var(--line))' },
        el('span', { style: 'display: flex; gap: 8px; align-items: center; flex-wrap: wrap; min-width: 0' }, el('a', { href: '/proposals?id=' + encodeURIComponent(t.id), style: 'font-weight: 600' }, t.no), el('span', { style: 'overflow-wrap: anywhere' }, t.baslik)),
        el('span', { style: 'display: flex; gap: 8px; align-items: center' }, el('span', { style: 'white-space: nowrap; font-variant-numeric: tabular-nums' }, tl(t.toplam)), el('span', { class: 'cip ' + (TEKLIF_DURUM[t.durum] || ['', ''])[1] }, (TEKLIF_DURUM[t.durum] || [t.durum])[0]))))
        : [el('li', { class: 'bos', style: 'padding: 16px' }, 'Bu müşteriye henüz teklif hazırlanmadı. “Bu müşteriye teklif hazırla” ile başlayabilirsiniz.')]));
    } catch (h) { kutu.replaceChildren(el('li', { class: 'bos', style: 'padding: 16px' }, 'Teklifler yüklenemedi: ' + h.message)); }
  }

  // Reklam özeti (IDOS): yalnız IDOS eşitleme sayfasında bu müşteriye eşleştirilmiş hesap varsa görünür.
  // Para birimleri birbirine eklenmez; her platform + para birimi ayrı satırdır.
  const PLATFORM = { meta: 'Meta', google: 'Google Ads' };
  const paraYaz = (n, kod) => { try { return new Intl.NumberFormat('tr-TR', { style: 'currency', currency: kod, maximumFractionDigits: 0 }).format(n || 0); } catch (e) { return new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 }).format(n || 0) + ' ' + kod; } };
  const sayi = (n) => (n === null || n === undefined ? '—' : new Intl.NumberFormat('tr-TR').format(n));
  async function reklamYukle() {
    const kutu = document.querySelector('[data-reklam]');
    let r;
    try { r = await api(`musteriler/${encodeURIComponent(id)}/reklam`); } catch (h) { kutu.hidden = true; return; }
    if (!r.hesaplar.length) { kutu.hidden = true; return; }
    kutu.hidden = false;
    kutu.replaceChildren(
      el('div', { 'data-kart-bas': '', style: 'display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; align-items: baseline' },
        el('div', {}, el('h2', { style: 'margin: 0; font-size: 16px; color: var(--head)', 'data-kart-bilgi': 'IDOS eşitleme sayfasında bu müşteriye eşleştirilen reklam hesaplarının harcama ve sonuçlarıdır.' }, 'Reklam özeti: eşleşen hesaplar'),
          el('small', { class: 'kart-alt' }, `Bu müşteri · son ${r.gun} gün, bugün hariç · para birimleri ayrı`)),
        el('a', { href: '/crm-sync', style: 'font-size: 13px' }, 'Eşleşmeleri yönet')),
      r.ozet.length
        ? el('div', { style: 'display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 8px' }, r.ozet.map((o) => el('div', { style: 'padding: 10px 12px; border-radius: 12px; background: var(--card2); display: flex; flex-direction: column; gap: 2px; min-width: 0' },
            el('span', { style: 'font-size: 12px; color: var(--tx2)' }, `${PLATFORM[o.platform] || o.platform} · ${o.para}`),
            el('strong', { style: 'font-size: 18px; color: var(--head)' }, paraYaz(o.harcama, o.para)),
            el('span', { style: 'font-size: 12px; color: var(--tx2)' }, `${sayi(o.gosterim)} gösterim · ${sayi(o.tiklama)} tıklama`))))
        : el('span', { style: 'font-size: 13px; color: var(--tx2)' }, `Eşleşen hesaplarda son ${r.gun} günde reklam verisi yok.`),
      el('span', { style: 'font-size: 12px; color: var(--tx2); overflow-wrap: anywhere' }, `Son ${r.gun} gün, bugün hariç · farklı para birimleri toplanmaz · hesaplar: ${r.hesaplar.map((h) => `${PLATFORM[h.platform] || h.platform} ${h.hesap}`).join(', ')}`));
  }

  // Hesap envanteri: bu müşterinin reklam/ölçüm hesapları ve erişim durumu.
  async function hesaplarYukle() {
    const kutu = document.querySelector('[data-hesaplar]');
    let r;
    try { r = await api('envanter/musteri/' + encodeURIComponent(id)); } catch (h) { kutu.hidden = true; return; }
    const bas = el('div', { 'data-kart-bas': '', style: 'display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; align-items: baseline' },
      el('div', {}, el('h2', { style: 'margin: 0; font-size: 16px; color: var(--head)', 'data-kart-bilgi': 'Bu müşterinin reklam ve ölçüm hesapları ile ajansın bu hesaplardaki erişim durumudur.' }, `Hesaplar ve erişimler: ${r.kayitlar.length} kayıt`),
        el('small', { class: 'kart-alt' }, 'Bu müşteri · hesap envanteri, güncel durum')),
      el('a', { href: '/accounts?customer=' + encodeURIComponent(id), style: 'font-size: 13px' }, r.kayitlar.length ? 'Envanterde yönet' : '+ Hesap ekle'));
    const CIP = { aktif: 'kazanildi', bekliyor: 'teklif', kaldirildi: 'kaybedildi' };
    kutu.replaceChildren(...[bas, r.kayitlar.length
      ? el('div', { style: 'display: flex; flex-wrap: wrap; gap: 8px' }, r.kayitlar.map((k) => el('span', { style: 'display: inline-flex; gap: 8px; align-items: center; padding: 6px 10px; border: 1px solid rgb(var(--line)); border-radius: 10px; font-size: 13px' },
          el('b', {}, r.platformlar[k.platform] || k.platform), el('span', { style: 'color: var(--tx2); font-family: ui-monospace, monospace' }, k.hesap_kimligi || k.hesap_adi || ''),
          el('span', { class: 'cip ' + (CIP[k.durum] || '') }, r.durumlar[k.durum] || k.durum))))
      : el('span', { style: 'font-size: 13px; color: var(--tx2)' }, 'Bu müşteri için henüz hesap kaydı yok. Google Ads, Meta, GA4, GTM gibi hesaplarını ve erişimlerinizi envantere ekleyin.')]);
  }

  // Müşteri ana kaydı (IDOS): salt okuma. Müşteri bilgisi IDOS'ta düzenlenir; burada düzenleme düğmesi yoktur.
  // IDOS bağlantısı kurulu değilse ve kart bağlı değilse blok görünmez. Bilinmeyen değer "—" yazılır.
  const ANA_DURUM = { aktif: 'Aktif', pasif: 'Pasif', ayrildi: 'Ayrıldı', arsiv: 'Arşiv' };
  const ANA_CIP = { aktif: 'kazanildi', pasif: 'teklif', ayrildi: 'kaybedildi', arsiv: '' };
  const tire = (v) => (v === null || v === undefined || v === '' ? '—' : v);
  async function anaKayitYukle() {
    const kutu = document.querySelector('[data-ana-kayit]');
    let r;
    try { r = await api(`musteriler/${encodeURIComponent(id)}/ana-kayit`); } catch (h) { kutu.hidden = true; return; }
    if (!r.bagli && !r.kurulu) { kutu.hidden = true; return; }
    kutu.hidden = false;
    const k = r.kayit;
    const baslik = el('div', { style: 'display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; align-items: baseline' },
      el('span', { style: 'display: flex; flex-direction: column; gap: 2px; min-width: 0' },
        el('h2', { style: 'margin: 0; font-size: 16px; color: var(--head)', 'data-kart-bilgi': 'IDOS\'taki müşteri ana kaydından okunan bilgilerdir; burada değiştirilemez, değişiklik IDOS\'ta yapılır.' }, 'Ana kayıt (IDOS): müşteri bilgileri'),
        el('small', { class: 'kart-alt' }, 'Bu müşteri · salt okuma · son eşitleme aşağıda')),
      r.duzenle ? el('a', { href: r.duzenle, target: '_blank', rel: 'noopener noreferrer', class: 'dugme kucuk' }, 'Ana kayıtta düzenle ↗') : '');
    const satirlar = [baslik];
    if (!r.bagli) {
      const a = r.aday;
      satirlar.push(el('span', { style: 'font-size: 13px; color: var(--tx2)' }, 'Bu kart ana kayda bağlı değil. Müşteri bilgileri IDOS\'tan okunmuyor.'));
      if (a && a.durum === 'bekliyor') {
        satirlar.push(el('div', { class: 'uyari bilgi', role: 'status' }, `Ana kayıt onayı bekleniyor. ${tarih(a.gonderim)} tarihinde ${a.gonderen} gönderdi; kararı IDOS'ta yönetici verir.`));
      } else if (r.asama !== 'kazanildi') {
        satirlar.push(el('span', { style: 'font-size: 13px; color: var(--tx2)' }, 'Fırsat "Kazanıldı" aşamasına gelince "Müşteri yap" ile ana kayda onaya gönderilebilir.'));
      } else if (r.kurulu) {
        if (a && a.durum === 'reddedildi') satirlar.push(el('div', { class: 'uyari hata', role: 'status' }, 'Ana kayda alınmadı: ' + (a.red_gerekcesi || 'gerekçe yazılmadı') + '. Kartı düzeltip yeniden gönderebilirsiniz.'));
        const izin = el('input', { type: 'checkbox', 'data-kisi-izin': '' });
        const durum = el('span', { role: 'status', style: 'font-size: 13px; color: var(--err)' });
        const dugme = el('button', { type: 'button', class: 'dugme ana kucuk', 'data-musteri-yap': '', onclick: async () => {
          dugme.disabled = true; durum.textContent = '';
          try { await api(`musteriler/${encodeURIComponent(id)}/musteri-yap`, { kisi_izin: izin.checked }); yukle(); }
          catch (h) { durum.textContent = 'Gönderilemedi: ' + h.message; dugme.disabled = false; }
        } }, a && a.durum === 'reddedildi' ? 'Yeniden onaya gönder' : 'Müşteri yap');
        satirlar.push(el('div', { style: 'display: flex; flex-direction: column; gap: 8px; padding: 10px 12px; border-radius: 12px; background: var(--card2)' },
          el('span', { style: 'font-size: 13px' }, 'Kart, IDOS\'taki onay kuyruğuna gider. Marka, sektör ve sorumlu gönderilir. Müşteri kaydı yalnız yönetici onaylarsa açılır.'),
          el('label', { style: 'display: flex; gap: 8px; align-items: flex-start; font-size: 13px' }, izin, el('span', {}, 'İletişim kişisinin adı, e-postası ve telefonu da gönderilsin. Kişinin bu bilgilerin paylaşılmasına izni var (KVKK).')),
          el('div', { style: 'display: flex; gap: 10px; align-items: center; flex-wrap: wrap' }, dugme, durum)));
      }
    } else if (r.yok) {
      satirlar.push(el('div', { class: 'uyari hata', role: 'status' }, 'Bağlı ana kayıt IDOS\'ta bulunamadı. Müşteri silinmiş ya da paylaşımdan çıkarılmış olabilir. IDOS\'ta kontrol edin.'));
    } else if (!k) {
      satirlar.push(el('div', { class: 'uyari hata', role: 'status' }, 'Ana kayıt okunamadı' + (r.hata ? ': ' + r.hata : '') + '. Önbellekte bu müşteri için kayıt yok.'));
    } else {
      const h = k.hesaplar || {};
      const say = (l) => (Array.isArray(l) ? l.filter((x) => x.tur !== 'arsiv').length : 0);
      const var_ = (v) => (v ? 'bağlı' : '—');
      satirlar.push(
        el('div', { style: 'display: flex; gap: 8px; flex-wrap: wrap; align-items: center' },
          el('strong', { style: 'font-size: 15px; color: var(--head); overflow-wrap: anywhere' }, tire(k.marka)),
          k.durum ? el('span', { class: 'cip ' + (ANA_CIP[k.durum] || '') }, ANA_DURUM[k.durum] || k.durum) : el('span', { class: 'cip' }, 'Durum: —'),
          el('span', { style: 'font-size: 13px; color: var(--tx2); overflow-wrap: anywhere' }, 'Sorumlu: ' + tire(k.sorumlu))),
        el('span', { style: 'font-size: 13px; overflow-wrap: anywhere' }, [
          'Unvan: ' + tire(k.unvan), 'Sektör: ' + tire(k.sektor), 'Ana sonuç: ' + tire(k.ana_sonuc)].join(' · ')),
        k.web_sitesi ? el('span', { style: 'font-size: 13px; overflow-wrap: anywhere' }, 'Web sitesi: ', el('a', { href: k.web_sitesi, target: '_blank', rel: 'noopener noreferrer' }, k.web_sitesi)) : el('span', { style: 'font-size: 13px' }, 'Web sitesi: —'),
        el('span', { style: 'font-size: 13px; overflow-wrap: anywhere' }, [
          'Meta reklam hesabı: ' + say(h.meta_ads), 'Google Ads hesabı: ' + say(h.google_ads), 'GA4: ' + var_(h.ga4),
          'Search Console: ' + var_(h.search_console), 'GTM: ' + var_(h.gtm_web), 'Merchant Center: ' + var_(h.merchant)].join(' · ')));
      if (r.eski) satirlar.push(el('div', { class: 'uyari', role: 'status' }, 'IDOS\'a şu an ulaşılamadı' + (r.hata ? ' (' + r.hata + ')' : '') + '; son önbellek gösteriliyor. Bilgiler güncel olmayabilir.'));
    }
    satirlar.push(el('span', { style: 'font-size: 12px; color: var(--tx2)' }, 'Son eşitleme: ' + (r.son_esitleme ? tarih(r.son_esitleme) : '—') + (k && r.cekim ? ' · bu kayıt alındı: ' + tarih(r.cekim) : '')));
    kutu.replaceChildren(...satirlar);
  }

  async function yukle() {
    anaKayitYukle();
    teklifleriYukle();
    reklamYukle();
    hesaplarYukle();
    try { ciz(await api('musteriler/' + encodeURIComponent(id))); }
    catch (h) { genelHata(h.durum === 404 ? 'Bu müşteri bulunamadı. Bağlantı eski olabilir; CRM listesinden açın.' : 'Müşteri yüklenemedi: ' + h.message); }
  }

  bilgi.addEventListener('submit', async (o) => {
    o.preventDefault();
    const d = document.querySelector('[data-bilgi-durum]');
    const v = Object.fromEntries(new FormData(bilgi));
    const deger = String(v.deger || '').replace(/\./g, '').trim();
    if (deger && !/^\d+$/.test(deger)) { d.hidden = false; d.className = 'uyari hata'; d.textContent = 'Değer yalnız rakam olmalı (ör. 18000).'; return; }
    v.deger = deger;
    try { const r = await api(`musteriler/${encodeURIComponent(id)}/bilgi`, v); d.hidden = false; d.className = r.degisen && !r.degisen.length ? 'uyari bilgi' : 'uyari ok'; d.textContent = r.degisen && !r.degisen.length ? 'Değişiklik yok; bir şey kaydedilmedi.' : 'Kaydedildi ve günlüğe işlendi.'; yukle(); }
    catch (h) { d.hidden = false; d.className = 'uyari hata'; d.textContent = 'Kaydedilemedi: ' + h.message; }
  });
  const notForm = document.querySelector('[data-not]');
  notForm.addEventListener('submit', async (o) => {
    o.preventDefault();
    const d = document.querySelector('[data-not-durum]'); d.textContent = '';
    const metin = notForm.elements.metin.value.trim();
    if (!metin) { d.textContent = 'Önce bir şey yazın.'; return; }
    try { await api(`musteriler/${encodeURIComponent(id)}/not`, { tur, metin }); notForm.reset(); yukle(); }
    catch (h) { d.textContent = 'Eklenemedi: ' + h.message; }
  });
  turCiz();
  if (!id) genelHata('Müşteri seçilmedi. CRM listesinden bir müşteri açın.'); else yukle();
</script>
</Yonetim>
