---
import Yonetim from '../../layouts/Yonetim.astro';
---
<Yonetim baslik="Reklam dönüşümleri" aktif="donusum" yol="Analiz" aciklama="Reklam tıklamasıyla gelip CRM’de “Kazanıldı” olan talepler. Google Ads çevrimdışı dönüşüm ve Meta çevrimdışı etkinlik dosyası olarak indirip platforma yükleyebilirsiniz.">
<style is:global>
  .dn-kpi{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}
  .dn-kpi>div{padding:14px 16px;display:flex;flex-direction:column;gap:4px}
  .dn-indir{padding:16px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:14px}
  .dn-indir section{display:flex;flex-direction:column;gap:8px}
  .dn-indir input{min-height:40px;padding:0 12px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--tx);font:inherit}
  .dn-tablo{width:100%;min-width:900px;border-collapse:collapse;font-size:14px}
  .dn-tablo th{padding:10px 14px;text-align:left;font-size:12px;color:var(--tx2);font-weight:600}
  .dn-tablo td{padding:10px 14px;border-top:1px solid var(--line);vertical-align:top}
</style>
<div class="uyari bilgi">Kimlikler yalnız ziyaretçi <b>pazarlama çerezlerine izin verdiyse</b> toplanır. İndirilen dosyalarda e-posta ve telefon <b>yoktur</b>; eşleşme yalnız tıklama kimliğiyle yapılır. Google Ads tıklamadan sonra en çok 90 gün içindeki dönüşümleri kabul eder; dönüşüm işleminin adı Google Ads’te tanımlı adla birebir aynı olmalıdır. Yüklemeyi platformda siz yaparsınız; bu panel reklam hesaplarına bağlanmaz.</div>
<div class="dn-kpi" data-kpi></div>
<div class="kart dn-indir">
  <section>
    <b>Google Ads çevrimdışı dönüşüm</b>
    <label class="alan">Dönüşüm işleminin adı (Google Ads’teki ile aynı)<input data-ad-google value="Müşteri kazanıldı" maxlength="100"></label>
    <span style="display: flex; gap: 8px; flex-wrap: wrap"><a class="dugme ana" data-indir="google" href="#">CSV indir (yüklenmemişler)</a><button type="button" class="dugme" data-isaretle="google">Yüklendi olarak işaretle</button></span>
    <small style="color: var(--tx2)">Google Ads › Hedefler › Dönüşümler › Yüklemeler bölümünden yüklenir.</small>
  </section>
  <section>
    <b>Meta çevrimdışı etkinlik</b>
    <label class="alan">Etkinlik adı<input data-ad-meta value="Purchase" maxlength="100"></label>
    <span style="display: flex; gap: 8px; flex-wrap: wrap"><a class="dugme ana" data-indir="meta" href="#">CSV indir (yüklenmemişler)</a><button type="button" class="dugme" data-isaretle="meta">Yüklendi olarak işaretle</button></span>
    <small style="color: var(--tx2)">Meta Etkinlik Yöneticisi › veri seti › çevrimdışı etkinlik yükleme; sütun eşleştirmesini yükleme ekranında yapın (fbc = tıklama kimliği).</small>
  </section>
</div>
<section class="kart" aria-label="Tıklama kimliği olan talepler" data-liste style="overflow-x: auto"></section>
<script>
  import { api, el, tarih, genelHata } from '../../scripts/yonetim/ortak.js';
  const liste = document.querySelector('[data-liste]'), kpi = document.querySelector('[data-kpi]');
  let v = null;
  const tl = (n) => (n || n === 0 ? new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 2 }).format(n) + ' TL' : '—');
  const bekleyen = (p) => v.adaylar.filter((x) => x.kazanildi && (p === 'google' ? x.gclid && !x.pencere_disi && !x.google_aktarim : x.fbclid && !x.meta_aktarim));
  document.querySelectorAll('[data-indir]').forEach((a) => a.addEventListener('click', (o) => {
    o.preventDefault();
    const p = a.dataset.indir, ad = document.querySelector(`[data-ad-${p}]`).value.trim();
    location.href = `/api/yonetim/donusum/csv/${p}?ad=${encodeURIComponent(ad)}`;
  }));
  document.querySelectorAll('[data-isaretle]').forEach((d) => d.addEventListener('click', async () => {
    const p = d.dataset.isaretle, b = bekleyen(p);
    if (!b.length) { genelHata('İşaretlenecek yüklenmemiş dönüşüm yok.'); return; }
    if (!confirm(`${b.length} dönüşüm ${p === 'google' ? 'Google Ads' : 'Meta'} için “yüklendi” olarak işaretlensin mi? Yalnız dosyayı platforma yükledikten sonra işaretleyin; işaretlenenler bir sonraki dosyaya girmez.`)) return;
    d.disabled = true;
    try { await api('donusum/isaretle', { platform: p, talepler: b.map((x) => x.talep_id) }); await yukle(); } catch (h) { genelHata(h.message); } finally { d.disabled = false; }
  }));
  function ciz() {
    const kaz = v.adaylar.filter((x) => x.kazanildi);
    kpi.replaceChildren(...[['Tıklama kimliği olan talep', v.ozet.n || 0], ['Kazanılan', kaz.length], ['Google’a yüklenecek', bekleyen('google').length], ['Meta’ya yüklenecek', bekleyen('meta').length]]
      .map(([ad, n]) => el('div', { class: 'kart' }, el('span', { style: 'font-size: 12px; color: var(--tx2)' }, ad), el('b', { style: 'font-size: 24px' }, String(n)))));
    if (!v.adaylar.length) { liste.replaceChildren(el('div', { class: 'bos' }, 'Henüz tıklama kimliğiyle gelen talep yok. Pazarlama çerezine izin veren bir ziyaretçi reklamdan gelip form doldurduğunda burada görünür.')); return; }
    liste.replaceChildren(el('table', { class: 'dn-tablo' },
      el('thead', {}, el('tr', {}, ...['Talep', 'Kaynak', 'Müşteri', 'Dönüşüm', 'Değer (KDV hariç)', 'Aktarım'].map((b) => el('th', { scope: 'col' }, b)))),
      el('tbody', {}, ...v.adaylar.map((x) => el('tr', {},
        el('td', {}, tarih(x.talep_zamani), el('div', { style: 'font-size: 12px; color: var(--tx2)' }, 'tıklama ' + tarih(x.tiklama_zamani))),
        el('td', { style: 'font-size: 13px' }, [x.gclid ? 'Google (gclid)' : x.gbraid || x.wbraid ? 'Google (iOS)' : null, x.fbclid ? 'Meta (fbclid)' : null].filter(Boolean).join(' · ') || '—',
          x.utm_source ? el('div', { style: 'color: var(--tx2)' }, [x.utm_source, x.utm_medium, x.utm_campaign].filter(Boolean).join(' / ')) : null),
        el('td', {}, x.musteri_id ? el('a', { href: '/yonetim/musteri/?id=' + encodeURIComponent(x.musteri_id) }, x.firma || x.ad || 'Müşteri') : el('span', { style: 'color: var(--tx2)' }, 'CRM’e alınmadı')),
        el('td', {}, x.kazanildi ? el('span', { class: 'cip kazanildi' }, 'Kazanıldı') : el('span', { class: 'cip yeni' }, 'Henüz değil'), x.donusum_zamani ? el('div', { style: 'font-size: 12px; color: var(--tx2)' }, tarih(x.donusum_zamani)) : null,
          x.pencere_disi ? el('div', { style: 'font-size: 12px; color: var(--warn)' }, 'Google için 90 gün aşıldı') : null, (x.gbraid || x.wbraid) && !x.gclid ? el('div', { style: 'font-size: 12px; color: var(--tx2)' }, 'iOS kimliği: dosyaya girmez') : null),
        el('td', {}, tl(x.deger)),
        el('td', { style: 'font-size: 12px; color: var(--tx2)' }, x.google_aktarim ? 'Google ✓ ' + tarih(x.google_aktarim) : null, x.meta_aktarim ? el('div', {}, 'Meta ✓ ' + tarih(x.meta_aktarim)) : null, !x.google_aktarim && !x.meta_aktarim ? '—' : null))))));
  }
  async function yukle() { try { v = await api('donusum'); genelHata(''); ciz(); } catch (h) { genelHata('Dönüşümler yüklenemedi: ' + h.message); } }
  yukle();
</script>
</Yonetim>
