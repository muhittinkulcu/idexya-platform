---
import Yonetim from '../../layouts/Yonetim.astro';
---
<Yonetim baslik="Belge şablonları" aktif="sablonlar" yol="Satış ve müşteri" aciklama="Şablonu bir kez hazırlayın; her müşteri için panel doldurur, PDF’i müşteri kartına kaydeder. Panel hiçbir belgeyi müşteriye göndermez, gönderimi siz yaparsınız.">
<style is:global>
  .sb-sekmeler{display:flex;flex-wrap:wrap;gap:4px;padding:4px;border-radius:12px;background:var(--track,var(--card2));max-width:100%;width:max-content}
  .sb-izgara{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(280px,100%),1fr));gap:14px}
  .sb-kart{padding:16px;display:flex;flex-direction:column;gap:8px}
  .sb-kart h3{margin:0;font-size:16px;color:var(--head)}
  .sb-kart p{margin:0;color:var(--tx2);font-size:13px;flex:1}
  .sb-kart .sb-alt{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap}
  .cip.sb-hazir{background:var(--okb);color:var(--ok)}.cip.sb-taslak{background:var(--warnb,var(--card2));color:var(--warn)}.cip.sb-onerilen{background:var(--card2);color:var(--tx2)}.cip.sb-pasif{background:var(--card2);color:var(--tx2)}
  .sb-tablo{width:100%;border-collapse:collapse;font-size:14px}
  .sb-tablo th{padding:8px 10px;text-align:left;font-size:12px;font-weight:500;color:var(--tx2);border-bottom:1px solid rgb(var(--line))}
  .sb-tablo td{padding:8px 10px;border-bottom:1px solid rgb(var(--line));vertical-align:middle}
  .sb-tablo .sayi{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
  .sb-tablo input[type=text],.sb-tablo select{min-height:36px;padding:4px 10px;border:1px solid rgb(var(--line));border-radius:10px;background:var(--bg);color:var(--tx);font:inherit;box-sizing:border-box;max-width:100%}
  .sb-tablo input.sb-fiyat{width:140px;text-align:right}
  .sb-tablo input[aria-invalid=true]{border-color:var(--err)}
  .sb-form{padding:16px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(200px,100%),1fr));gap:12px;align-items:end}
  .sb-form .genis{grid-column:1/-1}
  .sb-duzen{display:grid;grid-template-columns:220px minmax(0,1fr) 320px;gap:16px;align-items:start}
  .sb-sayfalar{display:flex;flex-direction:column;gap:8px}
  .sb-sk{border:2px solid rgb(var(--line));border-radius:12px;padding:6px;background:rgb(var(--card));cursor:pointer;display:flex;gap:8px;align-items:center;text-align:left;font:inherit;color:var(--tx)}
  .sb-sk[aria-current=true]{border-color:var(--brand)}
  .sb-sk img{width:52px;aspect-ratio:210/297;object-fit:cover;border-radius:4px;border:1px solid rgb(var(--line));background:#fff}
  .sb-sk b{display:block;font-size:13px;color:var(--head)}.sb-sk small{font-size:12px;color:var(--tx2)}
  .sb-onizleme{background:var(--card2);border-radius:16px;padding:16px;display:flex;flex-direction:column;align-items:center;gap:10px}
  .sb-metin{width:100%;min-height:420px;padding:10px 12px;border:1px solid rgb(var(--line));border-radius:10px;background:var(--bg);color:var(--tx);font:13px/1.55 ui-monospace,SFMono-Regular,Menlo,monospace;box-sizing:border-box;resize:vertical}
  .sb-yardim{margin:0;padding-left:18px;font-size:12px;color:var(--tx2);display:flex;flex-direction:column;gap:2px}
  .sb-yardim code{font-size:12px}
  .sb-sk .sb-metin-simge{width:52px;aspect-ratio:210/297;border-radius:4px;border:1px solid rgb(var(--line));background:#fff;display:flex;flex-direction:column;gap:4px;padding:8px 6px;box-sizing:border-box}
  .sb-sk .sb-metin-simge i{display:block;height:2px;background:var(--tx2);opacity:.45;border-radius:1px}.sb-sk .sb-metin-simge i:first-child{background:var(--brand);opacity:1}
  .sb-a4{width:min(100%,520px);aspect-ratio:1654/2339;background:#fff;position:relative;box-shadow:0 10px 30px var(--shadow);overflow:hidden}
  .sb-a4 img,.sb-a4 canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
  .sb-alan{position:absolute;outline:2px dashed var(--brand);background:rgba(240,122,35,.08);font-size:11px;color:#A9420A;font-weight:500;padding:2px 4px;box-sizing:border-box;overflow:hidden}
  .sb-yan{padding:16px;display:flex;flex-direction:column;gap:12px}
  .sb-adimlar{display:flex;gap:14px;flex-wrap:wrap;color:var(--tx2);font-size:13px;align-items:center}
  .sb-adimlar span{display:inline-flex;gap:6px;align-items:center}
  .sb-adimlar b{background:var(--fill);color:#fff;border-radius:50%;width:22px;height:22px;display:inline-flex;align-items:center;justify-content:center;font-size:12px}
  .sb-onizle-izgara{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(220px,100%),1fr));gap:12px}
  .sb-onizle-izgara figure{margin:0;display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--tx2)}
  .sb-onizle-izgara img{width:100%;aspect-ratio:1654/2339;border:1px solid rgb(var(--line));border-radius:6px;background:#fff}
  .sb-toplam{display:flex;gap:8px 16px;flex-wrap:wrap;align-items:center;font-size:14px}
  .sb-gizli{position:absolute;left:-10000px}
  @media (max-width:1100px){.sb-duzen{grid-template-columns:180px minmax(0,1fr)}.sb-duzen .sb-yan{grid-column:1/-1}}
  @media (max-width:700px){.sb-duzen{grid-template-columns:minmax(0,1fr)}.sb-sayfalar{flex-direction:row;overflow-x:auto}.sb-sk{flex:none}}
</style>
<div role="tablist" aria-label="Belge şablonları bölümleri" class="sb-sekmeler" data-sekmeler></div>

<!-- 1. Şablonlar ve hizmet kataloğu -->
<div data-s="liste" style="display: flex; flex-direction: column; gap: 16px">
  <div class="sb-izgara" data-sablonlar><p class="bos">Şablonlar yükleniyor…</p></div>
  <section class="kart" id="catalog" aria-label="Hizmet kataloğu" data-katalog-bolum style="padding: 20px 22px; display: flex; flex-direction: column; gap: 12px">
    <div style="display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; align-items: center">
      <div><h2 style="margin: 0; font-size: 16px; color: var(--head)">Hizmet kataloğu</h2><small style="color: var(--tx2)">Teklif oluştururken seçilen hizmetler ve varsayılan fiyatları (KDV hariç). Fiyat her teklifte değiştirilebilir. Hizmet silinmez, pasife alınır.</small></div>
      <button type="button" class="dugme ana kucuk" data-hizmet-yeni>+ Hizmet ekle</button>
    </div>
    <form class="kart sb-form" data-hizmet-form hidden novalidate style="background: var(--card2)">
      <h3 class="genis" style="margin: 0; font-size: 15px; color: var(--head)" data-hizmet-baslik>Yeni hizmet</h3>
      <label class="alan genis">Hizmet adı<input name="ad" maxlength="120" required autocomplete="off" placeholder="Ör. Google Reklam Yönetimi"></label>
      <label class="alan">Tür<select name="tur"><option value="aylik">Aylık</option><option value="tek_seferlik">Tek seferlik</option></select></label>
      <label class="alan">Varsayılan fiyat (KDV hariç, TL)<input name="fiyat" inputmode="decimal" autocomplete="off" placeholder="Boş bırakılabilir, ör. 20.000"></label>
      <label class="alan">Simge (Proje hakkında sayfası)<select name="simge"><option value="genel">Sade turuncu simge</option><option value="google">Google</option><option value="meta">Meta</option></select></label>
      <div class="genis" style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center">
        <button type="submit" class="dugme ana">Kaydet</button><button type="button" class="dugme" data-hizmet-vazgec>Vazgeç</button>
        <span role="status" data-hizmet-durum style="font-size: 14px; color: var(--err)"></span>
      </div>
    </form>
    <div data-katalog style="overflow-x: auto"></div>
  </section>
</div>

<!-- 2. Şablonu düzenle -->
<div data-s="duzen" hidden style="display: flex; flex-direction: column; gap: 14px">
  <div data-duzen-uyari style="display: flex; flex-direction: column; gap: 8px"></div>
  <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center; justify-content: space-between">
    <label style="display: flex; gap: 8px; align-items: center; font-size: 14px">Sürüm <select data-surum style="min-height: 36px; border-radius: 10px; border: 1px solid rgb(var(--line)); background: var(--bg); color: var(--tx); padding: 0 8px; font: inherit"></select></label>
    <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center">
      <span role="status" data-duzen-durum style="font-size: 14px"></span>
      <button type="button" class="dugme" data-ornek>Örnek veriyle göster</button>
      <button type="button" class="dugme ana" data-kaydet disabled>Kaydet</button>
    </div>
  </div>
  <div class="sb-duzen">
    <div class="sb-sayfalar" data-sayfalar></div>
    <div class="sb-onizleme"><div class="sb-a4" data-a4><img alt="" data-a4-gorsel><canvas data-a4-canvas hidden></canvas><div data-alanlar></div></div><div data-a4-nav hidden style="display: flex; gap: 8px; align-items: center; font-size: 13px; color: var(--tx2)"></div></div>
    <aside class="kart sb-yan" data-yan></aside>
  </div>
  <input type="file" accept="image/jpeg,image/png" class="sb-gizli" data-gorsel-dosya tabindex="-1" aria-hidden="true">
</div>

<!-- 3. Müşteriye belge oluştur -->
<div data-s="olustur" hidden style="display: flex; flex-direction: column; gap: 14px">
  <div class="sb-adimlar" aria-hidden="true"><span><b>1</b> Müşteri ve şablon</span><span><b>2</b> <span data-adim2>Hizmetler ve fiyatlar</span></span><span><b>3</b> Önizleme</span><span><b>4</b> PDF oluştur ve karta kaydet</span></div>
  <form class="kart sb-form" data-belge-form novalidate>
    <label class="alan">Müşteri (CRM)<select name="musteri_id" data-musteri required><option value="">Müşteri seçin</option></select></label>
    <label class="alan">Şablon<select name="sablon" data-belge-sablon></select></label>
    <label class="alan genis" data-yalniz-teklif>Teklif adı<input name="ad" maxlength="200" required autocomplete="off" placeholder="Ör. Kasım dijital pazarlama teklifi"></label>
    <label class="alan" data-yalniz-teklif>Teklif tarihi<input name="tarih" type="date" required></label>
    <label class="alan" data-yalniz-teklif>Geçerlilik<input name="gecerlilik" type="date"></label>
    <label class="alan" data-yalniz-teklif>Hazırlayan<input name="hazirlayan" maxlength="80" autocomplete="off" placeholder="Ör. Muhittin Külcü"></label>
    <label class="alan" data-yalniz-teklif>Kayıt durumu<select name="durum"><option value="taslak">Taslak (henüz gönderilmedi)</option><option value="gonderildi">Gönderildi (ben gönderdim)</option></select></label>
    <label class="genis" data-yalniz-teklif style="display: flex; gap: 8px; align-items: flex-start; font-size: 13px"><input type="checkbox" name="asama" value="1" disabled> <span>Kartın aşamasını “Teklif gönderildi” yap ve günlüğe yaz (yalnız “Gönderildi” seçiliyse; ileri aşamadaki kart geri alınmaz)</span></label>
    <label class="alan genis" data-yalniz-belge hidden>Belge adı<input name="belge_ad" maxlength="200" autocomplete="off" placeholder="Ör. Erişim talebi · Örnek Mobilya"></label>
    <label class="alan" data-yalniz-belge hidden>Belge no<input name="belge_no" maxlength="40" autocomplete="off" placeholder="Ör. ERT-2026-001"></label>
    <label class="alan" data-yalniz-belge hidden>Belge tarihi<input name="belge_tarih" type="date"></label>
  </form>
  <div data-belge-not style="display: flex; flex-direction: column; gap: 8px"></div>
  <section class="kart" aria-label="Belge bilgileri" data-yalniz-belge hidden style="padding: 20px 22px; display: flex; flex-direction: column; gap: 16px">
    <div data-degiskenler style="display: flex; flex-direction: column; gap: 18px"></div>
  </section>
  <section class="kart" aria-label="Hizmetler ve fiyatlar" data-yalniz-teklif style="padding: 20px 22px; display: flex; flex-direction: column; gap: 12px">
    <div style="display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; align-items: center">
      <div><h2 style="margin: 0; font-size: 16px; color: var(--head)">Hizmetler ve fiyatlar</h2><small style="color: var(--tx2)">Varsayılan fiyatlar hizmet kataloğundan gelir; bu teklif için değiştirilebilir. ** aylık, * tek seferlik hizmettir.</small></div>
      <button type="button" class="dugme kucuk" data-satir-ekle>+ Satır ekle</button>
    </div>
    <div data-kalemler style="overflow-x: auto"></div>
    <div class="sb-toplam" data-toplam></div>
  </section>
  <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center; justify-content: flex-end">
    <span role="status" data-belge-durum style="font-size: 14px; margin-right: auto"></span>
    <button type="button" class="dugme" data-onizle>Önizle</button>
    <button type="button" class="dugme ana" data-pdf>PDF oluştur ve karta kaydet</button>
  </div>
  <div class="uyari ok" data-sonuc hidden></div>
  <section class="kart" aria-label="Önizleme" data-onizleme-bolum hidden style="padding: 20px 22px; display: flex; flex-direction: column; gap: 12px">
    <h2 style="margin: 0; font-size: 16px; color: var(--head)">Önizleme</h2>
    <div class="sb-onizle-izgara" data-onizleme></div>
  </section>
  <p style="margin: 0; font-size: 13px; color: var(--tx2)" data-kayit-yeri>PDF oluşunca müşteri kartının “Teklifler” listesine düşer (kaynak: Şablon). PDF’i indirip WhatsApp ya da e-postayla siz gönderirsiniz; panel kendiliğinden göndermez.</p>
</div>

<script>
  import { api, el, prm, adresMetni, genelHata } from '../../scripts/yonetim/ortak.js';
  import { bugunIst, gun, musterileriDoldur, dosyaIndir } from '../../scripts/yonetim/kayit.js';
  import { SAYFA_EN, SAYFA_BOY, tlTam, tlBelge, kurusOku, toplamlar, teklifTutari } from '../../scripts/yonetim/sablon-hesap.js';
  import { gorselAdresi, planHazirla, sayfaCiz, belgePdf } from '../../scripts/yonetim/belge-uret.js';
  import { TANIMLAR, MUSTERI_ALANLARI, ajansDegerleri, altSatir, degerleriHazirla, varsayilan } from '../../scripts/yonetim/sablon-tanim.js';
  import { belgeFormu } from '../../scripts/yonetim/belge-form.js';

  const $ = (s) => document.querySelector(s);
  const TUR = { aylik: 'Aylık', tek_seferlik: 'Tek seferlik' };
  const SIMGE = { genel: 'Sade', google: 'Google', meta: 'Meta' };
  const TIP = { sabit: 'Sabit görsel', kapak: 'Görsel + firma adı ve tarih', hizmetler: 'Görsel + hizmet listesi', kalemler: 'Görsel + fiyat tablosu', metin: 'Antetli metin (taşarsa sonraki sayfaya akar)' };
  const ACIKLAMA = {
    teklif: 'Kapak, Neler yapıyoruz, hizmet açıklamaları, Proje hakkında, Fiyat teklifi, Teşekkür. Hizmetler ve fiyatlar müşteriye göre dolar.',
    sozlesme: 'Genel hükümler (24 madde) ve seçilen ekler: Ek-1A aylık hizmet, Ek-1B web projesi, Ek-2 KVKK. Avukat incelemesinden geçene kadar her sayfada “TASLAK” damgası.',
    erisim: 'Yeni müşteriden istenen erişimler: seçilen platformlar (Google Ads, Meta, GA4, GTM, Search Console, Merchant Center, barındırma, alan adı, pazaryeri), istenen yetki ve nasıl verileceği. Şifre istenmez. 2 sayfa.',
    odeme_hatirlatma: 'Vadesi geçen faturalar için iki ton: 1. kibar hatırlatma, 2. kesin bildirim (son ödeme tarihi, faiz, askıya alma). Resmî ihtarname değildir. 1 sayfa.',
    teslim: 'Web sitesi gibi tek seferlik işlerin teslimi: teslim edilenler, hesaplar (şifresiz), kontroller, açık işler, kabul beyanı ve imza. 3–4 sayfa.',
    fiyat_guncelleme: 'Aylık ücret değişikliği: mevcut ve yeni ücret, değişim oranı, yürürlük tarihi, gerekçe ve müşterinin hakkı. 1 sayfa.',
    brief: 'Kampanya, içerik dönemi ya da proje başında hedef, hedef kitle, bütçe, yasaklı ifadeler, marka kuralları ve onaylayan kişi.',
    ek_is: 'Kapsam dışı iş için yazılı kabul: iş, tutar, süreye etkisi ve imza. Web projelerinde uyuşmazlığın ana kaynağını kapatır.',
    icerik_onay: 'Aylık sosyal medya içerik takviminin tek sayfada onayı; reklam kısıtı yüksek sektörlerde yararlı.',
    hesap_devir: 'Çalışma bitince erişimlerin kaldırıldığı, açılan hesapların devredildiği ve verilerin silindiğinin kaydı.',
    gizlilik: 'Teklif aşamasında satış ve müşteri verisi paylaşılacaksa karşılıklı, kısa gizlilik sözleşmesi.',
    rapor_kapagi: 'Aylık performans raporu kapağı: dönem, müşteri, hazırlayan; sonuç türleri ayrı, veri tazeliği yazılı.'
  };
  const DURUM_CIP = { hazir: ['sb-hazir', 'Hazır'], taslak: ['sb-taslak', 'Taslak'], onerilen: ['sb-onerilen', 'Önerilen'] };
  // Örnek müşteri (düzenleyici önizlemesi; gerçek veri değildir)
  const ORNEK_MUSTERI = { firma: 'Örnek Mobilya Ltd. Şti.', ad: 'Ayşe Örnek', eposta: 'ayse@ornekmobilya.com.tr' };
  let ajansAyar = null;
  async function ajansAl() { if (!ajansAyar) { try { ajansAyar = ajansDegerleri((await api('ayarlar')).degerler); } catch (h) { ajansAyar = ajansDegerleri({}); } } return ajansAyar; }
  const AJANS_ALAN_ADI = { ajans_unvan: 'Firma adı / unvan', ajans_adres: 'Adres', ajans_vergi: 'Vergi dairesi ve numarası', ajans_mersis: 'MERSİS', ajans_iban: 'IBAN', ajans_yetkili: 'İmzalayan yetkili', ajans_yetkili_unvan: 'Yetkilinin unvanı', ajans_meta_isletme_id: 'Meta işletme kimliği', ajans_mcc_id: 'Google Ads yönetici hesabı', ajans_google_eposta: 'Google ürünleri için e-posta' };
  const EDITOR_NOTU = {
    sozlesme: 'Bu şablon TASLAK: avukat incelemesinden geçmemiştir. PDF’in her sayfasının üstünde “TASLAK — avukat incelemesinden geçmemiştir” damgası basılır.',
    odeme_hatirlatma: 'Faiz dayanağı, faiz oranı ve asgari giderim tutarı her yıl değişir; metinde değişkendir ve belge oluştururken girilir. Avukatla teyit edin. Bu not PDF’te görünmez.',
    teslim: 'Tutanak avukat incelemesinden geçmelidir. Şifre ve doğrulama kodu bu belgeye yazılmaz.'
  };
  function ornekDegerler(tur, ajans) {
    const t = TANIMLAR[tur] || { alanlar: [] }, b = { tarih: bugunIst(), belgeNo: 'ÖRN-2026-001', musteri: ORNEK_MUSTERI, ajans }, ham = {};
    for (const a of MUSTERI_ALANLARI) ham[a.k] = ORNEK_MUSTERI[a.kaynak];
    for (const a of t.alanlar) ham[a.k] = varsayilan(a, b);
    if (tur === 'odeme_hatirlatma') ham.faturalar = [{ no: 'IDX2026000123', tarih: '2026-10-01', vade: '2026-10-08', tutar: '18.000' }];
    if (tur === 'fiyat_guncelleme') ham.fiyat_satirlari = [{ hizmet: 'Meta Reklam Yönetimi', eski: '20.000', yeni: '23.000' }];
    return degerleriHazirla(tur, ham, b);
  }
  const ORNEK = { firma: 'Örnek Reklam Ajansı', tarih: bugunIst(), kalemler: [
    { ad: 'Google Reklam Yönetimi', tur: 'aylik', fiyat_kurus: 2000000, simge: 'google' },
    { ad: 'Meta Reklam Yönetimi', tur: 'aylik', fiyat_kurus: 2000000, simge: 'meta' },
    { ad: 'Kurumsal Website Tasarımı', tur: 'tek_seferlik', fiyat_kurus: 6000000, simge: 'genel' }] };
  const fiyatMetni = (k) => (k === null || k === undefined ? '' : tlTam(k).replace(/ TL$/, ''));
  const gunEkle = (g, n) => { const d = new Date(g + 'T00:00:00Z'); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); };

  // ---------- Sekmeler ----------
  const SEKMELER = [['liste', 'Şablonlar'], ['duzen', 'Şablonu düzenle'], ['olustur', 'Müşteriye belge oluştur']];
  const ilk = prm('sekme');
  let duzenId = /^[a-z_]{1,40}$/.test(prm('sablon') || '') ? prm('sablon') : 'teklif';
  const sablonAdi = (id) => (sablonlar.find((x) => x.id === id) || {}).ad || (id === 'teklif' ? 'Fiyat teklifi' : id);
  let sekme = ilk === 'olustur' || ilk === 'duzen' ? ilk : 'liste';
  let kirli = false;
  function sekmeCiz() {
    $('[data-sekmeler]').replaceChildren(...SEKMELER.map(([k, ad]) => {
      const s = k === sekme;
      return el('button', { type: 'button', role: 'tab', 'aria-selected': String(s), 'data-sekme': k, class: 'dugme kucuk', style: s ? 'background: rgb(var(--card)); box-shadow: 0 1px 3px var(--shadow)' : 'border-color: transparent; background: transparent', onclick: () => sekmeAc(k) }, k === 'duzen' ? `${ad}: ${sablonAdi(duzenId)}` : ad);
    }));
    document.querySelectorAll('[data-s]').forEach((d) => { d.hidden = d.dataset.s !== sekme; });
  }
  function sekmeAc(k, ek = {}) {
