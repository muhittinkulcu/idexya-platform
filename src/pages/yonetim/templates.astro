      kutu.replaceChildren(el('span', { style: 'font-weight: 500' }, 'PDF oluşturuldu ve müşteri kartının Belgeler bölümüne kaydedildi. '), `${bSablon.sablon.ad}${d.veri.taslak ? ' (TASLAK damgalı)' : ''} · ${sayfaSayisi} sayfa · ${Math.round(pdf.byteLength / 1024)} KB. Panel bu belgeyi müşteriye göndermez. `,
        el('a', { href: '/customer?id=' + encodeURIComponent(d.m.id) + '#belgeler' }, 'Müşteri kartını aç'), ' · ',
        el('a', { href: '#', onclick: (x) => { x.preventDefault(); dosyaIndir(pdf, ad, 'application/pdf'); } }, 'PDF’i indir'));
      kutu.hidden = false; kutu.scrollIntoView({ block: 'nearest' });
      try { bForm.belge_no.value = (await api(`belge-dosyalari/siradaki-no/${encodeURIComponent(bSablon.id)}`)).belge_no; } catch (h) { /* numara boş kalabilir */ }
    } catch (h) { bYaz('PDF oluşturulamadı: ' + h.message, true); } finally { dugme.disabled = false; }
  }
  $('[data-pdf]').addEventListener('click', async (o) => {
    const d = denetle(); if (!d || !aktifSurum) return;
    if (bSablon && bSablon.id !== 'teklif') { await belgePdfKaydet(d, o.currentTarget); return; }
    const bilinmeyen = d.veri.kalemler.filter((k) => k.fiyat_kurus === null).length;
    if (bilinmeyen && !confirm(`${bilinmeyen} kalemin fiyatı boş; PDF’te “—” görünecek. Yine de oluşturulsun mu?`)) return;
    const dugme = o.currentTarget; dugme.disabled = true; $('[data-sonuc]').hidden = true;
    try {
      const { pdf, sayfaSayisi } = await belgePdf(aktifSurum.sayfalar, d.veri, { baslik: bForm.ad.value.trim(), yazar: bForm.hazirlayan.value.trim() || 'Idexya', ilerleme: (i, n) => bYaz(`PDF hazırlanıyor (${i} / ${n})…`) });
      bYaz('Müşteri kartına kaydediliyor…');
      const tutar = teklifTutari(d.veri.kalemler.filter((k) => k.fiyat_kurus !== null));
      const ad = dosyaAdi(d.veri.firma, d.veri.tarih);
      const fd = new FormData();
      fd.append('dosya', new File([pdf], ad, { type: 'application/pdf' }));
      for (const [k, v] of Object.entries({ musteri_id: d.m.id, ad: bForm.ad.value.trim(), tarih: d.veri.tarih, gecerlilik: bForm.gecerlilik.value, tutar: `${Math.floor(tutar / 100)},${String(tutar % 100).padStart(2, '0')}`, durum: bForm.durum.value, kaynak: 'sablon' })) fd.append(k, v);
      if (!bForm.asama.disabled && bForm.asama.checked) fd.append('asama', '1');
      const r = await fetch('/api/yonetim/teklif-dosyalari', { method: 'POST', credentials: 'same-origin', body: fd });
      const s = await r.json().catch(() => ({ ok: false, hata: 'Sunucudan geçersiz yanıt geldi' }));
      if (!r.ok || !s.ok) throw new Error(s.hata || `Kaydedilemedi (${r.status})`);
      bYaz('');
      const kutu = $('[data-sonuc]');
      kutu.replaceChildren(el('b', {}, 'PDF oluşturuldu ve müşteri kartına kaydedildi. '), `${sayfaSayisi} sayfa · ${Math.round(pdf.byteLength / 1024)} KB · tutar ${tlBelge(tutar)} (KDV hariç). Panel bu belgeyi müşteriye göndermez. `,
        el('a', { href: '/customer?id=' + encodeURIComponent(d.m.id) }, 'Müşteri kartını aç'), ' · ',
        el('a', { href: '#', onclick: (x) => { x.preventDefault(); dosyaIndir(pdf, ad, 'application/pdf'); } }, 'PDF’i indir'));
      kutu.hidden = false; kutu.scrollIntoView({ block: 'nearest' });
    } catch (h) { bYaz('PDF oluşturulamadı: ' + h.message, true); } finally { dugme.disabled = false; }
  });

  // ---------- Başlangıç ----------
  sekmeCiz();
  sablonlariYukle();
  katalogYukle().then(() => { if (prm('sekme') === 'katalog') document.getElementById('catalog').scrollIntoView(); });
  if (sekme === 'duzen') duzenHazirla();
  if (sekme === 'olustur') olusturHazirla();
</script>
</Yonetim>
