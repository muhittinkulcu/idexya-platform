---
import Yonetim from '../../layouts/Yonetim.astro';
---
<Yonetim baslik="Entegrasyonlar" aktif="entegre" yol="Finans ve bağlantılar" aciklama="Sitenin ve panelin bağlı olduğu servislerin durumu. Değerler güvenlik için gösterilmez; yalnızca tanımlı olup olmadıkları görünür. Değişiklikler Cloudflare panelinde, Workers › idexya-platform › Ayarlar › Değişkenler bölümünden yapılır.">
<section class="kart" aria-label="Bağlantılar" data-liste style="padding: 16px; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px"></section>
<script>
  import { api, el, genelHata } from '../../scripts/yonetim/ortak.js';
  const DURUM = { bagli: ['Bağlı', 'kazanildi'], eksik: ['Tanımlı değil', 'kaybedildi'], kapali: ['Kapalı', 'yeni'] };
  (async () => {
    try {
      const r = await api('entegrasyonlar');
      document.querySelector('[data-liste]').replaceChildren(...r.liste.map((b) => el('article', { style: 'display: flex; flex-direction: column; gap: 8px; padding: 16px; border: 1px solid var(--line); border-radius: 12px' },
        el('div', { style: 'display: flex; justify-content: space-between; gap: 10px; align-items: flex-start' }, el('b', {}, b.ad), el('span', { class: 'cip ' + DURUM[b.durum][1], style: 'flex: none' }, DURUM[b.durum][0])),
        el('span', { style: 'color: var(--tx2); font-size: 14px' }, b.detay),
        b.ayar ? el('code', { style: 'font-size: 12px; color: var(--tx2); overflow-wrap: anywhere' }, 'Ayar: ' + b.ayar) : null,
        b.k === 'idos' ? el('a', { href: '/yonetim/veri-esitleme/', style: 'font-size: 14px; font-weight: 600' }, 'Veri eşitleme geçmişi →') : null)));
    } catch (h) { genelHata('Entegrasyonlar yüklenemedi: ' + h.message); }
  })();
</script>
</Yonetim>
