---
// Banner stüdyosu (Muhittin, 28 Eki 2026): duyuru şeritleri (kayan, sabit, dönen), görsel bannerlar, açılır pencereler ve
// köşe kutuları. Tür ve şablon seçimi, sekmeli düzenleyici, canlı önizleme (masaüstü/telefon), sitedeki yerleşim haritası,
// hedefleme (sayfa, cihaz, ziyaretçi), zamanlama (tarih, gün, saat), kapatma ve tetikleyici davranışı, 30 günlük istatistik.
// Kayıtlar D1'de; site /api/bannerlar ile canlı okur (worker/banner.js). Önizleme sitedeki çiziciyle aynıdır (src/scripts/banner.js).
import Yonetim from '../../layouts/Yonetim.astro';
import BannerStil from '../../components/BannerStil.astro';
---
<Yonetim baslik="Banner stüdyosu" aktif="bannerlar" yol="Web sitesi" aciklama="Sitedeki duyuru şeritlerini, görsel bannerları, açılır pencereleri ve köşe kutularını buradan oluşturun. Kaydettiğiniz değişiklik en geç bir dakika içinde sitede görünür; yeniden yayınlama gerekmez.">
<BannerStil />
<div data-gorunum="liste">
  <div class="bs-kpi" data-kpi></div>
  <section class="kart bs-harita-kart" aria-labelledby="bs-h">
    <div class="bs-bas"><h2 id="bs-h">Sitedeki yerleşim</h2><span>Bir alana tıklayınca o alandaki bannerlar listelenir.</span></div>
    <div class="bs-harita" data-harita></div>
  </section>
  <div class="bs-arac">
    <div class="bs-cipler" role="group" aria-label="Türe göre süz" data-tur-suz></div>
    <select data-durum-suz aria-label="Duruma göre süz"><option value="">Bütün durumlar</option><option value="yayinda">Yayında</option><option value="zamanli">Zamanlanmış</option><option value="taslak">Taslak</option><option value="duraklatildi">Duraklatıldı</option><option value="bitti">Süresi doldu</option></select>
    <input type="search" data-ara placeholder="Banner ara…" aria-label="Banner ara">
    <button type="button" class="dugme ana" data-yeni>+ Yeni banner</button>
  </div>
  <div data-liste class="bs-liste"></div>
</div>

<div data-gorunum="sec" hidden>
  <button type="button" class="dugme kucuk" data-geri>← Bannerlar</button>
  <h2 class="bs-h2">Ne oluşturmak istiyorsunuz?</h2>
  <div class="bs-turler" data-turler></div>
  <h2 class="bs-h2">Ya da hazır bir şablonla başlayın</h2>
  <div class="bs-sablonlar" data-sablonlar></div>
</div>

<div data-gorunum="duzen" hidden>
  <div class="bs-duzen">
    <div class="bs-form">
      <div class="bs-form-ust">
        <button type="button" class="dugme kucuk" data-geri>← Bannerlar</button>
        <input data-ad class="bs-ad" maxlength="80" placeholder="Banner adı (yalnız panelde görünür)" aria-label="Banner adı">
      </div>
      <div role="tablist" class="bs-sekmeler" data-sekmeler></div>
      <div data-panel class="bs-panel"></div>
    </div>
    <aside class="bs-onizle">
      <div class="bs-onizle-ust">
        <b>Canlı önizleme</b>
        <div class="bs-segment" role="group" aria-label="Cihaz"><button type="button" data-cihaz="masa" aria-pressed="true">Masaüstü</button><button type="button" data-cihaz="tel" aria-pressed="false">Telefon</button></div>
      </div>
      <div class="bs-cerceve" data-cerceve></div>
      <ul class="bs-kontrol-liste" data-kontrol></ul>
    </aside>
  </div>
  <div class="bs-cubuk">
    <div class="bs-segment bs-durum" role="group" aria-label="Durum" data-durum></div>
    <label class="bs-oncelik">Sıra<input type="number" min="0" max="999" data-oncelik title="Aynı yerde birden çok banner varsa küçük sayı önce gelir"></label>
    <span data-kayit-mesaj role="status" class="bs-mesaj"></span>
    <button type="button" class="dugme" data-vazgec>Vazgeç</button>
    <button type="button" class="dugme ana" data-kaydet>Kaydet</button>
  </div>
</div>

<script>
  import { api, el, tarih, genelHata, prm } from '../../scripts/yonetim/ortak.js';
  import { bannerOlustur, KAPAKLAR, TEMA, zamanUygun } from '../../scripts/banner.js';
  const $ = (s, k = document) => k.querySelector(s);
  const $$ = (s, k = document) => [...k.querySelectorAll(s)];

  const TUR = {
    serit: { ad: 'Duyuru şeridi', alt: 'Sayfanın en üstünde, menünün altında ya da altta ince bir şerit. Kayan, sabit ya da sırayla değişen yazı.', ikon: '<path d="M3 7h18M3 12h12M3 17h8"/>' },
    gorsel: { ad: 'Görsel banner', alt: 'Görselli, başlıklı ve düğmeli kart. Ana sayfa açılışının altında, sayfa başında, sonunda ya da blog yanında.', ikon: '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10" r="1.5"/><path d="M21 15l-5-5L5 19"/>' },
    popup: { ad: 'Açılır pencere', alt: 'Ekranın ortasında açılan pencere. Gecikmeyle, kaydırınca ya da çıkmak üzereyken gösterilir.', ikon: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M15 9l-6 6M9 9l6 6"/>' },
    kose: { ad: 'Köşe kutusu', alt: 'Sağ ya da sol alt köşeden kayarak gelen küçük kart. Sayfayı kapatmadan dikkat çeker.', ikon: '<rect x="3" y="3" width="18" height="18" rx="3"/><rect x="12" y="12" width="7" height="7" rx="1.5"/>' }
  };
  const KONUM = {
    'ust-en': ['Sayfanın en üstü', 'Menünün üstünde, tam genişlik'], 'ust-menu-alti': ['Menünün altı', 'Menü çubuğunun hemen altında'],
    'footer-ustu': ['Alt bilginin üstü', 'Sayfa sonunda, alt bilgiden önce'], 'alt-sabit': ['Ekranın altına sabit', 'Kaydırırken hep görünür'],
    'ana-acilis-alti': ['Ana sayfa açılışının altı', 'Birden çoksa kaydırmalı gösterilir'], 'icerik-basi': ['Sayfa başı', 'İçeriğin üstünde ince kart'],
    'icerik-sonu': ['Sayfa sonu', 'İçerik bitince geniş kart'], 'blog-yan': ['Blog yan sütunu', 'Blog yazılarının sağ sütununda'],
    popup: ['Ekranın ortası', 'Açılır pencere'], 'kose-sag': ['Sağ alt köşe', 'Kayarak gelir'], 'kose-sol': ['Sol alt köşe', 'Kayarak gelir']
  };
  const TUR_KONUM = { serit: ['ust-en', 'ust-menu-alti', 'footer-ustu', 'alt-sabit'], gorsel: ['ana-acilis-alti', 'icerik-basi', 'icerik-sonu', 'blog-yan'], popup: ['popup'], kose: ['kose-sag', 'kose-sol'] };
  const EYLEM = { 'bag': 'Sitede bir sayfaya git', 'yeni-sekme': 'Bağlantıyı yeni sekmede aç', 'talep-analiz': 'Ücretsiz analiz penceresini aç', 'talep-teklif': 'Teklif penceresini aç', 'whatsapp': 'WhatsApp’tan yazışma başlat', 'telefon': 'Telefonla ara', 'kod-kopyala': 'Kampanya kodunu kopyala', 'yok': 'Düğme olmasın' };
  const DURUM = { taslak: 'Taslak', yayinda: 'Yayında', duraklatildi: 'Duraklatıldı' };
  const GUN = ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Paz'];
  const svg = (yol, b = 20) => { const s = document.createElementNS('http://www.w3.org/2000/svg', 'svg'); s.setAttribute('viewBox', '0 0 24 24'); s.setAttribute('width', b); s.setAttribute('height', b); s.setAttribute('fill', 'none'); s.setAttribute('stroke', 'currentColor'); s.setAttribute('stroke-width', '1.8'); s.setAttribute('stroke-linecap', 'round'); s.setAttribute('stroke-linejoin', 'round'); s.setAttribute('aria-hidden', 'true'); s.innerHTML = yol; return s; };
  const yerel = (ms) => new Date(ms + 3 * 3600000).toISOString().slice(0, 16);

  const varsayilan = (tur) => ({
    konum: TUR_KONUM[tur][0], mod: tur === 'serit' ? 'kayan' : 'sabit', hiz: 'normal', ogeler: tur === 'serit' ? [{ metin: '', ikon: '' }] : [],
    etiket: '', baslik: '', metin: '', gorsel: '', gorselAlt: '', kapak: tur === 'serit' ? '' : 'birlesik',
    dugme: { metin: tur === 'serit' ? '' : 'Ücretsiz analiz isteyin', eylem: tur === 'serit' ? 'yok' : 'talep-analiz', hedef: '' }, tumuTiklanir: false,
    kapatilabilir: tur !== 'gorsel', kapatmaSuresi: '7g',
    tasarim: { tema: tur === 'gorsel' ? 'acik' : 'lacivert', arka: '#002559', yazi: '#FFFFFF', vurgu: '#F07A23', hizala: 'orta', boyut: 'normal', ikon: '', geriSayim: false, golge: true },
    hedef: { sayfalar: 'tum', liste: '', cihaz: 'hepsi', ziyaretci: 'hepsi' },
    zaman: { baslangic: '', bitis: '', gunler: [], saatBas: '', saatBit: '' },
    tetik: { tur: tur === 'popup' ? 'gecikme' : 'gecikme', deger: tur === 'popup' ? 8 : 12, siklik: 'oturum' }
  });
  const birlestir = (h, k) => { const o = structuredClone(h); for (const [a, v] of Object.entries(k || {})) o[a] = v && typeof v === 'object' && !Array.isArray(v) ? { ...h[a], ...v } : v; return o; };
  const SABLON = [
    { ad: 'Kampanya geri sayımı', alt: 'Bitişe kalan süre ve kopyalanabilir indirim kodu', tur: 'serit', ayar: { mod: 'sabit', ogeler: [{ metin: 'Sezon kampanyası: Yeni müşterilere ilk ay yönetim ücretinde indirim', ikon: '⏳' }], dugme: { metin: 'Kodu kopyala', eylem: 'kod-kopyala', hedef: 'IDEXYA10' }, tasarim: { tema: 'degrade', geriSayim: true }, zaman: { bitis: yerel(Date.now() + 7 * 864e5).slice(0, 11) + '23:59' } } },
    { ad: 'Önemli duyuru (kapatılamaz)', alt: 'Bakım, tatil ya da çalışma saati değişikliği', tur: 'serit', ayar: { konum: 'ust-en', mod: 'sabit', ogeler: [{ metin: 'Bayram tatili boyunca taleplerinize tatil dönüşü ilk iş günü dönüş yapacağız.', ikon: '📢' }], kapatilabilir: false, tasarim: { tema: 'turuncu' } } },
    { ad: 'Kayan duyuru şeridi', alt: 'Birden çok kısa mesaj sürekli akar', tur: 'serit', ayar: { mod: 'kayan', ogeler: [{ metin: 'Ücretsiz analiz: 1 iş günü içinde dönüyoruz' }, { metin: 'Paket sihirbazıyla size uygun paketi bulun' }, { metin: 'IDOS panelinde bütün reklam verileriniz tek ekranda' }], dugme: { metin: 'Analiz isteyin', eylem: 'talep-analiz' } } },
    { ad: 'Ücretsiz analiz çağrısı', alt: 'Ana sayfa açılışının altında görsel banner', tur: 'gorsel', ayar: { konum: 'ana-acilis-alti', etiket: 'Ücretsiz', baslik: 'Reklam hesabınızı ücretsiz inceleyelim', metin: 'Google Ads, Meta ve ölçüm altyapınızı inceleyip nereden başlamanız gerektiğini gerekçesiyle anlatalım.', kapak: 'birlesik', dugme: { metin: 'Ücretsiz analiz isteyin', eylem: 'talep-analiz' } } },
    { ad: 'Blog yazılarında çağrı', alt: 'Yalnız blog yazılarının yan sütununda', tur: 'gorsel', ayar: { konum: 'blog-yan', etiket: 'Yazıdan sonra', baslik: 'Bunu kendi hesabınızda görelim', metin: 'Hesaplarınızı inceleyip bu konunun sizde nasıl durduğunu anlatalım.', kapak: 'analitik', dugme: { metin: 'Analiz isteyin', eylem: 'talep-analiz' }, hedef: { sayfalar: 'dahil', liste: '/tr/haber/*' } } },
    { ad: 'Çıkmadan önce pencere', alt: 'Masaüstünde sayfadan çıkarken bir kez', tur: 'popup', ayar: { etiket: 'Gitmeden önce', baslik: 'Size uygun paketi dört soruda bulalım', metin: 'Paket sihirbazı ihtiyacınıza uygun paketi ve kademesini önersin.', kapak: 'yonetim', dugme: { metin: 'Sihirbazı başlatın', eylem: 'bag', hedef: '/tr/paketler#sihirbaz' }, tetik: { tur: 'cikis', deger: 0, siklik: 'hafta' }, hedef: { cihaz: 'masaustu' } } },
    { ad: 'WhatsApp köşe kutusu', alt: '15 saniye sonra sağ alttan gelir', tur: 'kose', ayar: { konum: 'kose-sol', etiket: 'Hızlı iletişim', baslik: 'Sorunuz mu var? WhatsApp’tan yazın', metin: 'Hafta içi 09.00–18.00 arasında hemen yanıtlıyoruz.', kapak: 'sosyal', dugme: { metin: 'WhatsApp’tan yazın', eylem: 'whatsapp' }, tetik: { tur: 'gecikme', deger: 15, siklik: 'gun' } } },
    { ad: 'Kaydırınca teklif kutusu', alt: 'Sayfanın yarısı okununca', tur: 'kose', ayar: { etiket: 'Teklif', baslik: 'Bu hizmet için teklif alın', metin: 'Kapsam ve fiyatı yazılı iletelim.', kapak: 'magaza', dugme: { metin: 'Teklif isteyin', eylem: 'talep-teklif' }, tetik: { tur: 'kaydirma', deger: 50, siklik: 'oturum' }, hedef: { sayfalar: 'dahil', liste: '/tr/hizmet/*, /tr/paketler/*' } } }
  ];

  let tum = [], suzTur = '', suzKonum = '', taslak = null, sekme = 'icerik', cihaz = 'masa', degisti = false;

  const goster = (g) => { $$('[data-gorunum]').forEach((x) => (x.hidden = x.dataset.gorunum !== g)); scrollTo({ top: 0 }); };
  const durumAdi = (b) => {
    if (b.durum !== 'yayinda') return DURUM[b.durum] || b.durum;
    const s = yerel(Date.now());
    if (b.zaman && b.zaman.bitis && s >= b.zaman.bitis) return 'Süresi doldu';
    if (b.zaman && b.zaman.baslangic && s < b.zaman.baslangic) return 'Zamanlanmış';
    return 'Yayında';
  };
  const durumKodu = (b) => ({ 'Yayında': 'yayinda', 'Zamanlanmış': 'zamanli', 'Taslak': 'taslak', 'Duraklatıldı': 'duraklatildi', 'Süresi doldu': 'bitti' }[durumAdi(b)]);
  const CIP = { yayinda: 'kazanildi', zamanli: 'gorusme', taslak: 'yeni', duraklatildi: 'kaybedildi', bitti: 'kaybedildi' };
  const hedefOzet = (b) => {
    const h = b.hedef || {}; const p = [];
    p.push(h.sayfalar === 'tum' ? 'Bütün sayfalar' : (h.sayfalar === 'dahil' ? 'Yalnız: ' : 'Hariç: ') + String(h.liste || '').split(/[\n,]/).map((x) => x.trim()).filter(Boolean).slice(0, 3).join(', '));
    if (h.cihaz !== 'hepsi') p.push(h.cihaz === 'mobil' ? 'Telefon' : 'Masaüstü');
    if (h.ziyaretci !== 'hepsi') p.push(h.ziyaretci === 'yeni' ? 'İlk kez gelenler' : 'Geri gelenler');
    return p.join(' · ');
  };
  const zamanOzet = (z) => {
    if (!z) return '';
    const t = (v) => v ? tarih(new Date(Date.parse(v + ':00+03:00')).toISOString()) : '';
    const p = [];
    if (z.baslangic || z.bitis) p.push(`${z.baslangic ? t(z.baslangic) : 'Hemen'} → ${z.bitis ? t(z.bitis) : 'süresiz'}`);
    if (z.gunler && z.gunler.length && z.gunler.length < 7) p.push(z.gunler.map((g) => GUN[g - 1]).join(', '));
    if (z.saatBas && z.saatBit) p.push(`${z.saatBas.replace(':', '.')}–${z.saatBit.replace(':', '.')}`);
    return p.join(' · ');
  };

  // ---------- Liste ----------
  function kucukOnizleme(b) {
    const k = el('div', { class: 'bs-mini bs-mini-' + b.tur, 'data-bn-onizleme': '' });
    const ic = bannerOlustur({ ...b, kapatilabilir: false }, true);
    ic.style.position = 'relative'; ic.classList.add('bn-acik');
    k.append(ic); return k;
  }
  function listeCiz() {
    const q = $('[data-ara]').value.trim().toLocaleLowerCase('tr-TR'), ds = $('[data-durum-suz]').value;
    const l = tum.filter((b) => (!suzTur || b.tur === suzTur) && (!suzKonum || b.konum === suzKonum) && (!ds || durumKodu(b) === ds) && (!q || (b.ad + ' ' + (b.baslik || '') + ' ' + (b.ogeler || []).map((o) => o.metin).join(' ')).toLocaleLowerCase('tr-TR').includes(q)));
    $('[data-liste]').replaceChildren(...(l.length ? l.map((b) => {
      const s = b.istatistik, to = s.gosterim ? (s.tiklama / s.gosterim * 100).toFixed(1).replace('.', ',') + '%' : '—';
      const kod = durumKodu(b);
      return el('article', { class: 'kart bs-satir' },
        kucukOnizleme(b),
        el('div', { class: 'bs-bilgi' },
          el('div', { class: 'bs-ust-satir' }, el('strong', {}, b.ad), el('span', { class: 'cip ' + CIP[kod] }, durumAdi(b))),
          el('span', { class: 'bs-alt' }, `${TUR[b.tur].ad} · ${KONUM[b.konum][0]}`),
          el('span', { class: 'bs-alt' }, hedefOzet(b)),
          zamanOzet(b.zaman) ? el('span', { class: 'bs-alt' }, zamanOzet(b.zaman)) : null),
        el('dl', { class: 'bs-ist' }, el('div', {}, el('dt', {}, 'Gösterim'), el('dd', {}, String(s.gosterim))), el('div', {}, el('dt', {}, 'Tıklama'), el('dd', {}, String(s.tiklama))), el('div', {}, el('dt', {}, 'Tıklama oranı'), el('dd', {}, to)), b.kapatilabilir ? el('div', {}, el('dt', {}, 'Kapatma'), el('dd', {}, String(s.kapatma))) : null),
        el('div', { class: 'bs-eylem' },
          el('button', { type: 'button', class: 'dugme kucuk ana', onclick: () => duzenle(b) }, 'Düzenle'),
          el('button', { type: 'button', class: 'dugme kucuk', onclick: () => durumYap(b, b.durum === 'yayinda' ? 'duraklatildi' : 'yayinda') }, b.durum === 'yayinda' ? 'Duraklat' : 'Yayınla'),
          el('button', { type: 'button', class: 'dugme kucuk', onclick: async () => { try { const r = await api(`bannerlar/${b.id}/cogalt`, {}); await yukle(); duzenle(tum.find((x) => x.id === r.id)); } catch (h) { genelHata(h.message); } } }, 'Çoğalt'),
          el('button', { type: 'button', class: 'dugme kucuk', onclick: () => { if (confirm(`“${b.ad}” arşive alınsın mı? Sitede görünmez; istatistikleri saklanır.`)) durumYap(b, 'arsiv'); } }, 'Arşive al')));
    }) : [el('div', { class: 'kart bos' }, tum.length ? 'Bu süzgece uyan banner yok.' : 'Henüz banner yok. “+ Yeni banner” ile ilkini oluşturun.')]));
  }
  async function durumYap(b, durum) { try { await api(`bannerlar/${b.id}/durum`, { durum }); await yukle(); } catch (h) { genelHata(h.message); } }
  function ozetCiz() {
    const say = (k) => tum.filter((b) => durumKodu(b) === k).length;
    const g = tum.reduce((t, b) => t + b.istatistik.gosterim, 0), tk = tum.reduce((t, b) => t + b.istatistik.tiklama, 0);
    $('[data-kpi]').replaceChildren(...[['Yayında', say('yayinda')], ['Zamanlanmış', say('zamanli')], ['Taslak', say('taslak')], ['Gösterim (30 gün)', g.toLocaleString('tr-TR')], ['Tıklama (30 gün)', tk.toLocaleString('tr-TR')], ['Tıklama oranı', g ? (tk / g * 100).toFixed(1).replace('.', ',') + '%' : '—']]
      .map(([a, n]) => el('div', { class: 'kart' }, el('span', {}, a), el('b', {}, String(n)))));
    $('[data-tur-suz]').replaceChildren(...[['', 'Tümü'], ...Object.entries(TUR).map(([k, v]) => [k, v.ad])].map(([k, a]) => el('button', { type: 'button', 'aria-pressed': String(suzTur === k), onclick: () => { suzTur = k; suzKonum = ''; ozetCiz(); listeCiz(); } }, a, el('small', {}, String(k ? tum.filter((b) => b.tur === k).length : tum.length)))));
    // Yerleşim haritası
    const aktif = (k) => tum.filter((b) => b.konum === k && ['yayinda', 'zamanli'].includes(durumKodu(b))).length;
    const alan = (k, cls) => el('button', { type: 'button', class: 'bs-alan ' + cls + (suzKonum === k ? ' secili' : ''), onclick: () => { suzKonum = suzKonum === k ? '' : k; suzTur = ''; ozetCiz(); listeCiz(); } }, el('span', {}, KONUM[k][0]), aktif(k) ? el('b', {}, String(aktif(k))) : null);
    $('[data-harita]').replaceChildren(el('div', { class: 'bs-sayfa' },
      alan('ust-en', 'h-serit'), el('div', { class: 'bs-menu' }, el('i'), el('span'), el('span'), el('span')), alan('ust-menu-alti', 'h-serit'),
      el('div', { class: 'bs-acilis' }, el('span'), el('span'), el('span', { class: 'kisa' })), alan('ana-acilis-alti', 'h-kart'),
      alan('icerik-basi', 'h-ince'), el('div', { class: 'bs-icerik' }, el('div', {}, el('span'), el('span'), el('span'), el('span', { class: 'kisa' })), alan('blog-yan', 'h-yan')),
      alan('icerik-sonu', 'h-kart'), alan('footer-ustu', 'h-serit'), el('div', { class: 'bs-footer' }), alan('alt-sabit', 'h-serit h-alt'),
      alan('popup', 'h-popup'), alan('kose-sol', 'h-kose h-sol'), alan('kose-sag', 'h-kose h-sag')));
  }
  async function yukle() {
    try { const r = await api('bannerlar'); tum = r.bannerlar; ozetCiz(); listeCiz(); genelHata(''); }
    catch (h) { genelHata('Bannerlar yüklenemedi: ' + h.message); }
  }

  // ---------- Tür ve şablon seçimi ----------
  function secimCiz() {
