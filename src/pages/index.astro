// Tasarım verisi derleme anında üretilir (tools/dc2astro.py).
class DCLogic { constructor(p) { this.props = p || {}; this.state = {}; } setState() {} }
class Component extends DCLogic {
  constructor(props) {
    super(props);
    this.state = { koyu: null, cerez: null, detay: false, analitik: false, pazarlama: false };
  }
  renderVals() {
    const koyu = this.state.koyu === null ? (this.props.koyu ?? false) : this.state.koyu;
    const self = this;
    const turler = [['zorunlu', 'Zorunlu', 'Site ve güvenlik için gerekli; kapatılamaz.'], ['analitik', 'Analitik', 'Ziyaretleri ölçmemize yardım eder (Google Analytics).'], ['pazarlama', 'Pazarlama', 'Reklamları ölçer ve size uygun gösterir (Google, Meta).']];
    const cerezTurleri = turler.map(function (t) { const a = t[0] === 'zorunlu' ? true : !!self.state[t[0]];
      return { ad: t[1], aciklama: t[2], acik: a, degistir: function () { if (t[0] === 'zorunlu') return; const y = {}; y[t[0]] = !a; self.setState(y); },
        anahtarStil: 'width: 44px; height: 26px; flex: none; border-radius: 999px; padding: 4px; box-sizing: border-box; display: flex; justify-content: ' + (a ? 'flex-end' : 'flex-start') + '; background: ' + (a ? 'var(--fill)' : 'var(--line)') + (t[0] === 'zorunlu' ? '; opacity: .6' : '') }; });
    return {
      cerezGoster: this.state.cerez === null, cerezDetay: this.state.detay, cerezTurleri: cerezTurleri,
      cerezDetayAc: () => this.setState({ detay: !this.state.detay }), cerezDetayMetin: this.state.detay ? 'Gizle' : 'Tercihler',
      cerezReddet: () => this.setState({ cerez: 'red', analitik: false, pazarlama: false }),
      cerezKabul: () => this.setState(this.state.detay ? { cerez: 'secim' } : { cerez: 'kabul', analitik: true, pazarlama: true }), cerezKabulMetin: this.state.detay ? 'Seçimi kaydet' : 'Tümünü kabul et',
      temaSinifi: koyu ? 'koyu' : 'acik',
      temaEtiketi: koyu ? 'Açık temaya geç' : 'Koyu temaya geç',
      temaDegistir: () => this.setState({ koyu: !koyu }),
      referansGoster: this.props.referansGoster ?? true,
      instagramKutulari: [1, 2, 3, 4, 5, 6].map(function (n) { return { etiket: 'Paylaşım ' + n }; }),
      markaListesi: String(this.props.markalar ?? '').split(',').map(function (s) { return s.trim(); }).filter(function (s) { return s.length > 0; }).map(function (s) { return { ad: s }; })
    };
  }
}
const __c = new Component({"referansGoster":false}); Object.assign(__c.state, {});
const __v = __c.renderVals();
const __slug = (t) => String(t).toLocaleLowerCase('tr-TR').replace(/ç/g, 'c').replace(/ğ/g, 'g').replace(/ı/g, 'i').replace(/ö/g, 'o').replace(/ş/g, 's').replace(/ü/g, 'u').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const __suz = (anahtar, degerler, liste) => degerler.map((d, i) => { const al = (x) => { const c = new Component({}); c.state[anahtar] = x; return c.renderVals()[liste][i].stil; }; return { deger: d, sec: al(d), nor: al(degerler.find((x) => x !== d)) }; });
const instagramKutulari = __v.instagramKutulari;
const markaListesi = referanslar.filter((r) => r.ad);
const referansGoster = markaListesi.length > 0;
