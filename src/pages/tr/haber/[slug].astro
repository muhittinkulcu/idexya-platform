---
// Eski siteden gelen yazı adresleri korunur; metinler src/data/yazilar.json'dan gelir (govde: [tür, metin] blokları).
import Site from '../../../layouts/Site.astro';
import CagriKutusu from '../../../components/CagriKutusu.astro';
import YAZILAR from '../../../data/yazilar.json';
export function getStaticPaths() {
  return YAZILAR.map((y) => ({ params: { slug: y.slug } }));
}
const y = YAZILAR.find((x) => x.slug === Astro.params.slug);
const kelime = y.govde.flatMap(([, m]) => (Array.isArray(m) ? m : [m])).join(' ').split(/\s+/).length;
const dakika = Math.max(1, Math.round(kelime / 200));
---
<Site baslik={y.baslik} aciklama={y.ozet} aktif="Blog">
<article style="max-width: 820px; margin: 0 auto; padding: 36px 24px 64px; display: flex; flex-direction: column; gap: 18px">
<nav aria-label="Sayfa yolu" style="font-size: 14px; color: var(--tx2); display: flex; gap: 8px; align-items: center; flex-wrap: wrap"><a href="/" style="color: var(--tx2); text-decoration: none; padding: 6px 0">Ana sayfa</a><span aria-hidden="true">›</span><a href="/tr/haberler" style="color: var(--tx2); text-decoration: none; padding: 6px 0">Blog</a></nav>
<span style="font-size: 14px; font-weight: 600; letter-spacing: 0.06em; color: var(--acc)">{y.kategori.toLocaleUpperCase('tr-TR')} · {dakika} dk okuma</span>
<h1 style="margin: 0; font-size: clamp(32px, 6vw, 46px); line-height: 1.1; letter-spacing: -0.02em; color: var(--head)">{y.baslik}</h1>
<p style="margin: 0; font-size: 20px; line-height: 1.6; color: var(--tx2)">{y.ozet}</p>
{y.govde.map(([tur, m]) =>
  tur === 'h2' ? <h2 style="margin: 18px 0 0; font-size: 26px; line-height: 1.25; color: var(--head)">{m}</h2>
  : tur === 'ul' ? <ul style="margin: 0; padding-left: 22px; display: flex; flex-direction: column; gap: 8px; font-size: 18px; line-height: 1.7">{m.map((x) => <li>{x}</li>)}</ul>
  : <p style="margin: 0; font-size: 18px; line-height: 1.75; text-align: justify">{m}</p>
)}
</article>
<CagriKutusu />
</Site>
