---
import Site from '../../../layouts/Site.astro';
// Tasarım verisi derleme anında üretilir (tools/dc2astro.py).
class DCLogic { constructor(p) { this.props = p || {}; this.state = {}; } setState() {} }
class Component extends DCLogic {
  constructor(props) {
    super(props);
    this.state = { koyu: null };
  }
  renderVals() {
    const koyu = this.state.koyu === null ? (this.props.koyu ?? false) : this.state.koyu;
    return {
      temaSinifi: koyu ? 'koyu' : 'acik',
      temaEtiketi: koyu ? 'Açık temaya geç' : 'Koyu temaya geç',
      temaDegistir: () => this.setState({ koyu: !koyu }),
      basliklar: ['Dönüşümler doğru sayılıyor mu?', 'Sonuç türleri ayrı mı?', 'Ürün akışı temiz mi?', 'Açılış sayfası hızlı mı?', 'Yeniden pazarlama kitlesi dolu mu?', 'Kreatifler yorgun mu?', 'Hedef maliyet belli mi?']
    };
  }
}
const __c = new Component({}); Object.assign(__c.state, {});
const __v = __c.renderVals();
const __slug = (t) => String(t).toLocaleLowerCase('tr-TR').replace(/ç/g, 'c').replace(/ğ/g, 'g').replace(/ı/g, 'i').replace(/ö/g, 'o').replace(/ş/g, 's').replace(/ü/g, 'u').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const __suz = (anahtar, degerler, liste) => degerler.map((d, i) => { const al = (x) => { const c = new Component({}); c.state[anahtar] = x; return c.renderVals()[liste][i].stil; }; return { deger: d, sec: al(d), nor: al(degerler.find((x) => x !== d)) }; });
const basliklar = __v.basliklar;
---
<Site baslik="Blog yazısı şablonu" aciklama="" aktif="Blog">


<article>
<header style="max-width: 820px; margin: 0 auto; padding: 36px 24px 32px; box-sizing: border-box; display: flex; flex-direction: column; gap: 18px">
<nav aria-label="Sayfa yolu" style="font-size: 14px; color: var(--tx2); display: flex; gap: 8px; align-items: center; flex-wrap: wrap"><a href="/" style="color: var(--tx2); text-decoration: none; padding: 6px 0">Ana sayfa</a><span aria-hidden="true">›</span><a href="/tr/haberler" style="color: var(--tx2); text-decoration: none; padding: 6px 0">Blog</a><span aria-hidden="true">›</span><span aria-current="page" style="color: var(--head); font-weight: 600">Ölçüm</span></nav>
<span style="font-size: 14px; font-weight: 600; letter-spacing: 0.06em; color: var(--acc)">ÖLÇÜM · 8 DK OKUMA</span>
<h1 style="margin: 0; font-size: 46px; line-height: 1.1; letter-spacing: -0.02em; color: var(--head)">Reklam bütçesini artırmadan önce kontrol etmeniz gereken 7 şey</h1>
<div style="display: flex; align-items: center; gap: 12px"><span style="width: 44px; height: 44px; border-radius: 50%; background: #002559; color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-weight: 700">MK</span><span style="display: flex; flex-direction: column; font-size: 14px"><b style="color: var(--head)">Muhittin Külcü</b><span style="color: var(--tx2)">[Yayın tarihi] · Son güncelleme [tarih]</span></span></div>
</header>
<div aria-hidden="true" style="max-width: 1100px; margin: 0 auto 40px; height: 380px; border-radius: 28px; background: #002559; position: relative; overflow: hidden"><svg viewBox="0 0 1100 380" preserveAspectRatio="xMidYMid slice" style="position: absolute; inset: 0; width: 100%; height: 100%"><path d="M80 300 L300 230 L480 250 L700 150 L1000 90" fill="none" stroke="#F07A23" stroke-width="6" stroke-linecap="round"></path><circle cx="1000" cy="90" r="12" fill="#F07A23"></circle></svg></div>
<div style="max-width: 1100px; margin: 0 auto; padding: 0 24px 80px; box-sizing: border-box; display: flex; gap: 48px; flex-wrap: wrap; align-items: flex-start">
<aside aria-label="İçindekiler" style="flex: 0 1 240px; min-width: 200px; position: sticky; top: 20px; display: flex; flex-direction: column; gap: 8px; font-size: 14px"><b style="color: var(--head)">İçindekiler</b>{(basliklar || []).map((b) => (<Fragment><a href="#" style="color: var(--tx2); text-decoration: none; padding: 4px 0; border-left: 2px solid var(--line); padding-left: 12px">{b}</a></Fragment>))}</aside>
<div style="flex: 1 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 20px; font-size: 18px; line-height: 1.75">
<p style="margin: 0; font-size: 20px; color: var(--head)">[Giriş paragrafı: yazının ana fikri tek cümlede.] Bu sayfa blog yazısı şablonudur; başlıklar, alıntı, kontrol listesi ve yazı sonu çağrısı her yazıda aynı yapıyla görünür.</p>
<h2 style="margin: 12px 0 0; font-size: 28px; line-height: 1.25; color: var(--head)">1. Dönüşümler doğru sayılıyor mu?</h2>
<p style="margin: 0">[Paragraf metni.]</p>
<blockquote style="margin: 0; padding: 20px 24px; border-left: 4px solid var(--brand); background: var(--card); border-radius: 0 16px 16px 0; font-size: 19px; color: var(--head)">“Bağlı görünmesi, verinin doğru geldiği anlamına gelmez.”</blockquote>
<h2 style="margin: 12px 0 0; font-size: 28px; line-height: 1.25; color: var(--head)">2. Sonuç türleri ayrı mı?</h2>
<p style="margin: 0">[Paragraf metni.]</p>
<div style="padding: 22px 24px; border-radius: 18px; background: var(--card); border: 1px solid var(--line); display: flex; flex-direction: column; gap: 10px; font-size: 16px"><b style="color: var(--head)">Kontrol listesi</b><span>☐ [Madde]</span><span>☐ [Madde]</span><span>☐ [Madde]</span></div>
<div style="margin-top: 20px; padding: 32px; border-radius: 24px; background: #002559; color: #C6D2E3; display: flex; flex-direction: column; gap: 12px"><strong style="font-size: 24px; color: #FFFFFF">Hesabınızı birlikte kontrol edelim</strong><span style="font-size: 16px">Bu yedi maddeyi reklam hesabınızda ücretsiz inceleyip size tek sayfalık bir rapor gönderelim.</span><a href="/tr/iletisim" style="align-self: flex-start; min-height: 50px; display: flex; align-items: center; padding: 0 22px; border-radius: 12px; background: #F07A23; color: #1A1206; text-decoration: none; font-weight: 700; font-size: 16px">Ücretsiz analiz iste</a></div>
<div style="display: flex; flex-direction: column; gap: 12px; padding-top: 12px"><b style="color: var(--head); font-size: 18px">İlgili yazılar</b><a href="/tr/haber/ornek-yazi" style="font-size: 17px; font-weight: 600; text-decoration: none">Dönüşüm API (CAPI) kurulu mu, çalışıyor mu? →</a><a href="/tr/haber/ornek-yazi" style="font-size: 17px; font-weight: 600; text-decoration: none">Meta reklamlarında “sonuç” neden yanıltır? →</a></div>
</div>
</div>
</article>




</Site>
