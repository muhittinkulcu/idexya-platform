---
// Blog listesi: yalnız gerçek yazılar (src/data/yazilar.json). Tasarım dosyasındaki örnek yazılar, öne çıkan kart ve
// henüz bağlı olmayan e-posta aboneliği yayında gösterilmez (Muhittin, 22 Eki 2026); bu sayfa tools/donustur.sh ile üretilmez.
import Site from '../../layouts/Site.astro';
import YAZILAR from '../../data/yazilar.json';
const ZEMIN = { 'Reklam': 'linear-gradient(135deg, #F07A23, #B84406)', 'E-ticaret': 'linear-gradient(135deg, #1F4E8C, #002559)', 'Ölçüm': 'linear-gradient(135deg, #2F7D5B, #174B36)', 'SEO': 'linear-gradient(135deg, #6B5BA8, #3C3170)' };
---
<Site baslik="Blog" aciklama="Reklam, e-ticaret ve ölçüm üzerine notlar." aktif="Blog">

<section style="position: relative">
<svg aria-hidden="true" viewBox="0 0 1440 420" preserveAspectRatio="none" style="position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0"><path d="M820 0 C 1000 110 1120 50 1440 120 L1440 0 Z" fill="var(--blob2)"></path></svg>
<div style="position: relative; z-index: 1; max-width: 1240px; margin: 0 auto; padding: 36px 24px 40px; box-sizing: border-box; display: flex; flex-direction: column; gap: 22px">
<nav aria-label="Sayfa yolu" style="font-size: 14px; color: var(--tx2); display: flex; gap: 8px; align-items: center"><a href="/" style="color: var(--tx2); text-decoration: none; padding: 6px 0">Ana sayfa</a><span aria-hidden="true">›</span><span aria-current="page" style="color: var(--head); font-weight: 600">Blog</span></nav>
<div style="display: flex; align-items: center; gap: 12px"><span style="width: 36px; height: 2px; background: var(--brand)"></span><span style="font-size: 14px; font-weight: 600; letter-spacing: 0.06em; color: var(--acc)">BLOG</span></div>
<h1 style="margin: 0; font-size: clamp(36px, 7vw, 58px); line-height: 1.06; letter-spacing: -0.03em; color: var(--head); max-width: 860px">Reklam, e-ticaret ve ölçüm üzerine notlar</h1>
</div>
</section>

<section style="padding: 0 24px 88px">
<div style="max-width: 1192px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 18px">
{YAZILAR.map((y) => (
<a href={`/tr/haber/${y.slug}`} style="display: flex; flex-direction: column; border-radius: 20px; overflow: hidden; background: var(--card); border: 1px solid var(--line); text-decoration: none; color: var(--tx)">
<div aria-hidden="true" style={`height: 170px; background: ${ZEMIN[y.kategori] || ZEMIN['Reklam']}; position: relative`}><span style="position: absolute; left: 18px; bottom: 14px; padding: 4px 10px; border-radius: 999px; background: rgba(255,255,255,.92); color: #002559; font-size: 12px; font-weight: 700">{y.kategori}</span></div>
<div style="padding: 20px 22px 24px; display: flex; flex-direction: column; gap: 10px; flex: 1">
<h2 style="margin: 0; font-size: 20px; line-height: 1.3; color: var(--head)">{y.baslik}</h2>
<span style="margin-top: auto; font-weight: 600; color: var(--acc)">Yazıyı oku →</span>
</div>
</a>
))}
</div>
</section>

</Site>
