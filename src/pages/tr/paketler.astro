const soruGoster = __v.soruGoster;
const __sz0 = __suz('filtre', ["tumu", "reklam", "birlesik", "web", "eticaret", "pazaryeri", "seo", "icerik"], 'filtreler');
---
<Site baslik="Paketler" aciklama="Google Ads, Meta, SEO, e-ticaret ve web sitesi paketleri; size uygun paketi birkaç soruda bulun." aktif="Paketler">


<section style="position: relative">
<svg aria-hidden="true" viewBox="0 0 1440 900" preserveAspectRatio="none" style="position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0"><path d="M820 0 C 1000 110 1120 50 1440 120 L1440 0 Z" fill="var(--blob2)"></path><path d="M1000 900 C 960 640 1100 420 1440 380 L1440 900 Z" fill="var(--blob)"></path></svg>
<div style="position: relative; z-index: 1; max-width: 1240px; margin: 0 auto; padding: 36px 24px 64px; box-sizing: border-box; display: flex; flex-wrap: wrap; gap: 40px 56px; align-items: flex-start">
<div style="flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 24px">
<nav aria-label="Sayfa yolu" style="font-size: 14px; color: var(--tx2); display: flex; gap: 8px; align-items: center"><a href="/" style="color: var(--tx2); text-decoration: none; padding: 6px 0">Ana sayfa</a><span aria-hidden="true">›</span><span aria-current="page" style="color: var(--head); font-weight: 600">Paketler</span></nav>
<div style="display: flex; align-items: center; gap: 12px"><span style="width: 36px; height: 2px; background: var(--brand)"></span><span style="font-size: 14px; font-weight: 600; letter-spacing: 0.06em; color: var(--acc)">PAKETLER</span></div>
<h1 style="margin: 0; font-size: 56px; line-height: 1.06; letter-spacing: -0.03em; color: var(--head)">Size uygun paketi birlikte bulalım</h1>
<p style="margin: 0; font-size: 19px; color: var(--tx2)">Dört kısa soruyu cevaplayın, size en uygun paketi önerelim. Ya da aşağıdan tüm paketleri inceleyin.</p>
<ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; color: var(--tx2); font-size: 15px">
<li style="display: flex; gap: 10px; align-items: center"><span style="width: 8px; height: 8px; border-radius: 50%; background: var(--brand)"></span>Tek hizmet ya da birleşik paket</li>
<li style="display: flex; gap: 10px; align-items: center"><span style="width: 8px; height: 8px; border-radius: 50%; background: var(--brand)"></span>Reklam bütçesi paket ücretine dahil değildir</li>
<li style="display: flex; gap: 10px; align-items: center"><span style="width: 8px; height: 8px; border-radius: 50%; background: var(--brand)"></span>Fiyat ücretsiz analizden sonra netleşir</li>
</ul>
</div>

<div id="sihirbaz" style="flex: 1 1 520px; min-width: 0; background: var(--card); border: 1px solid var(--line); border-radius: 26px; box-shadow: 0 30px 70px var(--shadow); padding: 30px; box-sizing: border-box; display: flex; flex-direction: column; gap: 20px">
<div style="display: flex; justify-content: space-between; align-items: center; gap: 12px">
<span style="font-size: 13px; font-weight: 600; letter-spacing: 0.06em; color: var(--acc)">PAKET ÖNERİ SİHİRBAZI</span>
<span style="font-size: 14px; color: var(--tx2)">{ilerlemeYazi}</span>
</div>
<div style="height: 6px; border-radius: 6px; background: var(--card2)"><div style={`height: 6px; border-radius: 6px; background: var(--brand); width: ${ilerlemeYuzde}`}></div></div>
{(soruGoster) && (<Fragment>
<div style="display: flex; flex-direction: column; gap: 16px">
<h2 style="margin: 0; font-size: 26px; line-height: 1.25; color: var(--head)">{soru.baslik}</h2>
<div role="group" aria-label={String(soru.baslik)} style="display: flex; flex-direction: column; gap: 10px">
{(soru.secenekler || []).map((s) => (<Fragment>
<button type="button" aria-pressed={String(s.secili)} style={s.stil}><span style="display: flex; flex-direction: column; gap: 2px; text-align: left"><span style="font-weight: 600">{s.ad}</span><span style="font-size: 14px; color: var(--tx2); font-weight: 400">{s.aciklama}</span></span><span aria-hidden="true" style="color: var(--acc); font-size: 20px">→</span></button>
</Fragment>))}
</div>
{(geriVar) && (<Fragment><button type="button" style="align-self: flex-start; min-height: 44px; padding: 0 4px; border: 0; background: transparent; color: var(--tx2); font: inherit; font-size: 15px; cursor: pointer">← Geri</button></Fragment>)}
</div>
</Fragment>)}
{(sonucGoster) && (<Fragment>
<div style="display: flex; flex-direction: column; gap: 16px">
<span style="font-size: 14px; color: var(--tx2)">Size önerimiz</span>
<div style="padding: 22px; border-radius: 18px; border: 2px solid var(--brand); display: flex; flex-direction: column; gap: 10px">
<span style="font-size: 26px; font-weight: 700; line-height: 1.2; color: var(--head)">{oneri.ad}</span>
<span style="color: var(--tx2)">{oneri.neden}</span>
<ul style="margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 6px; font-size: 15px">
{(oneri.maddeler || []).map((m) => (<Fragment><li>{m}</li></Fragment>))}
</ul>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 10px">
<a href="#teklif" style="min-height: 50px; display: flex; align-items: center; padding: 0 22px; border-radius: 12px; background: var(--fill); color: #FFFFFF; text-decoration: none; font-weight: 600">Bu paketle teklif iste</a>
<a href={`#${oneri.hedef}`} style="min-height: 50px; display: flex; align-items: center; padding: 0 18px; border-radius: 12px; border: 1px solid var(--line); color: var(--head); text-decoration: none; font-weight: 600">Paketi incele</a>
<button type="button" style="min-height: 50px; padding: 0 14px; border: 0; background: transparent; color: var(--tx2); font: inherit; cursor: pointer">Baştan başla</button>
</div>
</div>
</Fragment>)}
</div>
</div>
</section>

<section style="position: sticky; top: 0; z-index: 3; background: var(--bg); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line)">
<div role="group" aria-label="Paket türü" style="max-width: 1240px; margin: 0 auto; padding: 14px 24px; box-sizing: border-box; display: flex; flex-wrap: wrap; gap: 8px">
{(filtreler || []).map((f, __i) => (<Fragment>
<button data-grup="paket" data-deger={__sz0[__i].deger} data-sec-stil={__sz0[__i].sec} data-normal-stil={__sz0[__i].nor} type="button" aria-pressed={String(f.secili)} style={f.stil}>{f.ad}</button>
</Fragment>))}
</div>
</section>

<section style="max-width: 1240px; margin: 0 auto; padding: 36px 24px 88px; box-sizing: border-box; display: flex; flex-direction: column; gap: 28px">
{(gorunenGruplar || []).map((g) => (<Fragment>
<article data-grup-icerik="paket" data-etiket={g.tur} id={g.id} style={g.kutuStil}>
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 12px 32px; padding-bottom: 22px; border-bottom: 1px solid var(--line)">
<div style="display: flex; flex-direction: column; gap: 8px; max-width: 700px">
<span style="font-size: 13px; font-weight: 600; letter-spacing: 0.06em; color: var(--acc)">{g.turEtiket}</span>
<h2 style="margin: 0; font-size: 32px; line-height: 1.15; letter-spacing: -0.02em; color: var(--head)">{g.ad}</h2>
<p style="margin: 0; color: var(--tx2)">{g.ozet}</p>
</div>
<span style="font-size: 14px; color: var(--tx2)">{g.ucretNotu}</span>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 16px; align-items: stretch">
{(g.kademeler || []).map((k) => (<Fragment>
<div style={k.kutuStil}>
<div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px"><h3 style="margin: 0; font-size: 21px; color: var(--head)">{k.ad}</h3>{(k.rozet) && (<Fragment><span style="padding: 3px 10px; border-radius: 999px; background: var(--tint); color: var(--tintx); font-size: 12px; font-weight: 600">{k.rozet}</span></Fragment>)}</div>
<p style="margin: 0; font-size: 14px; color: var(--tx2)">{k.kimIcin}</p>
<ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 9px">
{(k.maddeler || []).map((m) => (<Fragment>
<li style="display: flex; gap: 10px; align-items: flex-start; font-size: 15px"><span style="flex: none; width: 20px; height: 20px; margin-top: 2px; border-radius: 50%; background: var(--okb); color: var(--ok); display: flex; align-items: center; justify-content: center"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg></span><span>{m}</span></li>
</Fragment>))}
</ul>
<a href="#teklif" data-paket={g.birlesik ? k.ad : g.ad + ' · ' + k.ad} style={k.dugmeStil}>Teklif al</a>
</div>
</Fragment>))}
</div>
</article>
</Fragment>))}
</section>

<section id="teklif" style="padding: 0 24px 88px">
<div style="max-width: 1192px; margin: 0 auto; box-sizing: border-box; background: var(--card); border: 1px solid var(--line); border-radius: 28px; box-shadow: 0 30px 80px var(--shadow); overflow: hidden; display: flex; flex-wrap: wrap">
<div style="flex: 1 1 380px; min-width: 0; background: #002559; color: #F1F3F5; padding: 48px; box-sizing: border-box; display: flex; flex-direction: column; gap: 18px; position: relative; overflow: hidden">
<svg aria-hidden="true" viewBox="0 0 400 400" style="position: absolute; right: -80px; bottom: -80px; width: 300px; height: 300px"><circle cx="200" cy="200" r="190" fill="none" stroke="#F07A23" stroke-width="1.5" opacity="0.5"></circle><circle cx="200" cy="200" r="130" fill="none" stroke="#F07A23" stroke-width="1.5" opacity="0.3"></circle></svg>
<span style="font-size: 13px; font-weight: 600; letter-spacing: 0.06em; color: #FFB58A">TEKLİF İSTE</span>
<h2 style="margin: 0; font-size: 36px; line-height: 1.12; color: #FFFFFF">Size özel teklif hazırlayalım</h2>
<div style="position: relative; padding: 18px; border-radius: 14px; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.16); display: flex; flex-direction: column; gap: 4px">
<span style="font-size: 13px; color: #C6D2E3">Seçilen paket</span>
<span style="font-size: 20px; font-weight: 700; color: #FFFFFF" id="secili-paket" aria-live="polite">{seciliPaketAdi}</span>
</div>
<p style="margin: 0; color: #C6D2E3; font-size: 16px; position: relative">Formu gönderdikten sonra size dönüş yaparız. [Dönüş süresi doğrulanacak]</p>
</div>
<form style="flex: 1 1 520px; min-width: 0; padding: 44px; box-sizing: border-box; display: flex; flex-wrap: wrap; gap: 18px; align-content: flex-start">
<label style="flex: 1 1 220px; display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 600; color: var(--head)">Ad soyad<input type="text" name="ad" autocomplete="name" style="min-height: 48px; padding: 0 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--tx); font: inherit; font-size: 16px; font-weight: 400"></label>
<label style="flex: 1 1 220px; display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 600; color: var(--head)">Firma adı<input type="text" name="firma" autocomplete="organization" style="min-height: 48px; padding: 0 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--tx); font: inherit; font-size: 16px; font-weight: 400"></label>
<label style="flex: 1 1 220px; display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 600; color: var(--head)">E-posta<input type="email" name="eposta" autocomplete="email" style="min-height: 48px; padding: 0 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--tx); font: inherit; font-size: 16px; font-weight: 400"></label>
<label style="flex: 1 1 220px; display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 600; color: var(--head)">Telefon<input type="tel" name="telefon" autocomplete="tel" style="min-height: 48px; padding: 0 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--tx); font: inherit; font-size: 16px; font-weight: 400"></label>
<label style="flex: 1 1 100%; display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 600; color: var(--head)">Web siteniz veya mağaza bağlantınız<input type="url" name="site" placeholder="https://" style="min-height: 48px; padding: 0 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--tx); font: inherit; font-size: 16px; font-weight: 400"></label>
<label style="flex: 1 1 100%; display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 600; color: var(--head)">Eklemek istedikleriniz<textarea name="not" rows="3" style="padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--tx); font: inherit; font-size: 16px; font-weight: 400; resize: vertical"></textarea></label>
<label style="flex: 1 1 100%; display: flex; gap: 10px; align-items: flex-start; font-size: 14px; color: var(--tx2)"><input type="checkbox" name="kvkk" style="width: 20px; height: 20px; margin: 1px 0 0; flex: none"><span><a href="#teklif">KVKK aydınlatma metnini</a> okudum, iletişim için bilgilerimin işlenmesini kabul ediyorum.</span></label>
<button type="submit" style="flex: 1 1 100%; min-height: 54px; border: 0; border-radius: 12px; background: var(--fill); color: #FFFFFF; font: inherit; font-size: 17px; font-weight: 600; cursor: pointer">Teklif iste</button>
</form>
</div>
</section>

<section style="max-width: 1240px; margin: 0 auto; padding: 0 24px 96px; box-sizing: border-box; display: flex; flex-wrap: wrap; gap: 48px">
<div style="flex: 1 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 14px">
<div style="display: flex; align-items: center; gap: 12px"><span style="width: 36px; height: 2px; background: var(--brand)"></span><span style="font-size: 14px; font-weight: 600; letter-spacing: 0.06em; color: var(--acc)">SIK SORULAN SORULAR</span></div>
<h2 style="margin: 0; font-size: 38px; line-height: 1.12; letter-spacing: -0.025em; color: var(--head)">Paketler hakkında</h2>
</div>
<div style="flex: 2 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 12px">
<details style="background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 0 22px"><summary style="min-height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 12px; cursor: pointer; font-weight: 600; color: var(--head); list-style: none">Reklam bütçesi pakete dahil mi?<span aria-hidden="true" style="color: var(--acc); font-size: 22px">+</span></summary><p style="margin: 0 0 20px; color: var(--tx2)">Hayır. Paket ücreti yönetim hizmetini kapsar. Reklam bütçesini Google, Meta veya pazaryerine doğrudan kendi hesabınızdan ödersiniz; böylece harcamanın tamamını kendi faturalarınızda görürsünüz.</p></details>
<details style="background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 0 22px"><summary style="min-height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 12px; cursor: pointer; font-weight: 600; color: var(--head); list-style: none">Tek paket mi, birleşik paket mi almalıyım?<span aria-hidden="true" style="color: var(--acc); font-size: 22px">+</span></summary><p style="margin: 0 0 20px; color: var(--tx2)">Tek kanaldan sonuç bekliyorsanız tek paket yeterli. Birden fazla kanal birlikte çalışacaksa birleşik paket tek bütçe planı ve tek raporla daha verimli olur. Sihirbaz bu kararı sizin için kolaylaştırır.</p></details>
<details style="background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 0 22px"><summary style="min-height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 12px; cursor: pointer; font-weight: 600; color: var(--head); list-style: none">Sözleşme süresi var mı?<span aria-hidden="true" style="color: var(--acc); font-size: 22px">+</span></summary><p style="margin: 0 0 20px; color: var(--tx2)">Aylık çalışıyoruz. Reklamların öğrenme süresi nedeniyle en az [X ay] ile başlamayı öneriyoruz.</p></details>
<details style="background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 0 22px"><summary style="min-height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 12px; cursor: pointer; font-weight: 600; color: var(--head); list-style: none">Paketimi sonradan değiştirebilir miyim?<span aria-hidden="true" style="color: var(--acc); font-size: 22px">+</span></summary><p style="margin: 0 0 20px; color: var(--tx2)">Evet. İhtiyacınız değiştiğinde bir sonraki dönemden itibaren üst veya alt kademeye, ya da birleşik pakete geçebilirsiniz.</p></details>
</div>
</section>




<script>
  import { sihirbazBaslat } from '../../scripts/sihirbaz.js';
  sihirbazBaslat();
</script>
</Site>
