---
// Platform ayrıntı sayfası (Muhittin, 28 Eki 2026): ana sayfadaki "Çalıştığımız platformlar" şeridinden açılır.
// İçerik: src/data/platformlar.json. İlgili hizmet ve paketler kendi veri dosyalarından bağlanır; resmî iş ortaklığı iddiası yoktur.
import Site from '../../../layouts/Site.astro';
import CagriKutusu from '../../../components/CagriKutusu.astro';
import KatmanStil from '../../../components/KatmanStil.astro';
import platformlar from '../../../data/platformlar.json';
import gruplar from '../../../data/hizmetler.json';
import paketler from '../../../data/paketler.json';
import yazilar from '../../../data/yazilar.json';
export function getStaticPaths() {
  return platformlar.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const tumHizmet = gruplar.flatMap((g) => g.hizmetler.map((h) => ({ ...h, alan: g.ad })));
const hizmetler = p.hizmetler.map((s) => tumHizmet.find((h) => h.slug === s)).filter(Boolean);
const ilgiliPaket = p.paketler.map((id) => paketler.find((x) => x.id === id)).filter(Boolean);
const ad = p.kisaAd || p.ad;
// İlgili yazılar: aynı kategorideki yazılar; ölçüm platformlarında platform adının geçtiği yazılar.
const ilgiliYazi = yazilar.filter((y) => y.kategori === p.kategori || (p.kategori === 'Ölçüm' && JSON.stringify(y.govde || '').includes(ad))).slice(0, 3);
const digerleri = platformlar.filter((x) => x.slug !== p.slug);
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: p.sss.map((x) => ({ '@type': 'Question', name: x.soru, acceptedAnswer: { '@type': 'Answer', text: x.cevap } })) };
const OK = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>';
---
<Site baslik={`${p.ad} yönetimi ve ölçümü`} aciklama={p.kisa} aktif="Hizmetler">
<section class="pf-ust">
  <div class="pf-ic">
    <nav aria-label="Sayfa yolu" class="pf-yol"><a href="/">Ana sayfa</a><span aria-hidden="true">›</span><a href="/tr/platformlar/">Platformlar</a><span aria-hidden="true">›</span><span aria-current="page">{ad}</span></nav>
    <span class="pf-etiket">{p.kategori}</span>
    <h1>{p.ad}</h1>
    <p class="pf-giris">{p.kisa}</p>
    <div class="pf-eylem"><a href="#analiz" class="pf-ana">Ücretsiz analiz iste</a>{ilgiliPaket[0] && <a href={`/tr/paketler#${ilgiliPaket[0].id}`} class="pf-ikincil">İlgili paketleri incele</a>}</div>
  </div>
</section>
<nav class="pf-sayfa-ici" aria-label="Bu sayfada"><div class="pf-ic"><a href="#nedir">Nedir?</a><a href="#neler">Neler yapıyoruz?</a><a href="#dikkat">Nelere dikkat ediyoruz?</a><a href="#ilgili">İlgili hizmet ve paketler</a><a href="#sss">Sorular</a></div></nav>
<div class="pf-ic pf-govde">
  <section id="nedir" class="pf-bolum pf-iki">
    <div><h2>{ad} nedir?</h2><p class="pf-metin">{p.nedir}</p></div>
    <aside class="pf-kutu"><b>Kısaca</b><ul><li>Hesaplar sizin adınıza açılır.</li><li>Değişiklikler onayınızla yapılır.</li><li>Sonuçlar IDOS panelinde görünür.</li></ul></aside>
  </section>
  <section id="neler" class="pf-bolum">
    <h2>{ad} için neler yapıyoruz?</h2>
    <ol class="pf-liste">{p.yapilanlar.map((x, i) => <li><i>{String(i + 1).padStart(2, '0')}</i><span>{x}</span></li>)}</ol>
  </section>
  <section id="dikkat" class="pf-bolum">
    <h2>Nelere dikkat ediyoruz?</h2>
    <div class="pf-kartlar">{p.dikkat.map((x) => <div class="pf-dikkat">{x}</div>)}</div>
  </section>
  <section id="ilgili" class="pf-bolum">
    <h2>İlgili hizmet ve paketler</h2>
    <div class="pf-kartlar">
      {hizmetler.map((h) => <a href={`/tr/hizmet/${h.slug}`} class="pf-bag"><small>Hizmet · {h.alan}</small><strong>{h.ad}</strong>{h.ozet && <span>{h.ozet}</span>}<em>Hizmeti incele<Fragment set:html={OK} /></em></a>)}
      {ilgiliPaket.map((k) => <a href={`/tr/paketler#${k.id}`} class="pf-bag"><small>Paket</small><strong>{k.ad}</strong><span>{k.ozet}</span><em>Paketi incele<Fragment set:html={OK} /></em></a>)}
      {ilgiliYazi.map((y) => <a href={`/tr/haber/${y.slug}`} class="pf-bag"><small>Yazı · {y.kategori}</small><strong>{y.baslik}</strong><span>{y.ozet}</span><em>Yazıyı oku<Fragment set:html={OK} /></em></a>)}
    </div>
  </section>
  <section id="sss" class="pf-bolum">
    <h2>Sık sorulan sorular</h2>
    <div class="pf-sss">{p.sss.map((x) => <details><summary>{x.soru}</summary><p>{x.cevap}</p></details>)}</div>
  </section>
  <section class="pf-bolum">
    <h2>Diğer platformlar</h2>
    <div class="pf-cipler">{digerleri.map((x) => <a href={`/tr/platformlar/${x.slug}`}>{x.kisaAd || x.ad}</a>)}<a href="/tr/platformlar/">Tümü</a></div>
    <p class="pf-not">Marka adları sahiplerine aittir; listedeki platformlarla resmî iş ortaklığı belirtilmez.</p>
  </section>
</div>
<div id="analiz"><CagriKutusu baslik={`${ad} hesabınızı birlikte inceleyelim`} /></div>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<KatmanStil />
</Site>
