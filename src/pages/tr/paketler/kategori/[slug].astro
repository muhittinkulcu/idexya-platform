---
// Paket kategorisi sayfası: kategori künyesi, paketlerin yan yana karşılaştırması, her paketin kademe basamakları,
// her kademede geçerli kurallar ve başlama adımları, sık sorulan sorular, ilgili hizmet ve platformlar, diğer kategoriler.
import Site from '../../../../layouts/Site.astro';
import CagriKutusu from '../../../../components/CagriKutusu.astro';
import KatmanStil from '../../../../components/KatmanStil.astro';
import PaketStil from '../../../../components/PaketStil.astro';
import PaketSurec from '../../../../components/PaketSurec.astro';
import KapakGorsel from '../../../../components/KapakGorsel.astro';
import paketler from '../../../../data/paketler.json';
import gruplar from '../../../../data/hizmetler.json';
import platformlar from '../../../../data/platformlar.json';
import sss from '../../../../data/sss.json';
import { KATEGORILER, PAKET_BAG, kademeOzet, paketSss } from '../../../../data/paket-kategori.js';
export function getStaticPaths() { return KATEGORILER.map((k) => ({ params: { slug: k.slug }, props: { k } })); }
const { k } = Astro.props;
const liste = k.idler.map((id) => paketler.find((p) => p.id === id)).filter(Boolean);
const tumHizmet = gruplar.flatMap((g) => g.hizmetler.map((h) => ({ ...h, alan: g.ad })));
const hSlug = [...new Set(liste.flatMap((p) => (PAKET_BAG[p.id] || { hizmetler: [] }).hizmetler))];
const hizmetler = hSlug.map((s) => tumHizmet.find((h) => h.slug === s)).filter(Boolean);
const pltBul = (id) => (PAKET_BAG[id] || { platformlar: [] }).platformlar.map((s) => platformlar.find((x) => x.slug === s)).filter(Boolean);
const plt = [...new Set(liste.flatMap((p) => pltBul(p.id)))];
const onerilen = (p) => p.kademeler.find((x) => x.rozet) || p.kademeler[0];
const oneCikan = (p) => { const i = p.kademeler.indexOf(onerilen(p)); return kademeOzet(p, i).maddeler.slice(0, 3); };
const sorular = paketSss(sss, k.idler);
const capa = (x) => 'k-' + x.ad.toLocaleLowerCase('tr-TR').replace(/[^a-z0-9çğıöşü]+/g, '-');
const teklif = (p, x) => `/tr/paketler?paket=${encodeURIComponent(p.birlesik ? x.ad : p.ad + ' · ' + x.ad)}#teklif`;
const kademeSayisi = liste.reduce((t, p) => t + p.kademeler.length, 0);
---
<Site baslik={`${k.ad} paketleri`} aciklama={k.aciklama} aktif="Paketler">
<section class="pd-ust"><div class="pf-ic">
  <nav aria-label="Sayfa yolu" class="pf-yol"><a href="/">Ana sayfa</a><span aria-hidden="true">›</span><a href="/tr/paketler">Paketler</a><span aria-hidden="true">›</span><span aria-current="page">{k.ad}</span></nav>
  <div class="pd-ust-izgara">
    <div class="pd-ust-metin">
      <h1>{k.ad} paketleri</h1>
      <p class="pd-giris">{k.aciklama}</p>
      <div class="pf-eylem">
        {liste.length > 1 ? <a href="#karsilastirma" class="pf-ana">Paketleri karşılaştırın</a> : <a href={`/tr/paketler/${liste[0].id}`} class="pf-ana">Paketi inceleyin</a>}
        <a href="/tr/paketler#sihirbaz" class="pf-ikincil">Paket sihirbazı</a>
      </div>
      <p class="pd-yardim">Bu kategoride {liste.length} paket ve toplam {kademeSayisi} {liste.some((p) => p.birlesik) ? 'kademe ve set' : 'kademe'} var. Fiyat, ücretsiz analizden sonra ihtiyacınıza göre netleşir.</p>
    </div>
    <KapakGorsel tur={`c:${k.slug}`} baslik={`${k.ad} paketleri`} />
  </div>
  <div class="kp-serit" aria-label="Bu kategorideki paketler">
    {liste.map((p) => <a href={`#p-${p.id}`}><small>{p.kademeler.length} {p.birlesik ? 'set' : 'kademe'}</small><strong>{p.ad}</strong><span>{p.ucretNotu}</span></a>)}
  </div>
</div></section>
<nav class="pf-sayfa-ici" aria-label="Bu sayfada"><div class="pf-ic">{liste.length > 1 && <a href="#karsilastirma">Karşılaştırma</a>}{liste.map((p) => <a href={`#p-${p.id}`}>{p.ad}</a>)}<a href="#kurallar">Kurallar ve adımlar</a>{sorular.length > 0 && <a href="#sorular">Sorular</a>}<a href="#ilgili">İlgili hizmetler</a></div></nav>

{liste.length > 1 && (
<section id="karsilastirma" class="pd-bolum"><div class="pf-ic">
  <div class="pd-bas"><h2>Paketler yan yana</h2><p>Her paketin neye odaklandığını, nasıl ücretlendirildiğini ve önerdiğimiz kademede nelerin olduğunu tek tabloda görün.</p></div>
  <div class="pd-tablo-kap" tabindex="0" role="region" aria-label="Paket karşılaştırma tablosu (yatay kaydırılabilir)">
    <table class="pd-tablo pk-tablo">
      <thead><tr><th scope="col"><span class="gizli">Özellik</span></th>{liste.map((p) => <th scope="col"><a href={`/tr/paketler/${p.id}`}>{p.ad}</a></th>)}</tr></thead>
      <tbody>
        <tr><th scope="row">Ne için</th>{liste.map((p) => <td>{p.ozet}</td>)}</tr>
        <tr><th scope="row">Ücretlendirme</th>{liste.map((p) => <td>{p.ucretNotu}</td>)}</tr>
        <tr><th scope="row">Kademeler</th>{liste.map((p) => <td><span class="pk-kademe-adlar">{p.kademeler.map((x) => <a href={`/tr/paketler/${p.id}#${capa(x)}`}>{x.ad}</a>)}</span></td>)}</tr>
        <tr><th scope="row">Önerdiğimiz</th>{liste.map((p) => <td><b>{onerilen(p).ad}</b><span class="pk-alt">{onerilen(p).kimIcin}</span></td>)}</tr>
        <tr><th scope="row">Önerilende öne çıkanlar</th>{liste.map((p) => <td><ul class="pk-tik">{oneCikan(p).map((m) => <li>{m}</li>)}</ul></td>)}</tr>
        <tr><th scope="row">Platformlar</th>{liste.map((p) => <td><span class="pk-kademe-adlar">{pltBul(p.id).map((x) => <a href={`/tr/platformlar/${x.slug}`}>{x.kisaAd || x.ad}</a>)}</span>{pltBul(p.id).length === 0 && '—'}</td>)}</tr>
      </tbody>
      <tfoot><tr><td></td>{liste.map((p) => <td><a href={`/tr/paketler/${p.id}`}>Paketin ayrıntıları</a></td>)}</tr></tfoot>
    </table>
  </div>
</div></section>)}

{liste.map((p, j) => (
<section id={`p-${p.id}`} class={'pd-bolum pk-paket' + (j % 2 === (liste.length > 1 ? 0 : 1) ? ' pd-zemin' : '')}><div class="pf-ic">
  <div class="pk-paket-bas">
    <div>
      <h2>{p.ad}</h2>
      <p>{p.ozet}</p>
    </div>
    <div class="pk-paket-eylem">
      <a href={`/tr/paketler/${p.id}`} class="pf-ana">Paketin ayrıntıları</a>
      <a href={teklif(p, onerilen(p))} class="pf-ikincil">{onerilen(p).ad} için teklif alın</a>
    </div>
  </div>
  <ol class="pk-basamak" style={`--n: ${p.kademeler.length}`}>
    {p.kademeler.map((x, i) => { const o = kademeOzet(p, i); return (
      <li class={x.rozet ? 'one' : undefined}>
        <a href={`/tr/paketler/${p.id}#${capa(x)}`}>
          <span class="pk-basamak-ust"><strong>{x.ad}</strong>{x.rozet && <em>{x.rozet}</em>}</span>
          {x.kimIcin && <span class="pk-kim">{x.kimIcin}</span>}
          {o.miras && <span class="pk-miras">{o.miras} kapsamı ile birlikte</span>}
          <ul>{o.maddeler.slice(0, 5).map((m) => <li>{m}</li>)}</ul>
          {o.maddeler.length > 5 && <span class="pk-daha">ve {o.maddeler.length - 5} madde daha</span>}
        </a>
      </li>); })}
  </ol>
</div></section>))}

<section id="kurallar" class="pd-bolum"><div class="pf-ic"><PaketSurec idler={k.idler} /></div></section>

{sorular.length > 0 && (
<section id="sorular" class="pd-bolum pd-zemin"><div class="pf-ic pd-sss-izgara">
  <div class="pd-bas"><h2>Sık sorulan sorular</h2><p>Sorunuzun cevabı burada yoksa <a href="/tr/iletisim">bize yazın</a>; 1 iş günü içinde dönüş yapalım.</p></div>
  <div class="pd-sss">{sorular.map((s, i) => <details open={i === 0}><summary>{s.soru}</summary><p>{s.cevap}</p></details>)}</div>
</div></section>)}

<section id="ilgili" class="pd-bolum"><div class="pf-ic">
  <div class="pd-bas"><h2>İlgili hizmetler ve platformlar</h2><p>Bu kategorideki paketler aşağıdaki hizmetlerden oluşur. Her birinin sayfasında ne yaptığımızı ve neyi ölçtüğümüzü bulabilirsiniz.</p></div>
  <div class="pd-iki-liste">
    <div><h3>Hizmetler</h3><ul class="pd-satirlar">{hizmetler.map((h) => <li><a href={`/tr/hizmet/${h.slug}`}><strong>{h.ad}</strong><span>{h.ozet}</span><small>{h.alan}</small></a></li>)}</ul></div>
    {plt.length > 0 && <div><h3>Platformlar</h3><ul class="pd-satirlar">{plt.map((x) => <li><a href={`/tr/platformlar/${x.slug}`}><strong>{x.ad}</strong><span>{x.kisa}</span><small>{x.kategori}</small></a></li>)}</ul></div>}
  </div>
</div></section>

<section class="pd-bolum pd-zemin"><div class="pf-ic">
  <div class="pd-bas pd-bas-yan"><h2>Diğer paket kategorileri</h2><a href="/tr/paketler">Bütün paketler</a></div>
  <ul class="pd-satirlar pd-satirlar-genis">{KATEGORILER.filter((x) => x !== k).map((x) => <li><a href={`/tr/paketler/kategori/${x.slug}`}><strong>{x.ad}</strong><span>{x.alt}</span><small>{x.idler.length} paket</small></a></li>)}</ul>
</div></section>

<div id="analiz"><CagriKutusu baslik={`${k.ad} için nereden başlayalım?`} /></div>
<KatmanStil />
<PaketStil />
</Site>
