---
// Paket ayrıntı sayfası: künye, kademe kartları, kademe karşılaştırma tablosu, her kademede geçerli kurallar,
// başlama adımları, sık sorulan sorular, ilgili hizmet ve platformlar, aynı kategorideki paketler.
// İçerik src/data/paketler.json'dan gelir (panelden düzenlenir); bağlantılar ve tablo mantığı src/data/paket-kategori.js.
import Site from '../../../layouts/Site.astro';
import CagriKutusu from '../../../components/CagriKutusu.astro';
import KatmanStil from '../../../components/KatmanStil.astro';
import PaketStil from '../../../components/PaketStil.astro';
import PaketSurec from '../../../components/PaketSurec.astro';
import KapakGorsel from '../../../components/KapakGorsel.astro';
import paketler from '../../../data/paketler.json';
import gruplar from '../../../data/hizmetler.json';
import platformlar from '../../../data/platformlar.json';
import sss from '../../../data/sss.json';
import { KATEGORILER, PAKET_BAG, kategoriBul, kademeTablosu, kademeOzet, paketSss } from '../../../data/paket-kategori.js';
export function getStaticPaths() { return paketler.map((p) => ({ params: { id: p.id }, props: { p } })); }
const { p } = Astro.props;
const kat = kategoriBul(p.id);
const bag = PAKET_BAG[p.id] || { hizmetler: [], platformlar: [] };
const tumHizmet = gruplar.flatMap((g) => g.hizmetler.map((h) => ({ ...h, alan: g.ad })));
const hizmetler = bag.hizmetler.map((s) => tumHizmet.find((h) => h.slug === s)).filter(Boolean);
const plt = bag.platformlar.map((s) => platformlar.find((x) => x.slug === s)).filter(Boolean);
const kardesler = kat ? kat.idler.filter((id) => id !== p.id).map((id) => paketler.find((x) => x.id === id)).filter(Boolean) : [];
const digerKat = KATEGORILER.filter((k) => k !== kat);
const onerilen = p.kademeler.find((k) => k.rozet) || p.kademeler[0];
const tablo = kademeTablosu(p);
const sorular = paketSss(sss, [p.id]);
const capa = (k) => 'k-' + k.ad.toLocaleLowerCase('tr-TR').replace(/[^a-z0-9çğıöşü]+/g, '-');
const teklif = (k) => `/tr/paketler?paket=${encodeURIComponent(p.birlesik ? k.ad : p.ad + ' · ' + k.ad)}#teklif`;
const TIK = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>';
---
<Site baslik={p.ad} aciklama={p.ozet} aktif="Paketler">
<section class="pd-ust"><div class="pf-ic">
  <nav aria-label="Sayfa yolu" class="pf-yol"><a href="/">Ana sayfa</a><span aria-hidden="true">›</span><a href="/tr/paketler">Paketler</a>{kat && <><span aria-hidden="true">›</span><a href={`/tr/paketler/kategori/${kat.slug}`}>{kat.ad}</a></>}<span aria-hidden="true">›</span><span aria-current="page">{p.ad}</span></nav>
  <div class="pd-ust-izgara">
    <div class="pd-ust-metin">
      <h1>{p.ad}</h1>
      <p class="pd-giris">{p.ozet}</p>
      <div class="pf-eylem">
        <a href={teklif(onerilen)} class="pf-ana">{onerilen.ad} için teklif alın</a>
        <a href={tablo ? '#karsilastirma' : '#kademeler'} class="pf-ikincil">{tablo ? 'Kademeleri karşılaştırın' : 'Kademeleri inceleyin'}</a>
      </div>
      <p class="pd-yardim">Hangisinin uygun olduğundan emin değilseniz <a href="/tr/paketler#sihirbaz">paket sihirbazı</a> dört soruda önerir.</p>
    </div>
    <KapakGorsel tur={`k:${p.id}`} baslik={p.ad} />
  </div>
  <div class="kp-serit" aria-label="Paket künyesi">
    {kat && <a href={`/tr/paketler/kategori/${kat.slug}`}><small>Kategori</small><strong>{kat.ad}</strong><span>{kat.alt}</span></a>}
    <div><small>Ücretlendirme</small><b>{p.ucretNotu}</b></div>
    <div><small>{p.birlesik ? 'Setler' : 'Kademeler'}</small><span class="kp-linkler">{p.kademeler.map((k) => <a href={`#${capa(k)}`}>{k.ad}</a>)}</span></div>
    {onerilen.rozet && <a href={`#${capa(onerilen)}`}><small>{onerilen.rozet}</small><strong>{onerilen.ad}</strong><span>{onerilen.kimIcin}</span></a>}
    {plt.length > 0 && <div><small>Platformlar</small><span class="kp-linkler">{plt.map((x) => <a href={`/tr/platformlar/${x.slug}`}>{x.kisaAd || x.ad}</a>)}</span></div>}
  </div>
</div></section>
<nav class="pf-sayfa-ici" aria-label="Bu sayfada"><div class="pf-ic"><a href="#kademeler">{p.birlesik ? 'Setler' : 'Kademeler'}</a>{tablo && <a href="#karsilastirma">Karşılaştırma</a>}<a href="#kurallar">Kurallar ve adımlar</a>{sorular.length > 0 && <a href="#sorular">Sorular</a>}<a href="#ilgili">İlgili hizmetler</a>{kardesler.length > 0 && <a href="#benzer">{kat.ad} paketleri</a>}</div></nav>

<section id="kademeler" class="pd-bolum"><div class="pf-ic">
  <div class="pd-bas">
    <h2>{p.birlesik ? 'Setler' : 'Kademeler'}</h2>
    <p>{p.birlesik ? 'Her set birden fazla hizmeti tek bütçe planı ve tek raporla birleştirir. Sette hangi hizmetlerin olduğu kartın başında yazar.' : 'Her kademe kimin için olduğunu ve neleri kapsadığını gösterir. Bir üst kademe, alttakinin kapsamını içerdiğinde bu kartta belirtilir.'}</p>
  </div>
  <div class="pd-kademeler" style={`--n: ${p.kademeler.length}`}>
    {p.kademeler.map((k, i) => { const o = kademeOzet(p, i); return (
      <article class={'pd-kademe' + (k.rozet ? ' one' : '')} id={capa(k)}>
        <header>
          {k.rozet && <span class="pd-rozet">{k.rozet}</span>}
          <h3>{k.ad}</h3>
          {k.kimIcin && <p>{k.kimIcin}</p>}
        </header>
        {o.miras && <a class="pd-miras" href={`#${capa(p.kademeler[i - 1])}`}>{o.miras} kapsamının tamamı, ayrıca:</a>}
        <ul>{o.maddeler.map((m) => <li><Fragment set:html={TIK} />{m}</li>)}</ul>
        <a href={teklif(k)} class={k.rozet ? 'pf-ana' : 'pf-ikincil'}>{k.ad} için teklif alın</a>
      </article>); })}
  </div>
</div></section>

{tablo && (
<section id="karsilastirma" class="pd-bolum pd-zemin"><div class="pf-ic">
  <div class="pd-bas">
    <h2>{tablo.tam ? 'Kademe karşılaştırması' : 'Kademeler arasındaki miktar farkı'}</h2>
    <p>{tablo.tam ? 'Üst kademeler alttakilerin kapsamını içerir. Tablo kademe kartlarındaki maddelerden oluşur; kesin kapsam teklifte yazılı olarak netleşir.' : 'Kademeler aylık miktarlarla ayrışır; diğer maddeler kademe kartlarında yazar. Kesin kapsam teklifte yazılı olarak netleşir.'}</p>
  </div>
  <div class="pd-tablo-kap" tabindex="0" role="region" aria-label="Kademe karşılaştırma tablosu (yatay kaydırılabilir)">
    <table class="pd-tablo">
      <thead><tr><th scope="col"><span class="gizli">Kapsam</span></th>{p.kademeler.map((k) => <th scope="col" class={k.rozet ? 'one' : undefined}>{k.ad}{k.rozet && <small>{k.rozet}</small>}</th>)}</tr></thead>
      <tbody>{tablo.satirlar.map((s) => (
        <tr><th scope="row">{s.ad}</th>{s.hucreler.map((h, i) => (
          <td class={p.kademeler[i].rozet ? 'one' : undefined}>{h === true ? <span class="pd-var"><Fragment set:html={TIK} /><span class="gizli">Dâhil</span></span> : h ? <b>{h}</b> : <span class="pd-yok" aria-label="Kapsamda değil">—</span>}</td>))}
        </tr>))}
      </tbody>
      <tfoot><tr><td></td>{p.kademeler.map((k) => <td class={k.rozet ? 'one' : undefined}><a href={teklif(k)}>Teklif alın</a></td>)}</tr></tfoot>
    </table>
  </div>
</div></section>)}

<section id="kurallar" class="pd-bolum"><div class="pf-ic"><PaketSurec idler={[p.id]} /></div></section>

{sorular.length > 0 && (
<section id="sorular" class="pd-bolum pd-zemin"><div class="pf-ic pd-sss-izgara">
  <div class="pd-bas"><h2>Sık sorulan sorular</h2><p>Sorunuzun cevabı burada yoksa <a href="/tr/iletisim">bize yazın</a>; 1 iş günü içinde dönüş yapalım.</p></div>
  <div class="pd-sss">{sorular.map((s, i) => <details open={i === 0}><summary>{s.soru}</summary><p>{s.cevap}</p></details>)}</div>
</div></section>)}

<section id="ilgili" class="pd-bolum"><div class="pf-ic">
  <div class="pd-bas"><h2>Bu paketin dayandığı hizmetler ve platformlar</h2><p>Paket, aşağıdaki hizmetlerin bir araya getirilmiş hâlidir. Her birinin ayrıntılı sayfasında ne yaptığımızı ve neyi ölçtüğümüzü bulabilirsiniz.</p></div>
  <div class="pd-iki-liste">
    <div><h3>Hizmetler</h3><ul class="pd-satirlar">{hizmetler.map((h) => <li><a href={`/tr/hizmet/${h.slug}`}><strong>{h.ad}</strong><span>{h.ozet}</span><small>{h.alan}</small></a></li>)}</ul></div>
    {plt.length > 0 && <div><h3>Platformlar</h3><ul class="pd-satirlar">{plt.map((x) => <li><a href={`/tr/platformlar/${x.slug}`}><strong>{x.ad}</strong><span>{x.kisa}</span><small>{x.kategori}</small></a></li>)}</ul></div>}
  </div>
</div></section>

{kardesler.length > 0 && (
<section id="benzer" class="pd-bolum pd-zemin"><div class="pf-ic">
  <div class="pd-bas pd-bas-yan"><h2>{kat.ad} kategorisindeki diğer paketler</h2><a href={`/tr/paketler/kategori/${kat.slug}`}>Kategoriyi karşılaştırmalı görün</a></div>
  <ul class="pd-satirlar pd-satirlar-genis">{kardesler.map((x) => <li><a href={`/tr/paketler/${x.id}`}><strong>{x.ad}</strong><span>{x.ozet}</span><small>{x.kademeler.map((k) => k.ad).join(', ')}</small></a></li>)}</ul>
  <div class="pf-cipler pd-kat">{digerKat.map((k) => <a href={`/tr/paketler/kategori/${k.slug}`}>{k.ad} paketleri</a>)}<a href="/tr/paketler">Bütün paketler</a></div>
</div></section>)}

<div id="analiz"><CagriKutusu baslik={`${p.ad} için nereden başlayalım?`} /></div>
<KatmanStil />
<PaketStil />
</Site>
