---
// Hizmet sayfası şablonu. Özel tasarımı olan hizmetler (ör. google-ads-yonetimi) kendi dosyasından gelir.
import Site from '../../../layouts/Site.astro';
import CagriKutusu from '../../../components/CagriKutusu.astro';
import gruplar from '../../../data/hizmetler.json';
export function getStaticPaths() {
  return gruplar.flatMap((g) => g.hizmetler.filter((h) => h.slug !== 'google-ads-yonetimi').map((h) => ({ params: { slug: h.slug }, props: { h, g } })));
}
const { h, g } = Astro.props;
const digerleri = g.hizmetler.filter((x) => x.slug !== h.slug);
---
<Site baslik={h.ad} aciklama={h.ozet} aktif="Hizmetler">
<section style="position: relative">
<svg aria-hidden="true" viewBox="0 0 1440 520" preserveAspectRatio="none" style="position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0"><path d="M820 0 C 1000 110 1120 50 1440 120 L1440 0 Z" fill="var(--blob2)"></path><path d="M980 520 C 950 380 1100 250 1440 230 L1440 520 Z" fill="var(--blob)"></path></svg>
<div style="position: relative; z-index: 1; max-width: 1240px; margin: 0 auto; padding: 36px 24px 64px; display: flex; flex-direction: column; gap: 22px">
<nav aria-label="Sayfa yolu" style="font-size: 14px; color: var(--tx2); display: flex; gap: 8px; align-items: center; flex-wrap: wrap"><a href="/" style="color: var(--tx2); text-decoration: none; padding: 6px 0">Ana sayfa</a><span aria-hidden="true">›</span><a href="/tr/hizmetler" style="color: var(--tx2); text-decoration: none; padding: 6px 0">Hizmetler</a><span aria-hidden="true">›</span><a href={`/tr/hizmetler#${g.id}`} style="color: var(--tx2); text-decoration: none; padding: 6px 0">{g.ad}</a></nav>
<div style="display: flex; align-items: center; gap: 12px"><span style="width: 36px; height: 2px; background: var(--brand)"></span><span style="font-size: 14px; font-weight: 600; letter-spacing: 0.06em; color: var(--acc)">{g.ad.toLocaleUpperCase('tr-TR')}</span></div>
<h1 style="margin: 0; font-size: clamp(36px, 7vw, 56px); line-height: 1.06; letter-spacing: -0.03em; color: var(--head); max-width: 860px">{h.ad}</h1>
<p style="margin: 0; font-size: 20px; color: var(--tx2); max-width: 720px">{h.ozet}</p>
<div style="display: flex; gap: 12px; flex-wrap: wrap"><a href="/tr/iletisim#form" style="min-height: 52px; display: flex; align-items: center; padding: 0 24px; border-radius: 12px; background: var(--fill); color: #FFFFFF; text-decoration: none; font-weight: 600">Ücretsiz analiz iste</a><a href="/tr/paketler" style="min-height: 52px; display: flex; align-items: center; padding: 0 22px; border-radius: 12px; border: 1px solid var(--line); background: var(--card); color: var(--head); text-decoration: none; font-weight: 600">Paketleri incele</a></div>
</div>
</section>
<section style="background: var(--bg2); border-top: 1px solid var(--line)">
<div style="max-width: 1240px; margin: 0 auto; padding: 72px 24px; display: flex; flex-wrap: wrap; gap: 40px">
<div style="flex: 2 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 14px">
<h2 style="margin: 0; font-size: 32px; color: var(--head)">Bu hizmette neler yapıyoruz?</h2>
<p style="margin: 0; color: var(--tx2); font-size: 17px">[Bu hizmetin ayrıntılı içeriği hazırlanıyor: kapsam, çalışma adımları, ölçtüğümüz sonuçlar ve sık sorulan sorular.]</p>
</div>
<aside style="flex: 1 1 300px; min-width: 0; padding: 24px; border-radius: 20px; background: var(--card); border: 1px solid var(--line); display: flex; flex-direction: column; gap: 10px">
<b style="color: var(--head)">{g.ad} alanındaki diğer hizmetler</b>
{digerleri.map((x) => <a href={`/tr/hizmet/${x.slug}`} style="padding: 8px 0; border-bottom: 1px solid var(--line); text-decoration: none; font-weight: 600">{x.ad} →</a>)}
</aside>
</div>
</section>
<CagriKutusu />
</Site>
