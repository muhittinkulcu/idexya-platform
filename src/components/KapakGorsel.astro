---
// Sayfa kapak görselleri (Muhittin, 28 Eki 2026): platform, paket, paket kategorisi ve hizmet sayfalarının üst alanı.
// Temsilîdir: gerçek müşteri verisi, rakam veya platform logosu içermez; platform adları yalnız yazı olarak geçer.
// Renkler sabittir (lacivert kapak, beyaz kartlar); açık ve koyu temada aynı görünür.
interface Props { tur: string; baslik?: string; grup?: string; }
const { tur, baslik, grup } = Astro.props;
const HARITA: Record<string, string> = {
  // platformlar
  'p:google-ads': 'arama', 'p:meta': 'sosyal', 'p:google-analytics-4': 'analitik', 'p:search-console': 'konsol', 'p:tag-manager': 'etiket', 'p:ikas': 'magaza', 'p:ticimax': 'magaza',
  // paketler
  'k:google-ads': 'arama', 'k:meta-ads': 'sosyal', 'k:birlesik': 'birlesik', 'k:kurumsal-site': 'site', 'k:eticaret-site': 'magaza', 'k:eticaret-yonetim': 'yonetim', 'k:pazaryeri': 'pazaryeri', 'k:seo': 'seo', 'k:sosyal-medya': 'icerik',
  // paket kategorileri
  'c:reklam': 'birlesik', 'c:e-ticaret': 'pazaryeri', 'c:web-ve-seo': 'site', 'c:icerik': 'icerik',
  // hizmet alanları (hizmete özel eşleşme yoksa)
  'g:e-ticaret': 'yonetim', 'g:dijital-reklam': 'birlesik', 'g:seo': 'seo', 'g:web-yazilim': 'site', 'g:tasarim-icerik': 'icerik',
  // hizmetler
  'h:google-ads-yonetimi': 'arama', 'h:meta-business-ads-yonetimi': 'sosyal', 'h:dijital-pazarlama-yonetimi': 'birlesik', 'h:e-ticaret-pazaryeri-yonetimi': 'pazaryeri', 'h:e-ticaret-pazaryeri-reklam-yonetimi': 'pazaryeri',
  'h:e-ticaret-entegrasyon-yonetimi': 'pazaryeri', 'h:e-ticaret-urun-kategori-yonetimi': 'magaza', 'h:e-ticaret-yonetimi': 'yonetim', 'h:e-ticaret-kargo-lojistik-yonetimi': 'yonetim',
  'h:web-tasarim-hizmetleri': 'site', 'h:teknik-seo': 'konsol', 'h:seo-anahtar-kelime-analizi': 'konsol'
};
const [onek] = tur.split(':');
const ciz = HARITA[tur] || (onek === 'h' && grup ? HARITA['g:' + grup] : undefined) || 'birlesik';
const ARIA: Record<string, string> = {
  arama: 'Google arama sonuçlarında sponsorlu reklam ve alışveriş reklamları',
  sosyal: 'Telefonda Instagram akışında reklam, hikâye ve hedef kitle seçenekleri',
  analitik: 'Satın alma hunisi ve izlenen olaylar',
  konsol: 'Arama performansı grafiği ve dizin durumu',
  etiket: 'Etiket, tetikleyici ve değişkenlerin birbirine bağlandığı ölçüm kurulumu',
  magaza: 'Ürünleri, sepeti ve kampanya alanı olan e-ticaret mağazası',
  pazaryeri: 'Web mağaza ve pazaryerlerinin tek merkezden yönetimi',
  yonetim: 'Kampanya takvimi ve sipariş durumları',
  birlesik: 'Google ve Meta reklamları tek bütçe planında ve tek panelde',
  site: 'Bilgisayar ve telefonda kurumsal web sitesi',
  seo: 'Arama sonucunda ve yapay zekâ özetinde kaynak gösterilen site',
  icerik: 'Sosyal medya gönderi ızgarası, dikey video ve içerik takvimi'
};
const u = Math.random().toString(36).slice(2, 8); // aynı sayfada birden çok kapak: tanım kimlikleri çakışmasın
const gun = ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Paz'];
---
<figure class="kg">
  <svg viewBox="0 0 560 420" role="img" aria-label={(baslik ? baslik + ': ' : '') + ARIA[ciz] + ' (temsilî görsel)'}>
    <defs>
      <linearGradient id={`kg-zemin-${u}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0A3A7A"/><stop offset="1" stop-color="#001B42"/></linearGradient>
      <radialGradient id={`kg-isik-${u}`} cx=".85" cy=".1" r=".7"><stop offset="0" stop-color="#F07A23" stop-opacity=".45"/><stop offset="1" stop-color="#F07A23" stop-opacity="0"/></radialGradient>
      <linearGradient id={`kg-urun-${u}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FDE7D6"/><stop offset="1" stop-color="#F9C9A4"/></linearGradient>
      <pattern id={`kg-izgara-${u}`} width="28" height="28" patternUnits="userSpaceOnUse"><path d="M28 0H0V28" fill="none" stroke="#FFFFFF" stroke-opacity=".06"/></pattern>
    </defs>
    <rect width="560" height="420" fill={`url(#kg-zemin-${u})`}/>
    <rect width="560" height="420" fill={`url(#kg-izgara-${u})`}/>
    <rect width="560" height="420" fill={`url(#kg-isik-${u})`}/>

    {ciz === 'arama' && (
      <g>
        <rect x="36" y="32" width="488" height="50" rx="25" class="kg-kart"/>
        <circle cx="66" cy="57" r="8" class="kg-cizgi-koyu"/><path d="M72 63 L79 70" class="kg-cizgi-koyu"/>
        <text x="92" y="62" class="kg-y15">spor ayakkabı modelleri</text>
        <rect x="36" y="98" width="488" height="104" rx="16" class="kg-kart"/>
        <rect x="56" y="114" width="72" height="22" rx="11" class="kg-tint"/><text x="92" y="129" text-anchor="middle" class="kg-y12 kg-kalin kg-turuncu-y">Sponsorlu</text>
        <text x="140" y="130" class="kg-y12 kg-soluk-y">markaniz.com/kampanya</text>
        <text x="56" y="162" class="kg-y17 kg-kalin kg-mavi-y">Spor ayakkabıda sezon indirimi</text>
        <rect x="56" y="176" width="380" height="8" rx="4" class="kg-satir"/>
        <rect x="56" y="190" width="300" height="0" />
        <g transform="translate(36 218)">
          {[0, 1, 2, 3].map((i) => (
            <g transform={`translate(${i * 124} 0)`}>
              <rect width="116" height="136" rx="14" class="kg-kart"/>
              <rect x="10" y="10" width="96" height="62" rx="10" fill={`url(#kg-urun-${u})`}/>
              <path d={`M24 58 C 34 ${44 - i * 2} 56 ${40 + i} 70 50 L 92 52 C 96 52 96 60 92 60 L 26 62 Z`} class="kg-turuncu"/>
              <rect x="10" y="84" width="80" height="8" rx="4" class="kg-satir-koyu"/>
              <rect x="10" y="98" width="52" height="8" rx="4" class="kg-satir"/>
              <rect x="10" y="114" width="58" height="14" rx="7" class="kg-tint"/><text x="39" y="124.5" text-anchor="middle" class="kg-y9 kg-kalin kg-turuncu-y">Sponsorlu</text>
            </g>
          ))}
        </g>
        <g transform="translate(36 372)">
          {['Tıklama', 'Dönüşüm', 'Satış değeri'].map((t, i) => (
            <g transform={`translate(${i * 142} 0)`}><rect width="130" height="30" rx="15" class="kg-cam"/><circle cx="16" cy="15" r="5" class={['kg-mavi', 'kg-yesil', 'kg-turuncu'][i]}/><text x="28" y="20" class="kg-y12 kg-beyaz-y">{t}</text></g>
          ))}
        </g>
      </g>
    )}

    {ciz === 'sosyal' && (
      <g>
        <rect x="56" y="24" width="214" height="372" rx="34" fill="#0B0F1A"/>
        <rect x="66" y="36" width="194" height="348" rx="26" class="kg-kart-duz"/>
        <circle cx="90" cy="64" r="12" fill={`url(#kg-urun-${u})`}/>
        <text x="110" y="62" class="kg-y12 kg-kalin kg-koyu-y">markaniz</text>
        <text x="110" y="76" class="kg-y10 kg-soluk-y">Sponsorlu</text>
        <rect x="66" y="88" width="194" height="170" fill={`url(#kg-urun-${u})`}/>
        <circle cx="163" cy="168" r="48" fill="#FFFFFF" fill-opacity=".55"/>
        <path d="M128 186 C 142 150 176 146 196 168 L 206 170 C 212 172 210 184 204 184 L 132 190 Z" class="kg-turuncu"/>
        <rect x="76" y="268" width="174" height="34" rx="10" class="kg-turuncu"/>
        <text x="163" y="290" text-anchor="middle" class="kg-y13 kg-kalin" fill="#1A1206">Şimdi alışveriş yap</text>
        <g transform="translate(80 316)"><path d="M8 4 C 2 -2 -6 6 8 16 C 22 6 14 -2 8 4 Z" class="kg-cizgi-koyu-ince"/><circle cx="38" cy="8" r="7" class="kg-cizgi-koyu-ince"/><path d="M60 2 L76 8 L60 14 Z" class="kg-cizgi-koyu-ince"/></g>
        <rect x="80" y="344" width="130" height="7" rx="3.5" class="kg-satir-koyu"/><rect x="80" y="358" width="96" height="7" rx="3.5" class="kg-satir"/>
        <g transform="rotate(6 400 160)">
          <rect x="320" y="40" width="150" height="250" rx="22" class="kg-kart"/>
          <rect x="332" y="52" width="126" height="4" rx="2" class="kg-turuncu"/>
          <rect x="332" y="66" width="126" height="170" rx="14" fill={`url(#kg-urun-${u})`}/>
          <text x="395" y="160" text-anchor="middle" class="kg-y15 kg-kalin kg-koyu-y">Hikâye</text>
          <rect x="350" y="248" width="90" height="26" rx="13" class="kg-koyu"/><text x="395" y="265" text-anchor="middle" class="kg-y11 kg-kalin kg-beyaz-y">Kaydır</text>
        </g>
        <g transform="translate(300 312)">
          {['Site ziyaretçileri', 'Sepeti terk edenler', 'Benzer kitle'].map((t, i) => (
            <g transform={`translate(${i * 12} ${i * 34})`}><rect width="190" height="28" rx="14" class="kg-cam"/><circle cx="16" cy="14" r="5" class={['kg-mavi', 'kg-turuncu', 'kg-yesil'][i]}/><text x="28" y="19" class="kg-y12 kg-beyaz-y">{t}</text></g>
          ))}
        </g>
      </g>
    )}

    {ciz === 'analitik' && (
      <g>
        <rect x="32" y="32" width="496" height="268" rx="20" class="kg-kart"/>
        <text x="56" y="66" class="kg-y16 kg-kalin kg-koyu-y">Satın alma hunisi</text>
        <text x="504" y="66" text-anchor="end" class="kg-y12 kg-soluk-y">Son 30 gün</text>
        {[['Oturum', 448], ['Ürün görüntüleme', 352], ['Sepete ekleme', 240], ['Ödeme', 168], ['Satın alma', 112]].map(([t, w], i) => (
          <g transform={`translate(56 ${86 + i * 40})`}>
            <rect width="448" height="30" rx="8" class="kg-zemin-ac"/>
            <rect width={w} height="30" rx="8" class={i === 4 ? 'kg-turuncu' : 'kg-mavi'} fill-opacity={i === 4 ? 1 : 1 - i * 0.15}/>
            <text x="12" y="20" class={'kg-y12 kg-kalin ' + (i === 4 ? '' : 'kg-beyaz-y')} fill={i === 4 ? '#1A1206' : undefined}>{t}</text>
          </g>
        ))}
        <g transform="translate(32 318)">
          {[['purchase', 'Satın alma'], ['generate_lead', 'Form'], ['add_to_cart', 'Sepete ekleme']].map(([o, t], i) => (
            <g transform={`translate(${i * 168} 0)`}><rect width="156" height="70" rx="14" class="kg-cam"/><circle cx="20" cy="22" r="5" class="kg-yesil"/><text x="32" y="27" class="kg-y12 kg-kalin kg-beyaz-y">{t}</text><text x="20" y="52" class="kg-y11 kg-beyaz-soluk-y">{o}</text></g>
          ))}
        </g>
      </g>
    )}

    {ciz === 'konsol' && (
      <g>
        <rect x="32" y="32" width="496" height="236" rx="20" class="kg-kart"/>
        <text x="56" y="66" class="kg-y16 kg-kalin kg-koyu-y">Arama performansı</text>
        <g transform="translate(330 52)"><rect width="84" height="24" rx="12" class="kg-turuncu"/><text x="42" y="16" text-anchor="middle" class="kg-y11 kg-kalin" fill="#1A1206">Tıklama</text><rect x="92" width="84" height="24" rx="12" class="kg-mavi"/><text x="134" y="16" text-anchor="middle" class="kg-y11 kg-kalin kg-beyaz-y">Gösterim</text></g>
        {[0, 1, 2, 3].map((i) => <path d={`M56 ${110 + i * 40} H504`} class="kg-izgara-cizgi"/>)}
        <path d="M56 214 C 96 206 120 196 160 192 S 230 170 270 164 S 340 140 380 132 S 450 112 504 98" class="kg-cizgi-mavi"/>
        <path d="M56 236 C 100 232 130 228 170 222 S 240 212 280 204 S 350 186 390 180 S 460 160 504 148" class="kg-cizgi-turuncu"/>
        <circle cx="504" cy="148" r="5" class="kg-turuncu"/><circle cx="504" cy="98" r="5" class="kg-mavi"/>
        <rect x="32" y="284" width="496" height="104" rx="20" class="kg-kart"/>
        <text x="56" y="316" class="kg-y14 kg-kalin kg-koyu-y">Dizin durumu</text>
        <rect x="56" y="330" width="448" height="16" rx="8" class="kg-zemin-ac"/>
        <rect x="56" y="330" width="360" height="16" rx="8" class="kg-yesil"/>
        <circle cx="62" cy="370" r="5" class="kg-yesil"/><text x="74" y="375" class="kg-y12 kg-koyu-y">Dizine eklendi</text>
        <circle cx="210" cy="370" r="5" class="kg-satir-koyu"/><text x="222" y="375" class="kg-y12 kg-koyu-y">Hariç tutuldu</text>
        <path d="M372 368 l5 5 l10 -10" class="kg-cizgi-yesil"/><text x="394" y="375" class="kg-y12 kg-koyu-y">Site haritası</text>
      </g>
    )}

    {ciz === 'etiket' && (
      <g>
        {[['Etiketler', ['GA4 etkinliği', 'Meta pikseli', 'Ads dönüşümü'], 'kg-turuncu'], ['Tetikleyiciler', ['Form gönderimi', 'Satın alma sayfası', 'WhatsApp tıklaması'], 'kg-mavi'], ['Değişkenler', ['Sipariş tutarı', 'Para birimi', 'Ürün kimliği'], 'kg-yesil']].map(([b, l, c], i) => (
          <g transform={`translate(${28 + i * 174} 40)`}>
            <rect width="156" height="252" rx="18" class="kg-kart"/>
            <rect x="16" y="18" width="10" height="10" rx="3" class={String(c)}/>
            <text x="34" y="28" class="kg-y14 kg-kalin kg-koyu-y">{b}</text>
            {(l as string[]).map((t, j) => (
              <g transform={`translate(14 ${50 + j * 64})`}><rect width="128" height="50" rx="12" class="kg-zemin-ac"/><text x="12" y="22" class="kg-y12 kg-kalin kg-koyu-y">{t}</text><rect x="12" y="32" width={60 + j * 12} height="6" rx="3" class="kg-satir"/></g>
            ))}
          </g>
        ))}
        <path d="M184 166 H202 M358 166 H376" class="kg-ok"/>
        <path d="M196 160 l6 6 l-6 6 M370 160 l6 6 l-6 6" class="kg-ok"/>
        <rect x="28" y="316" width="504" height="64" rx="18" class="kg-cam"/>
        <circle cx="62" cy="348" r="14" class="kg-yesil"/><path d="M55 348 l5 5 l9 -10" stroke="#FFFFFF" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        <text x="88" y="344" class="kg-y14 kg-kalin kg-beyaz-y">Önizleme ve test</text>
        <text x="88" y="364" class="kg-y12 kg-beyaz-soluk-y">Her değişiklik yayına almadan önce test edilir</text>
      </g>
    )}

    {ciz === 'magaza' && (
      <g>
        <rect x="28" y="28" width="504" height="364" rx="18" class="kg-kart"/>
        <rect x="28" y="28" width="504" height="38" rx="18" class="kg-zemin-ac"/><rect x="28" y="50" width="504" height="16" class="kg-zemin-ac"/>
        <circle cx="50" cy="47" r="5" class="kg-turuncu"/><circle cx="66" cy="47" r="5" class="kg-satir-koyu"/><circle cx="82" cy="47" r="5" class="kg-satir-koyu"/>
        <rect x="200" y="38" width="160" height="18" rx="9" class="kg-kart-duz"/><text x="280" y="51" text-anchor="middle" class="kg-y10 kg-soluk-y">markaniz.com</text>
        <rect x="52" y="82" width="70" height="14" rx="7" class="kg-koyu"/>
        {[0, 1, 2].map((i) => <rect x={180 + i * 62} y="85" width="46" height="8" rx="4" class="kg-satir"/>)}
        <path d="M476 80 h6 l5 16 h18 l4 -11 h-24" class="kg-cizgi-koyu-ince"/><circle cx="490" cy="101" r="2.5" class="kg-koyu"/><circle cx="502" cy="101" r="2.5" class="kg-koyu"/>
        <circle cx="510" cy="80" r="8" class="kg-turuncu"/><text x="510" y="84" text-anchor="middle" class="kg-y10 kg-kalin" fill="#1A1206">2</text>
        <rect x="52" y="110" width="456" height="92" rx="14" class="kg-turuncu"/>
        <text x="74" y="146" class="kg-y20 kg-kalin" fill="#1A1206">Yeni sezon</text>
        <text x="74" y="170" class="kg-y13" fill="#1A1206" fill-opacity=".75">Ücretsiz kargo, kolay iade</text>
        <circle cx="440" cy="156" r="34" fill="#FFFFFF" fill-opacity=".35"/><circle cx="474" cy="130" r="16" fill="#FFFFFF" fill-opacity=".25"/>
        {[0, 1, 2].map((i) => (
          <g transform={`translate(${52 + i * 156} 218)`}>
            <rect width="144" height="158" rx="14" class="kg-zemin-ac"/>
            <rect x="10" y="10" width="124" height="74" rx="10" fill={`url(#kg-urun-${u})`}/>
            <circle cx="72" cy="47" r={20 - i * 3} class="kg-turuncu" fill-opacity=".8"/>
            <rect x="10" y="94" width="96" height="8" rx="4" class="kg-satir-koyu"/>
            <rect x="10" y="108" width="54" height="8" rx="4" class="kg-satir"/>
            <rect x="10" y="124" width="124" height="24" rx="8" class="kg-koyu"/><text x="72" y="140" text-anchor="middle" class="kg-y11 kg-kalin kg-beyaz-y">Sepete ekle</text>
          </g>
        ))}
      </g>
    )}

    {ciz === 'pazaryeri' && (
      <g>
        <path d="M150 104 L232 168 M410 104 L328 168 M150 276 L232 222 M410 276 L328 222 M280 74 L280 152" class="kg-kesik"/>
        <g class="kg-akis"><circle cx="191" cy="136" r="4"/><circle cx="369" cy="136" r="4"/><circle cx="191" cy="249" r="4"/><circle cx="369" cy="249" r="4"/><circle cx="280" cy="113" r="4"/></g>
        <rect x="200" y="152" width="160" height="86" rx="20" class="kg-turuncu"/>
        <text x="280" y="188" text-anchor="middle" class="kg-y17 kg-kalin" fill="#1A1206">Tek merkez</text>
        <text x="280" y="212" text-anchor="middle" class="kg-y12" fill="#1A1206">Stok, fiyat ve sipariş</text>
        {[['Web mağaza', 40, 70], ['Trendyol', 380, 70], ['Hepsiburada', 40, 262], ['Amazon', 380, 262], ['N11', 220, 28]].map(([t, x, y]) => (
          <g transform={`translate(${x} ${y})`}><rect width={t === 'N11' ? 120 : 140} height="46" rx="14" class="kg-kart"/><text x={t === 'N11' ? 60 : 70} y="29" text-anchor="middle" class="kg-y14 kg-kalin kg-koyu-y">{t}</text></g>
        ))}
        <g transform="translate(64 338)">
          {['Sipariş', 'Paket', 'Kargo', 'Teslim'].map((s, j) => (
            <g><circle cx={j * 128} cy="14" r="8" class={j < 3 ? 'kg-turuncu' : 'kg-cam-dolu'}/><text x={j * 128} y="44" text-anchor="middle" class="kg-y12 kg-beyaz-y">{s}</text>{j < 3 && <path d={`M${j * 128 + 14} 14 H${j * 128 + 114}`} class="kg-kesik"/>}</g>
          ))}
        </g>
      </g>
    )}

    {ciz === 'yonetim' && (
      <g>
        <rect x="28" y="32" width="282" height="356" rx="20" class="kg-kart"/>
        <text x="50" y="66" class="kg-y15 kg-kalin kg-koyu-y">Kampanya takvimi</text>
        {gun.map((g, i) => <text x={62 + i * 36} y="96" text-anchor="middle" class="kg-y10 kg-soluk-y">{g}</text>)}
        {Array.from({ length: 35 }, (_, n) => {
          const x = 46 + (n % 7) * 36, y = 108 + Math.floor(n / 7) * 40;
          const ozel = [3, 4, 5, 17, 18, 26, 27, 28].includes(n);
          return <rect x={x} y={y} width="32" height="34" rx="8" class={ozel ? (n < 10 ? 'kg-turuncu' : n < 20 ? 'kg-mavi' : 'kg-yesil') : 'kg-zemin-ac'}/>;
        })}
        <g transform="translate(46 324)"><rect width="10" height="10" rx="3" class="kg-turuncu"/><text x="16" y="9" class="kg-y11 kg-koyu-y">Sezon indirimi</text><rect x="120" width="10" height="10" rx="3" class="kg-mavi"/><text x="136" y="9" class="kg-y11 kg-koyu-y">Özel gün</text></g>
        <g transform="translate(46 344)"><rect width="10" height="10" rx="3" class="kg-yesil"/><text x="16" y="9" class="kg-y11 kg-koyu-y">Ücretsiz kargo</text></g>
        <g transform="translate(330 32)">
          <rect width="202" height="356" rx="20" class="kg-cam"/>
          <text x="20" y="34" class="kg-y15 kg-kalin kg-beyaz-y">Siparişler</text>
          {[['Yeni', 'kg-turuncu'], ['Hazırlanıyor', 'kg-mavi'], ['Kargoda', 'kg-mavi'], ['Teslim edildi', 'kg-yesil'], ['İade talebi', 'kg-turuncu']].map(([t, c], i) => (
            <g transform={`translate(16 ${54 + i * 58})`}><rect width="170" height="48" rx="12" class="kg-kart"/><rect x="12" y="12" width="60" height="7" rx="3.5" class="kg-satir-koyu"/><rect x="12" y="27" width="40" height="7" rx="3.5" class="kg-satir"/><rect x="88" y="14" width="72" height="20" rx="10" class={String(c)}/><text x="124" y="28" text-anchor="middle" class="kg-y9 kg-kalin" fill={c === 'kg-turuncu' ? '#1A1206' : '#FFFFFF'}>{t}</text></g>
          ))}
        </g>
      </g>
    )}

    {ciz === 'birlesik' && (
      <g>
