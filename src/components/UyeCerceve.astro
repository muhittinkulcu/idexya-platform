---
// Üye sayfalarının ortak çerçevesi: başlık, açıklama, ortadaki kart.
import Site from '../layouts/Site.astro';
interface Props { baslik: string; aciklama?: string; genis?: boolean; }
const { baslik, aciklama = '', genis = false } = Astro.props;
---
<Site baslik={baslik} aciklama={aciklama} aramayaKapali>
<section style={`max-width: ${genis ? 1040 : 560}px; margin: 0 auto; padding: clamp(48px, 8vw, 88px) 24px 96px; box-sizing: border-box; display: flex; flex-direction: column; gap: 22px`}>
<div style="display: flex; flex-direction: column; gap: 10px">
<h1 style="margin: 0; font-size: clamp(30px, 5vw, 40px); line-height: 1.12; letter-spacing: -0.02em; color: var(--head)" data-uye-baslik>{baslik}</h1>
{aciklama && <p style="margin: 0; color: var(--tx2); font-size: 17px">{aciklama}</p>}
</div>
<slot />
</section>
</Site>
<style is:global>
.uye-kart{background:var(--card);border:1px solid var(--line);border-radius:22px;box-shadow:0 24px 60px var(--shadow);padding:clamp(22px,4vw,34px);box-sizing:border-box;display:flex;flex-direction:column;gap:16px;min-width:0}
.uye-alan{display:flex;flex-direction:column;gap:6px;font-size:14px;font-weight:600;color:var(--head)}
.uye-alan input,.uye-alan textarea{min-height:48px;padding:0 14px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--tx);font:inherit;font-size:16px;font-weight:400;box-sizing:border-box;width:100%}
.uye-alan textarea{padding:12px 14px;resize:vertical}
.uye-alan small{font-weight:400;color:var(--tx2);font-size:13px}
.uye-onay{display:flex;gap:10px;align-items:flex-start;font-size:14px;color:var(--tx2)}
.uye-onay input{width:20px;height:20px;margin:1px 0 0;flex:none}
.uye-dugme{min-height:52px;border:0;border-radius:12px;background:var(--fill);color:#FFFFFF;font:inherit;font-size:17px;font-weight:600;cursor:pointer;padding:0 22px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none}
.uye-dugme.ikincil{background:transparent;border:1px solid var(--line);color:var(--head)}
.uye-dugme:disabled{opacity:.6;cursor:default}
.uye-durum{margin:0;padding:12px 14px;border-radius:10px;font-size:15px}
.uye-alt{font-size:15px;color:var(--tx2);text-align:center}
</style>
