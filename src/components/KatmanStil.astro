---
// Katmanlı sayfaların (platform, paket kategorisi, paket ayrıntısı) ortak görünümü.
---
<style is:global>
.pf-ic{max-width:1240px;margin:0 auto;padding:0 24px;box-sizing:border-box}
.pf-ust{padding:56px 0 48px;background:radial-gradient(700px 360px at 85% 0%,var(--blob),transparent 70%),var(--bg)}
.pf-yol{display:flex;flex-wrap:wrap;gap:8px;font-size:14px;color:var(--tx2);margin-bottom:22px}.pf-yol a{color:var(--tx2)}
.pf-etiket{display:inline-block;font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--acc)}
.pf-ust h1{margin:8px 0 12px;font-size:clamp(34px,5vw,56px);line-height:1.08;letter-spacing:-.03em;color:var(--head)}
.pf-giris{margin:0;max-width:720px;font-size:19px;line-height:1.6;color:var(--tx2)}
.pf-eylem{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}
.pf-ana,.pf-ikincil{min-height:50px;display:inline-flex;align-items:center;padding:0 22px;border-radius:12px;font-weight:700;text-decoration:none}
.pf-ana{background:var(--fill);color:#FFFFFF}.pf-ikincil{border:1px solid var(--line);background:var(--card);color:var(--head)}
.pf-sayfa-ici{position:sticky;top:76px;z-index:5;background:color-mix(in srgb,var(--bg) 94%,transparent);backdrop-filter:blur(10px);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.pf-sayfa-ici .pf-ic{display:flex;gap:22px;overflow-x:auto;padding-top:12px;padding-bottom:12px}.pf-sayfa-ici a{white-space:nowrap;font-size:14px;font-weight:600;color:var(--tx2);text-decoration:none}.pf-sayfa-ici a:hover{color:var(--acc)}
.pf-govde{display:flex;flex-direction:column;gap:56px;padding-top:56px;padding-bottom:56px}
.pf-bolum h2{margin:0 0 18px;font-size:clamp(24px,3vw,32px);letter-spacing:-.02em;color:var(--head)}
.pf-iki{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(260px,1fr);gap:28px;align-items:start}
@media (max-width:860px){.pf-iki{grid-template-columns:1fr}}
.pf-metin{margin:0;font-size:17px;line-height:1.75;color:var(--tx);text-align:justify;hyphens:auto}
.pf-kutu{padding:20px;border-radius:16px;background:var(--card);border:1px solid var(--line)}.pf-kutu b{font-size:13px;letter-spacing:.05em;text-transform:uppercase;color:var(--acc)}.pf-kutu ul{margin:10px 0 0;padding-left:18px;display:flex;flex-direction:column;gap:6px;color:var(--tx2)}
.pf-liste{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px}
.pf-liste li{display:flex;gap:14px;padding:18px;border-radius:16px;background:var(--card);border:1px solid var(--line);line-height:1.55}.pf-liste i{font-style:normal;font-weight:700;font-size:20px;color:var(--brand);opacity:.7}
.pf-kartlar{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px}
.pf-dikkat{padding:18px;border-radius:16px;background:var(--tint);color:var(--tx);line-height:1.55}
.pf-bag{display:flex;flex-direction:column;gap:6px;padding:18px;border-radius:16px;background:var(--card);border:1px solid var(--line);text-decoration:none;color:var(--tx);transition:transform .2s,border-color .2s}
.pf-bag:hover{transform:translateY(-3px);border-color:var(--brand)}.pf-bag small{font-size:12px;font-weight:700;color:var(--acc)}.pf-bag strong{font-size:17px;color:var(--head)}.pf-bag span{font-size:14px;color:var(--tx2);line-height:1.5}
.pf-bag em{margin-top:auto;display:inline-flex;align-items:center;gap:6px;font-style:normal;font-size:14px;font-weight:700;color:var(--acc)}
.pf-sss{display:flex;flex-direction:column;gap:8px}.pf-sss details{padding:16px 18px;border-radius:14px;background:var(--card);border:1px solid var(--line)}.pf-sss summary{cursor:pointer;font-weight:700;color:var(--head)}.pf-sss p{margin:10px 0 0;color:var(--tx2);line-height:1.6}
.pf-cipler{display:flex;flex-wrap:wrap;gap:8px}.pf-cipler a{padding:8px 14px;border-radius:999px;border:1px solid var(--line);background:var(--card);color:var(--head);font-weight:600;text-decoration:none}.pf-cipler a:hover{border-color:var(--brand);color:var(--acc)}
.pf-not{margin:12px 0 0;font-size:13px;color:var(--tx2)}

.pf-hizli{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.pf-hizli a{display:inline-flex;align-items:center;gap:6px;padding:7px 12px;border-radius:999px;background:var(--card);border:1px solid var(--line);font-size:13px;font-weight:600;color:var(--head);text-decoration:none}.pf-hizli a:hover{border-color:var(--brand);color:var(--acc)}
.pk-kademeler{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px}
.pk-kademe{position:relative;display:flex;flex-direction:column;gap:12px;padding:24px;border-radius:20px;background:var(--card);border:1px solid var(--line)}
.pk-kademe.one{border:2px solid var(--brand);box-shadow:0 24px 50px var(--shadow)}
.pk-rozet{position:absolute;top:-12px;left:20px;padding:4px 10px;border-radius:999px;background:var(--fill);color:#FFFFFF;font-size:12px;font-weight:700}
.pk-kademe h3{margin:0;font-size:20px;color:var(--head)}.pk-kademe>p{margin:0;color:var(--tx2);font-size:14px;line-height:1.55}
.pk-kademe ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px;font-size:14px}.pk-kademe li{display:flex;gap:8px}.pk-kademe li::before{content:"✓";color:var(--ok);font-weight:700;flex:none}
.pk-kademe .pf-ana{margin-top:auto;justify-content:center}.pk-kademe .pf-ikincil{margin-top:auto;justify-content:center}
.pk-not{margin:14px 0 0;font-size:14px;color:var(--tx2)}
.pk-sonraki{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px}
.kp-izgara{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:56px;align-items:center}
.kp-izgara .kg{max-width:600px;justify-self:end;width:100%}
.kp-serit{margin-top:40px;display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));border:1px solid var(--line);border-radius:18px;background:var(--card);overflow:hidden}
.kp-serit>div,.kp-serit>a{display:flex;flex-direction:column;gap:4px;padding:16px 20px;border-left:1px solid var(--line);text-decoration:none;color:var(--tx);min-width:0}
.kp-serit>:first-child{border-left:0}
.kp-serit small{font-size:12.5px;color:var(--tx2)}
.kp-serit b,.kp-serit strong{font-size:15px;color:var(--head);line-height:1.35}
.kp-serit span{font-size:13.5px;color:var(--tx2);line-height:1.45}
.kp-serit a:hover strong{color:var(--acc)}
.kp-serit .kp-linkler{display:flex;flex-wrap:wrap;gap:4px 10px}.kp-serit .kp-linkler a{font-weight:600;color:var(--head);font-size:14.5px}.kp-serit .kp-linkler a:hover{color:var(--acc)}
@media (max-width:960px){.kp-izgara{grid-template-columns:minmax(0,1fr);gap:32px}.kp-izgara .kg{justify-self:stretch;max-width:none}}
@media (max-width:640px){.kp-serit{grid-template-columns:minmax(0,1fr)}.kp-serit>div,.kp-serit>a{border-left:0;border-top:1px solid var(--line)}.kp-serit>:first-child{border-top:0}}
</style>
