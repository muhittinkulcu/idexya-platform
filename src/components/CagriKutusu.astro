---
interface Props { baslik?: string; metin?: string; }
const { baslik = 'Nereden başlayacağınızı birlikte bulalım', metin = 'Hesaplarınızı ve sitenizi ücretsiz inceleyip size bir yol haritası çıkaralım.' } = Astro.props;
---
<section style="padding: 24px 24px 96px">
<div style="max-width: 1192px; margin: 0 auto; background: #002559; color: #F1F3F5; border-radius: 28px; padding: clamp(28px, 6vw, 52px); overflow: hidden; display: flex; flex-wrap: wrap; gap: 32px; align-items: center; justify-content: space-between">
<div style="flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 12px">
<h2 style="margin: 0; font-size: 36px; line-height: 1.12; color: #FFFFFF">{baslik}</h2>
<p style="margin: 0; color: #C6D2E3; font-size: 17px">{metin}</p>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 12px">
<a href="/tr/iletisim#form" data-hizli-talep="analiz" style="min-height: 54px; display: flex; align-items: center; padding: 0 26px; border-radius: 12px; background: #F07A23; color: #1A1206; text-decoration: none; font-weight: 700; font-size: 17px">Ücretsiz analiz iste</a>
<a href="https://wa.me/905078700629" style="min-height: 54px; display: flex; align-items: center; padding: 0 22px; border-radius: 12px; border: 1px solid rgba(255,255,255,.35); color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 17px">WhatsApp’tan yaz</a>
</div>
</div>
</section>
