---
// Ana sayfa: çalıştığımız platformlar (listeyi Muhittin onayladı, 23 Eki 2026). Resmî iş ortaklığı iddiası içermez; marka logoları kullanılmaz.
import Baslik from './Baslik.astro';
const GRUPLAR = [
  { ad: 'E-ticaret altyapıları', liste: ['ikas', 'Ticimax', 'Shopify', 'WooCommerce', 'IdeaSoft', 'T-Soft'] },
  { ad: 'Pazaryerleri', liste: ['Trendyol', 'Hepsiburada', 'Amazon', 'N11', 'Çiçeksepeti', 'Pazarama'] },
  { ad: 'Reklam ve ölçüm', liste: ['Google Ads', 'Meta', 'TikTok', 'Google Analytics 4', 'Google Etiket Yöneticisi', 'Search Console', 'Meta Dönüşüm API', 'BigQuery'] },
  { ad: 'Yazılım ve otomasyon', liste: ['Logo', 'Mikro', 'Paraşüt', 'BizimHesap', 'HubSpot', 'Zapier', 'Make'] }
];
---
<section class="pl" aria-labelledby="pl-baslik">
  <div class="pl-ic">
    <Baslik id="pl-baslik" etiket="Platformlar ve entegrasyonlar" baslik="Kullandığınız araçlarla çalışırız" aciklama="Mevcut altyapınızı değiştirmeden, birbirine bağlayarak ilerleriz." baglanti={{ href: '/tr/hizmet/e-ticaret-entegrasyon-yonetimi/', ad: 'Entegrasyon yönetimi' }} />
    <div class="pl-izgara">
      {GRUPLAR.map((g) => (
        <div class="pl-grup"><h3>{g.ad}</h3><ul>{g.liste.map((p) => <li>{p}</li>)}</ul></div>
      ))}
    </div>
    <p class="pl-not">Marka adları sahiplerine aittir; listedeki platformlarla resmî iş ortaklığı belirtmez.</p>
  </div>
</section>
<style>
  .pl-ic{max-width:var(--kap);margin:0 auto;padding:96px var(--kenar);box-sizing:border-box;display:flex;flex-direction:column;gap:36px}
  .pl-izgara{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
  .pl-grup{padding:22px;border-radius:20px;border:1px solid var(--line);background:var(--card)}
  .pl-grup h3{margin:0 0 14px;font-size:15px;letter-spacing:.02em;color:var(--acc)}
  .pl-grup ul{margin:0;padding:0;list-style:none;display:flex;flex-wrap:wrap;gap:8px}
  .pl-grup li{padding:8px 12px;border-radius:10px;background:var(--bg);border:1px solid var(--line);font-weight:600;font-size:14px;color:var(--head)}
  .pl-not{margin:0;font-size:12.5px;color:var(--tx2)}
  @media (max-width:1100px){.pl-izgara{grid-template-columns:1fr 1fr}}
  @media (max-width:600px){.pl-izgara{grid-template-columns:1fr}.pl-ic{padding-top:64px;padding-bottom:64px}}
</style>
