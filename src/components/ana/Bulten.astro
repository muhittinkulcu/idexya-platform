---
// Bülten ilgi listesi kutusu: e-posta ve ayrı, işaretsiz ticari ileti onayı. Kayıt /api/bulten'e gider (worker/bulten.js).
---
<form class="bt" data-bulten novalidate>
  <div class="bt-metin">
    <h3>Aylık bülten</h3>
    <p>Ayda bir e-posta: reklam, e-ticaret ve ölçümde işe yarayan güncel bilgiler. İstediğiniz an tek tıkla ayrılabilirsiniz.</p>
  </div>
  <div class="bt-alan">
    <div class="bt-satir">
      <label for="bt-eposta" class="gizli-et">E-posta adresiniz</label>
      <input id="bt-eposta" name="eposta" type="email" autocomplete="email" placeholder="E-posta adresiniz" required>
      <input name="web_adresi_tekrar" tabindex="-1" autocomplete="off" aria-hidden="true" class="bt-tuzak">
      <button type="submit">Abone ol</button>
    </div>
    <label class="bt-onay"><input type="checkbox" name="onay"><span>Idexya’nın bülten ve duyurularını e-posta ile almak istiyorum (ticari elektronik ileti onayı). Onayımı istediğim zaman geri alabilirim. <a href="/tr/sayfa/kvkk-aydinlatma-metni/">KVKK aydınlatma metni</a></span></label>
    <div data-turnstile></div>
    <p class="bt-durum" data-durum role="status" hidden></p>
  </div>
</form>
<script>
  import { robotBagla } from '../../scripts/form.js';
  document.querySelectorAll<HTMLFormElement>('form[data-bulten]').forEach((f) => {
    const robot = robotBagla(f);
    const durum = f.querySelector<HTMLElement>('[data-durum]')!;
    const yaz = (m: string, ok: boolean) => { durum.hidden = false; durum.textContent = m; durum.dataset.tur = ok ? 'ok' : 'hata'; };
    f.addEventListener('submit', async (o) => {
      o.preventDefault();
      const eposta = (f.elements.namedItem('eposta') as HTMLInputElement).value.trim();
      const onay = (f.elements.namedItem('onay') as HTMLInputElement).checked;
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(eposta)) return yaz('Lütfen geçerli bir e-posta adresi yazın.', false);
      if (!onay) return yaz('Bülteni gönderebilmemiz için onay kutusunu işaretleyin.', false);
      if (robot.gerekli && !robot.jeton()) return yaz('Lütfen robot doğrulamasını tamamlayın.', false);
      const d = f.querySelector('button')!; d.disabled = true;
      try {
        const r = await fetch('/api/bulten', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ eposta, onay: true, sayfa: location.pathname, turnstile: robot.jeton(), web_adresi_tekrar: (f.elements.namedItem('web_adresi_tekrar') as HTMLInputElement).value }) });
        const s = await r.json().catch(() => ({}));
        if (!r.ok || !s.ok) throw new Error(s.hata || 'Kayıt yapılamadı. Lütfen tekrar deneyin.');
        f.reset(); yaz('Teşekkürler, listeye eklendiniz. İlk bülten hazır olduğunda e-postanıza gelecek.', true);
      } catch (h) { yaz((h as Error).message, false); robot.sifirla(); }
      finally { d.disabled = false; }
    });
  });
</script>
<style>
  .bt{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);gap:28px;align-items:center;padding:28px 32px;border-radius:22px;background:var(--card);border:1px solid var(--line)}
  .bt h3{margin:0 0 6px;font-size:22px;color:var(--head)}
  .bt-metin p{margin:0;color:var(--tx2);font-size:15px;line-height:1.55}
  .bt-alan{display:flex;flex-direction:column;gap:10px}
  .bt-satir{display:flex;gap:8px}
  .bt input[type=email]{flex:1;min-width:0;min-height:50px;padding:0 16px;border:1px solid var(--line);border-radius:12px;background:var(--bg);color:var(--tx);font:inherit;font-size:16px}
  .bt input[type=email]:focus{outline:2px solid var(--brand);outline-offset:1px;border-color:transparent}
  .bt button{min-height:50px;padding:0 22px;border:0;border-radius:12px;background:var(--fill);color:#FFFFFF;font:inherit;font-weight:700;cursor:pointer}
  .bt button:disabled{opacity:.6;cursor:wait}
  .bt-onay{display:flex;gap:10px;align-items:flex-start;font-size:13.5px;line-height:1.5;color:var(--tx2);cursor:pointer}
  .bt-onay input{width:18px;height:18px;margin:2px 0 0;flex:none;accent-color:var(--fill)}
  .bt-onay a{font-weight:600}
  .bt-tuzak{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}
  .gizli-et{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .bt-durum{margin:0;padding:10px 14px;border-radius:10px;font-size:14px}
  .bt-durum[data-tur=ok]{background:var(--okb);color:var(--ok)}.bt-durum[data-tur=hata]{background:var(--errb);color:var(--err)}
  @media (max-width:900px){.bt{grid-template-columns:1fr;padding:22px}}
  @media (max-width:480px){.bt-satir{flex-direction:column}}
</style>
