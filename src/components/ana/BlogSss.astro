---
// Ana sayfa: son blog yazıları, Instagram kartı ve sık sorulan sorular (FAQPage yapılandırılmış verisiyle).
// Cevaplar yalnızca Muhittin'in doğruladığı bilgilere dayanır (hesap sahipliği, 1 iş günü, en az 3 ay, IDOS).
import Baslik from './Baslik.astro';
import Bulten from './Bulten.astro';
import yazilar from '../../data/yazilar.json';
const SSS = [
  ['Ücretsiz analizde neye bakıyorsunuz?', 'Reklam hesaplarınızı, ölçüm altyapınızı (GA4, etiketler, dönüşümler) ve sitenizi inceleriz. Nereden başlamanız gerektiğini gerekçesiyle anlatırız. Formu gönderdikten sonra 1 iş günü içinde dönüş yaparız.'],
  ['Reklam hesabı kime ait olur?', 'Hesap sizin adınıza açılır ve size aittir. Biz yönetici olarak erişiriz; çalışma bittiğinde erişimimiz kaldırılır, hesap ve tüm geçmiş veriler sizde kalır.'],
  ['En az ne kadar süre çalışmamız gerekiyor?', 'Reklam ve SEO çalışmalarının öğrenme ve ölçüm dönemi olduğu için en az 3 ay ile başlamayı öneriyoruz; süre ihtiyacınıza göre görüşülebilir.'],
  ['Sadece tek bir hizmet alabilir miyim?', 'Evet. Örneğin yalnızca Google Ads ya da yalnızca pazaryeri yönetimi ile başlayabilirsiniz. İhtiyaç oldukça diğer alanlar aynı ekip tarafından eklenebilir.'],
  ['Sonuçları nasıl takip ederim?', 'Reklam ve analiz verileriniz kendi geliştirdiğimiz IDOS panelinde bir arada görünür. Satış, form, arama ve mesaj gibi sonuçlar ayrı ayrı izlenir.'],
  ['Bütçe veya kampanya değişikliklerini kim onaylıyor?', 'Siz. Bütçe, teklif stratejisi ve kampanya açma-kapatma gibi kararlar size gerekçesiyle sunulur ve onayınızla uygulanır.'],
  ['SEO çalışmasının sonuçları ne zaman görülür?', 'Teknik düzeltmelerin etkisi birkaç hafta içinde görülebilir; içerik ve otorite çalışmaları genellikle aylar sürer. Süre sektöre, rekabete ve sitenin mevcut durumuna bağlıdır, bu yüzden sıralama garantisi vermeyiz.'],
  ['GEO nedir, SEO’dan farkı ne?', 'GEO (üretken arama optimizasyonu), sitenizin Google’ın yapay zekâ özetlerinde ve ChatGPT gibi asistanların cevaplarında kaynak gösterilmesini hedefler. SEO’nun üzerine kurulur: net cevap veren, güvenilir ve kaynak gösterilebilir içerik gerektirir.']
];
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: SSS.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
const son = yazilar.slice(0, 3);
---
<section class="bs bs-blog" aria-labelledby="bs-blog">
  <div class="bs-ic">
    <Baslik id="bs-blog" etiket="Blog" baslik="Reklam, e-ticaret ve ölçüm üzerine" baglanti={{ href: '/tr/haberler/', ad: 'Tüm yazılar' }} />
    <div class="bs-yazilar">
      {son.map((y) => (
        <a class="bs-yazi" href={`/tr/haber/${y.slug}/`}><span class="bs-kat">{y.kategori}</span><h3>{y.baslik}</h3><p>{y.ozet}</p><span class="bs-oku">Yazıyı oku →</span></a>
      ))}
      <a class="bs-ig" href="https://www.instagram.com/idexya.ads" rel="noopener" target="_blank">
        <span class="bs-ig-ikon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.5"></circle></svg></span>
        <h3>Instagram’da kısa ipuçları</h3>
        <p>Reklam, e-ticaret ve ölçüm üzerine kısa içerikler için bizi takip edin.</p>
        <span class="bs-oku">@idexya.ads <span class="gizli">(yeni sekmede açılır)</span>→</span>
      </a>
    </div>
    <Bulten />
  </div>
</section>
<section class="bs bs-sss" aria-labelledby="bs-sss">
  <div class="bs-ic bs-sss-ic">
    <Baslik id="bs-sss" etiket="Sık sorulan sorular" baslik="Merak edilenler" aciklama="Cevabını bulamadığınız bir soru varsa yazın, 1 iş günü içinde dönelim." baglanti={{ href: '/tr/iletisim/', ad: 'İletişim' }} />
    <div class="bs-sorular">
      {SSS.map(([s, c], i) => (
        <details open={i === 0}><summary>{s}</summary><p>{c}</p></details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ld)}></script>
</section>
<style>
  .bs-ic{max-width:var(--kap);margin:0 auto;padding:96px var(--kenar);box-sizing:border-box;display:flex;flex-direction:column;gap:40px}
  .bs-yazilar{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
  .bs-yazi,.bs-ig{display:flex;flex-direction:column;gap:10px;padding:24px;border-radius:20px;border:1px solid var(--line);background:var(--card);text-decoration:none;color:var(--tx);transition:transform .2s,box-shadow .2s,border-color .2s}
  .bs-yazi:hover,.bs-ig:hover{transform:translateY(-3px);box-shadow:0 18px 40px var(--shadow);border-color:color-mix(in srgb,var(--brand) 45%,var(--line))}
  .bs-kat{align-self:flex-start;padding:4px 10px;border-radius:999px;background:var(--tint);color:var(--tintx);font-size:12.5px;font-weight:700}
  .bs-yazi h3,.bs-ig h3{margin:0;font-size:19px;line-height:1.3;color:var(--head)}
  .bs-yazi p,.bs-ig p{margin:0;font-size:14.5px;line-height:1.55;color:var(--tx2);flex:1}
  .bs-oku{font-weight:700;color:var(--acc);font-size:14.5px}
  .bs-ig{background:linear-gradient(150deg,#002559,#0A3270);border-color:transparent}
  .bs-ig h3{color:#FFFFFF}.bs-ig p{color:#C6D2E3}.bs-ig .bs-oku{color:#FFB58A}
  .bs-ig-ikon{width:48px;height:48px;border-radius:14px;background:rgba(240,122,35,.2);color:#FFB58A;display:flex;align-items:center;justify-content:center}
  .gizli{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .bs-blog{background:var(--bg2)}
  .bs-sss-ic{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:48px;align-items:start}
  .bs-sorular{display:flex;flex-direction:column;gap:10px}
  .bs-sorular details{border:1px solid var(--line);border-radius:16px;background:var(--card)}
  .bs-sorular summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:18px 22px;font-weight:700;color:var(--head);font-size:16.5px}
  .bs-sorular summary::-webkit-details-marker{display:none}
  .bs-sorular summary::after{content:"+";flex:none;width:28px;height:28px;border-radius:50%;background:var(--tint);color:var(--tintx);display:flex;align-items:center;justify-content:center;font-size:18px;transition:transform .2s}
  .bs-sorular details[open] summary::after{transform:rotate(45deg)}
  .bs-sorular p{margin:0;padding:0 22px 20px;font-size:15.5px;line-height:1.65;color:var(--tx)}
  @media (max-width:1100px){.bs-yazilar{grid-template-columns:1fr 1fr}.bs-sss-ic{grid-template-columns:1fr}}
  @media (max-width:600px){.bs-yazilar{grid-template-columns:1fr}.bs-ic{padding-top:64px;padding-bottom:64px}}
</style>
