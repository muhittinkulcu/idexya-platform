---
// Proje sayfası şablonu. Ayrıntılı vaka çalışması olan projeler (ör. marco-polo-chocolate) kendi dosyasından gelir.
import Site from '../../../layouts/Site.astro';
import CagriKutusu from '../../../components/CagriKutusu.astro';
import projeler from '../../../data/projeler.json';
const slug = (t) => String(t).toLocaleLowerCase('tr-TR').replace(/ç/g, 'c').replace(/ğ/g, 'g').replace(/ı/g, 'i').replace(/ö/g, 'o').replace(/ş/g, 's').replace(/ü/g, 'u').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
export function getStaticPaths() {
  const sl = (t) => String(t).toLocaleLowerCase('tr-TR').replace(/ç/g, 'c').replace(/ğ/g, 'g').replace(/ı/g, 'i').replace(/ö/g, 'o').replace(/ş/g, 's').replace(/ü/g, 'u').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  return projeler.filter((p) => sl(p.ad) !== 'marco-polo-chocolate').map((p) => ({ params: { slug: sl(p.ad) }, props: { p } }));
}
const { p } = Astro.props;
const renk = { eticaret: '#B84406', dijital: '#002559', web: '#2F5D50' }[p.kat];
const benzer = projeler.filter((x) => x.kat === p.kat && x.ad !== p.ad).slice(0, 3);
---
<Site baslik={p.ad} aciklama={`${p.ad} · ${p.hizmet}`} aktif="Referanslar">
<section style="max-width: 1240px; margin: 0 auto; padding: 36px 24px 56px; display: flex; flex-direction: column; gap: 22px">
<nav aria-label="Sayfa yolu" style="font-size: 14px; color: var(--tx2); display: flex; gap: 8px; align-items: center"><a href="/" style="color: var(--tx2); text-decoration: none; padding: 6px 0">Ana sayfa</a><span aria-hidden="true">›</span><a href="/tr/referanslar" style="color: var(--tx2); text-decoration: none; padding: 6px 0">Referanslar</a><span aria-hidden="true">›</span><span aria-current="page" style="color: var(--head); font-weight: 600">{p.ad}</span></nav>
<div style="display: flex; flex-wrap: wrap; gap: 32px; align-items: center">
<div style="flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 16px">
<span style="font-size: 14px; font-weight: 600; letter-spacing: 0.06em; color: var(--acc)">{p.kategoriAd.toLocaleUpperCase('tr-TR')}</span>
<h1 style="margin: 0; font-size: clamp(36px, 7vw, 56px); line-height: 1.06; letter-spacing: -0.03em; color: var(--head)">{p.ad}</h1>
<p style="margin: 0; font-size: 19px; color: var(--tx2)">{p.sektor} · {p.hizmet}</p>
<p style="margin: 0; color: var(--tx2)">[Proje özeti hazırlanıyor: başlangıçtaki durum, yaptıklarımız ve sonuçlar.]</p>
</div>
<div aria-hidden="true" style={`flex: 1 1 420px; min-height: 300px; border-radius: 28px; background: ${renk}; display: flex; align-items: center; justify-content: center`}><span style="font-size: 72px; font-weight: 700; color: #FFFFFF">{p.basHarf}</span></div>
</div>
</section>
{benzer.length > 0 && (
<section style="background: var(--bg2); border-top: 1px solid var(--line)"><div style="max-width: 1240px; margin: 0 auto; padding: 56px 24px; display: flex; flex-direction: column; gap: 18px"><h2 style="margin: 0; font-size: 28px; color: var(--head)">Benzer projeler</h2><div style="display: flex; flex-wrap: wrap; gap: 14px">{benzer.map((b) => <a href={`/tr/proje/${slug(b.ad)}`} style="flex: 1 1 260px; padding: 20px; border-radius: 18px; background: var(--card); border: 1px solid var(--line); text-decoration: none; display: flex; flex-direction: column; gap: 4px"><b style="color: var(--head)">{b.ad}</b><span style="color: var(--tx2); font-size: 14px">{b.hizmet}</span></a>)}</div></div></section>
)}
<CagriKutusu baslik="Benzer bir proje mi düşünüyorsunuz?" />
</Site>
