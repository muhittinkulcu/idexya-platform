---
import Site from '../../layouts/Site.astro';
// Tasarım verisi derleme anında üretilir (tools/dc2astro.py).
class DCLogic { constructor(p) { this.props = p || {}; this.state = {}; } setState() {} }
class Component extends DCLogic {
  constructor(props) {
    super(props);
    this.state = { koyu: null, filtre: 'tumu' };
  }
  renderVals() {
    const self = this;
    const koyu = this.state.koyu === null ? (this.props.koyu ?? false) : this.state.koyu;
    const kategoriler = { eticaret: 'E-ticaret', dijital: 'Dijital pazarlama', web: 'Web tasarım' };
    const renkler = { eticaret: '#B84406', dijital: '#002559', web: '#2F5D50' };
    const projeler = [
      { ad: 'Marco Polo Chocolate', kat: 'dijital', sektor: 'Kahve ve çikolata', hizmet: 'Google Ads ve sosyal medya' },
      { ad: 'RS Aydınlatma', kat: 'eticaret', sektor: 'Aydınlatma · ikas altyapısı', hizmet: 'E-ticaret kurulumu' },
      { ad: 'İntegral Enerji', kat: 'web', sektor: 'Güneş enerjisi sistemleri', hizmet: 'Kurumsal web sitesi' },
      { ad: 'Halıbank Kayseri', kat: 'dijital', sektor: 'Halı', hizmet: 'Google Ads ve sosyal medya' },
      { ad: 'Cengiz İnler', kat: 'eticaret', sektor: 'Yapı, hırdavat ve endüstriyel ürünler', hizmet: 'E-ticaret' },
      { ad: 'Sayan Yapı Mühendislik', kat: 'web', sektor: 'Mühendislik ve inşaat', hizmet: 'Kurumsal web sitesi' },
      { ad: 'Halıbank Sincan', kat: 'dijital', sektor: 'Halı', hizmet: 'Google Ads ve sosyal medya' },
      { ad: 'Karakalem Kırtasiye', kat: 'eticaret', sektor: 'Kırtasiye ve ofis malzemeleri', hizmet: 'E-ticaret' },
      { ad: 'Mavera Havuz', kat: 'web', sektor: 'Havuz yapımı ve bakımı', hizmet: 'Kurumsal web sitesi' },
      { ad: 'BT Halı Dünyası', kat: 'dijital', sektor: 'Halı', hizmet: 'Google Ads ve sosyal medya' },
      { ad: 'Ankara Teknik Hırdavat', kat: 'eticaret', sektor: 'El aletleri ve teknik ekipman', hizmet: 'E-ticaret' },
      { ad: 'Ayancık Turizm', kat: 'web', sektor: 'Yolcu taşımacılığı', hizmet: 'Kurumsal web sitesi' },
      { ad: 'Polatlı Halı Dünyası', kat: 'dijital', sektor: 'Halı', hizmet: 'Google Ads ve sosyal medya' },
      { ad: 'Arya Reklam', kat: 'web', sektor: 'Reklam ve tanıtım', hizmet: 'Kurumsal web sitesi' },
      { ad: 'Göksu Amerikan Kültür', kat: 'web', sektor: 'Eğitim', hizmet: 'SEO uyumlu web sitesi' },
      { ad: 'Aleyna Sönmez', kat: 'web', sektor: 'Danışmanlık', hizmet: 'Web sitesi' }
    ];
    const aktif = this.state.filtre;
    const tanim = [ ['tumu', 'Tümü'], ['eticaret', 'E-ticaret'], ['dijital', 'Dijital pazarlama'], ['web', 'Web tasarım'] ];
    const filtreler = tanim.map(function (t) {
      const secili = t[0] === aktif;
      const sayi = t[0] === 'tumu' ? projeler.length : projeler.filter(function (p) { return p.kat === t[0]; }).length;
      return { ad: t[1], sayi: sayi, secili: secili, sec: function () { self.setState({ filtre: t[0] }); },
        stil: 'min-height: 44px; padding: 0 18px; border-radius: 999px; font: inherit; font-size: 15px; font-weight: 600; cursor: pointer; ' + (secili ? 'border: 1px solid var(--fill); background: var(--fill); color: #FFFFFF' : 'border: 1px solid var(--line); background: var(--card); color: var(--head)') };
    });
    const gorunenProjeler = projeler.filter(function (p) { return aktif === 'tumu' || p.kat === aktif; }).map(function (p) {
      const kelimeler = p.ad.split(' ');
      const basHarf = (kelimeler[0][0] + (kelimeler[1] ? kelimeler[1][0] : '')).toLocaleUpperCase('tr-TR');
      return Object.assign({}, p, { basHarf: basHarf, kategoriAd: kategoriler[p.kat],
        gorselStil: 'position: relative; height: 200px; display: flex; align-items: center; justify-content: center; background: ' + renkler[p.kat] });
    });
    return {
      temaSinifi: koyu ? 'koyu' : 'acik',
      temaEtiketi: koyu ? 'Açık temaya geç' : 'Koyu temaya geç',
      temaDegistir: () => this.setState({ koyu: !koyu }),
      filtreler: filtreler,
      gorunenProjeler: gorunenProjeler
    };
  }
}
const __c = new Component({}); Object.assign(__c.state, {});
const __v = __c.renderVals();
const __slug = (t) => String(t).toLocaleLowerCase('tr-TR').replace(/ç/g, 'c').replace(/ğ/g, 'g').replace(/ı/g, 'i').replace(/ö/g, 'o').replace(/ş/g, 's').replace(/ü/g, 'u').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const __suz = (anahtar, degerler, liste) => degerler.map((d, i) => { const al = (x) => { const c = new Component({}); c.state[anahtar] = x; return c.renderVals()[liste][i].stil; }; return { deger: d, sec: al(d), nor: al(degerler.find((x) => x !== d)) }; });
const filtreler = __v.filtreler;
const gorunenProjeler = __v.gorunenProjeler;
const __sz0 = __suz('filtre', ["tumu", "eticaret", "dijital", "web"], 'filtreler');
---
<Site baslik="Referanslar" aciklama="Birlikte büyüdüğümüz markalar ve projeler." aktif="Referanslar">


<section style="position: relative">
<svg aria-hidden="true" viewBox="0 0 1440 460" preserveAspectRatio="none" style="position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0"><path d="M820 0 C 1000 110 1120 50 1440 120 L1440 0 Z" fill="var(--blob2)"></path><path d="M1000 460 C 960 340 1100 230 1440 210 L1440 460 Z" fill="var(--blob)"></path></svg>
<div style="position: relative; z-index: 1; max-width: 1240px; margin: 0 auto; padding: 36px 24px 48px; box-sizing: border-box; display: flex; flex-direction: column; gap: 26px">
<nav aria-label="Sayfa yolu" style="font-size: 14px; color: var(--tx2); display: flex; gap: 8px; align-items: center"><a href="/" style="color: var(--tx2); text-decoration: none; padding: 6px 0">Ana sayfa</a><span aria-hidden="true">›</span><span aria-current="page" style="color: var(--head); font-weight: 600">Referanslar</span></nav>
<div style="display: flex; align-items: center; gap: 12px"><span style="width: 36px; height: 2px; background: var(--brand)"></span><span style="font-size: 14px; font-weight: 600; letter-spacing: 0.06em; color: var(--acc)">REFERANSLAR</span></div>
<h1 style="margin: 0; font-size: clamp(36px, 7vw, 58px); line-height: 1.06; letter-spacing: -0.03em; color: var(--head); max-width: 860px">Birlikte büyüdüğümüz markalar</h1>
<p style="margin: 0; font-size: 20px; color: var(--tx2); max-width: 680px">E-ticaret mağazalarından yerel işletmelere, farklı sektörlerde yaptığımız işlerden bir seçki.</p>
<div role="group" aria-label="Proje türü" style="display: flex; flex-wrap: wrap; gap: 10px; padding-top: 6px">
{(filtreler || []).map((f, __i) => (<Fragment>
<button data-grup="proje" data-deger={__sz0[__i].deger} data-sec-stil={__sz0[__i].sec} data-normal-stil={__sz0[__i].nor} type="button" aria-pressed={String(f.secili)} style={f.stil}>{f.ad} <span style="opacity: 0.7; font-weight: 500">{f.sayi}</span></button>
</Fragment>))}
</div>
</div>
</section>

<section style="max-width: 1240px; margin: 0 auto; padding: 8px 24px 88px; box-sizing: border-box">
<ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 22px">
{(gorunenProjeler || []).map((p) => (<Fragment>
<li data-grup-icerik="proje" data-etiket={p.kat} style="flex: 1 1 340px; min-width: 0; display: flex">
<a href={`/tr/proje/${__slug(p.ad)}`} style="flex: 1; display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: 22px; overflow: hidden; text-decoration: none; color: var(--tx)">
<div style={p.gorselStil}><span style="font-size: 44px; font-weight: 700; letter-spacing: -0.02em; color: #FFFFFF; opacity: 0.95">{p.basHarf}</span><span style="position: absolute; left: 16px; bottom: 14px; padding: 4px 10px; border-radius: 999px; background: rgba(255,255,255,.92); color: #002559; font-size: 12px; font-weight: 600">{p.kategoriAd}</span></div>
<div style="padding: 22px 24px 24px; display: flex; flex-direction: column; gap: 8px; flex: 1">
<span style="font-size: 20px; font-weight: 700; color: var(--head)">{p.ad}</span>
<span style="font-size: 15px; color: var(--tx2)">{p.sektor}</span>
<span style="margin-top: auto; padding-top: 10px; font-size: 14px; color: var(--acc); font-weight: 600">{p.hizmet} · İncele →</span>
</div>
</a>
</li>
</Fragment>))}
</ul>
<p style="margin: 22px 0 0; font-size: 13px; color: var(--tx2)">Proje görselleri eklenecek; şimdilik marka baş harfleri gösteriliyor.</p>
</section>

<section style="padding: 0 24px 96px">
<div style="max-width: 1192px; margin: 0 auto; box-sizing: border-box; background: #002559; color: #F1F3F5; border-radius: 28px; padding: clamp(28px, 6vw, 52px); overflow: hidden; display: flex; flex-wrap: wrap; gap: 32px; align-items: center; justify-content: space-between; position: relative; overflow: hidden">
<svg aria-hidden="true" viewBox="0 0 400 400" style="position: absolute; right: -100px; top: -120px; width: 360px; height: 360px"><circle cx="200" cy="200" r="190" fill="none" stroke="#F07A23" stroke-width="1.5" opacity="0.45"></circle><circle cx="200" cy="200" r="130" fill="none" stroke="#F07A23" stroke-width="1.5" opacity="0.3"></circle></svg>
<div style="flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 12px; position: relative">
<h2 style="margin: 0; font-size: 38px; line-height: 1.12; color: #FFFFFF">Sıradaki proje sizinki olsun</h2>
<p style="margin: 0; color: #C6D2E3; font-size: 17px">Hesaplarınızı ve sitenizi ücretsiz inceleyip size bir yol haritası çıkaralım.</p>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 12px; position: relative">
<a href="/tr/paketler" style="min-height: 54px; display: flex; align-items: center; padding: 0 26px; border-radius: 12px; background: #F07A23; color: #1A1206; text-decoration: none; font-weight: 700; font-size: 17px">Ücretsiz analiz iste</a>
<a href="https://wa.me/905078700629" style="min-height: 54px; display: flex; align-items: center; padding: 0 22px; border-radius: 12px; border: 1px solid rgba(255,255,255,.35); color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 17px">WhatsApp'tan yaz</a>
</div>
</div>
</section>




</Site>
